import csv, io

with open('e2e-results/2026-07-29-r11027-reproducible-30agent-live-pty/sample-input/data.csv') as f:
    reader = csv.DictReader(f)
    rows = list(reader)

print(f'Total rows: {len(rows)}')

# Column analysis
for col in ['id','age','country','signup_date']:
    vals = [r[col] for r in rows]
    missing = sum(1 for v in vals if v.strip() == '')
    unique = len(set(v.strip() for v in vals if v.strip()))
    print(f'\n--- {col} ---')
    print(f'  Missing: {missing}/{len(rows)} ({missing/len(rows)*100:.1f}%)')
    print(f'  Unique:  {unique}')
    if col == 'age':
        nums = [int(v) for v in vals if v.strip()]
        print(f'  Values:  {sorted(nums)}')
        print(f'  Min:     {min(nums)}')
        print(f'  Max:     {max(nums)}')
        print(f'  Mean:    {sum(nums)/len(nums):.2f}')
        med = sorted(nums)[len(nums)//2]
        print(f'  Median:  {med}')
        q1 = sorted(nums)[len(nums)//4]
        q3 = sorted(nums)[3*len(nums)//4]
        iqr = q3 - q1
        print(f'  Q1:      {q1}')
        print(f'  Q3:      {q3}')
        print(f'  IQR:     {iqr}')
        lower_fence = q1 - 1.5*iqr
        upper_fence = q3 + 1.5*iqr
        print(f'  Lower fence: {lower_fence}')
        print(f'  Upper fence: {upper_fence}')
        outliers = [v for v in nums if v < lower_fence or v > upper_fence]
        print(f'  IQR outliers: {outliers}')
    elif col == 'country':
        from collections import Counter
        cnt = Counter(v.strip() for v in vals if v.strip())
        print(f'  Distribution: {dict(cnt)}')

# DQ Score calculation
print('\n\n=== DQ SCORE CALCULATION ===')
# Completeness: 3 missing ages out of 15*4=60 cells
total_cells = len(rows) * 4
total_missing = sum(1 for r in rows for c in ['id','age','country','signup_date'] if r[c].strip() == '')
completeness = 100 * (1 - total_missing / total_cells)
print(f'Completeness: {completeness:.1f}% ({total_missing}/{total_cells} missing)')

# Validity: invalid ages: row5(150), row13(-5), row3(empty), row7(empty), row15(empty)
# valid age range 0-120: 3 missing + 1 below 0 + 1 above 120 = 5 invalid
valid_cells = 0
for r in rows:
    # id - must be present and positive
    if r['id'].strip():
        valid_cells += 1
    # age - must be 0-120
    if r['age'].strip():
        try:
            a = int(r['age'])
            if 0 <= a <= 120:
                valid_cells += 1
        except:
            pass
    # country - must be DE/US/UK/FR
    if r['country'].strip() in ['DE','US','UK','FR']:
        valid_cells += 1
    # signup_date - must be present and match YYYY-MM-DD
    if r['signup_date'].strip():
        import re
        if re.match(r'^\d{4}-\d{2}-\d{2}$', r['signup_date'].strip()):
            valid_cells += 1

total_validatable = len(rows) * 4
validity = 100 * valid_cells / total_validatable
print(f'Validity:   {validity:.1f}% ({valid_cells}/{total_validatable} valid)')

# Accuracy penalty: 2 critical anomalies (150, -5) + 1 high (3 missing)
# Penalties: -15 for critical, -10 for high
accuracy_penalty = 15*2 + 10  # = 40
accuracy = max(0, 100 - accuracy_penalty)
print(f'Accuracy:   {accuracy}% (penalized for 2 critical + 1 high anomaly)')

# Consistency: no duplicate ids, all country codes valid, dates in range
# All ids unique: YES, all countries valid: YES, dates monotonic: YES
consistency = 100
print(f'Consistency: {consistency}%')

# Overall weighted DQ score
dq_score = 0.25*completeness + 0.25*validity + 0.25*accuracy + 0.25*consistency
print(f'\nOverall DQ Score: {dq_score:.1f}/100')
