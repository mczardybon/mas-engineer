      timeout: 15
    - id: count_checkpoints
      action: shell
      cmd: ls -1 .state/checkpoints/ 2>/dev/null | wc -l
      timeout: 10
    - id: score_latest
      action: shell
      cmd: 'LATEST=$(ls -1t .state/checkpoints/ 2>/dev/null | head -1) && [ -n "$LATEST"
        ] && echo "Best checkpoint: $LATEST" || echo "No checkpoints found"'
      timeout: 15
    - id: auto_repair
      action: shell
      cmd: LATEST=$(ls -1t .state/checkpoints/ 2>/dev/null | head -1) && if [ -n "$LATEST"
        ] && [ -d ".state/checkpoints/$LATEST/recipe" ]; then cp -rn ".state/checkpoints/$LATEST/recipe/."
        recipe/ 2>/dev/null && echo "[AUTO_REPAIR] timeline-restored missing recipe/
