  wf_recovery_immune:
    desc: YAML preflight check before every edit (4-step, check then list then categorize
      then auto_repair)
    steps:
    - id: check
      action: shell
      cmd: python3 tools/dev_rule_checker.py --all 2>&1 | tail -5
      timeout: 60
    - id: list_violations
      action: shell
      cmd: python3 tools/dev_rule_checker.py --all 2>&1 | grep -E "^(VIOLATION|FAIL)"
        | head -10 > .state/immune_violations.log 2>&1; if [ -s .state/immune_violations.log
        ]; then echo "[LIST_VIOLATIONS] found $(wc -l < .state/immune_violations.log)
        violation(s) - see .state/immune_violations.log"; cat .state/immune_violations.log;
        else echo "[LIST_VIOLATIONS] no violations found"; fi
      timeout: 60
    - id: categorize
      action: shell
      cmd: if [ -s .state/immune_violations.log ]; then CRITICAL=$(grep -c -E "^VIOLATION"
        .state/immune_violations.log 2>/dev/null || echo 0); WARN=$(grep -c -E "^FAIL"
        .state/immune_violations.log 2>/dev/null || echo 0); echo "[CATEGORIZE] critical=$CRITICAL
        warn=$WARN"; if [ "$CRITICAL" -gt 0 ]; then echo CRITICAL > .state/immune_severity;
        else echo WARN > .state/immune_severity; fi; else echo OK > .state/immune_severity;
        fi
      timeout: 30
    - id: auto_repair
      action: shell
      cmd: 'SEVERITY=$(cat .state/immune_severity 2>/dev/null || echo OK); if [ "$SEVERITY"
        = "CRITICAL" ]; then printf "version: 1.0.0\ntitle: emergency immune-mode\ndescription:
        minimal recovery template for R01-R18 violations\ninstructions: |\n  Emergency
        mode - only recovery workflows available.\n  All other agents disabled until
        violations are resolved.\n" > .state/immune_emergency.yaml && echo "[AUTO_REPAIR]
        critical violations - emergency template written to .state/immune_emergency.yaml
        (manual fix required)"; else echo "[AUTO_REPAIR] severity=$SEVERITY - no emergency
        restore needed"; touch .state/.immune_clean; fi'
      timeout: 30
      on_error: skip
  wf_recovery_checkpoint:
    desc: Checkpoint content validation + C-01/C-02 fix
    steps:
    - id: list_checkpoints
      action: shell
      cmd: test -d .state/checkpoints/ && ls -1 .state/checkpoints/ | head -5
      timeout: 30
    - id: validate_latest
      action: shell
      cmd: LATEST=$(ls -1t .state/checkpoints/ 2>/dev/null | head -1) && if [ -n "$LATEST"
        ] && [ -d ".state/checkpoints/$LATEST/recipe" ]; then find ".state/checkpoints/$LATEST/recipe"
        -name "*.yaml" -exec python3 -c "import yaml; yaml.safe_load(open(\"{}\"));
        print(\"{}\", \"OK\")" \; 2>&1 | tail -3; else echo "no checkpoint to validate";
        fi
      timeout: 60
    - id: ensure_recipe
      action: shell
      cmd: LATEST=$(ls -1t .state/checkpoints/ 2>/dev/null | head -1) && [ -d ".state/checkpoints/$LATEST/recipe"
        ] && echo "recipe/ OK" || echo "recipe/ MISSING (C-01)"
      timeout: 15
    - id: auto_repair
      action: shell
      cmd: LATEST=$(ls -1t .state/checkpoints/ 2>/dev/null | head -1) && if [ -n "$LATEST"
        ] && [ -d ".state/checkpoints/$LATEST/recipe" ]; then cp -r ".state/checkpoints/$LATEST/recipe/."
        recipe/ && echo "[AUTO_REPAIR] restored recipe/ from checkpoint $LATEST" ||
        echo "[AUTO_REPAIR] restore failed"; else echo "[AUTO_REPAIR] no checkpoint
        to restore from"; fi
      timeout: 15
      on_error: skip
  wf_recovery_safezone:
    desc: Recovery templates in template/recovery/
    steps:
    - id: list_templates
      action: shell
      cmd: ls -1 template/recovery/ 2>&1 | head -5
      timeout: 15
    - id: validate_templates
      action: shell
      cmd: python3 -c "import glob; files = glob.glob('template/recovery/*.md'); print(f'{len(files)}
        templates found')"
      timeout: 15
    - id: check_fork
      action: shell
      cmd: test -L mas-engineer_active 2>/dev/null && echo "Fork ACTIVE" || echo "No
        active fork"
      timeout: 10
    - id: auto_repair
      action: shell
      cmd: 'if [ ! -L mas-engineer_active ]; then LATEST=$(ls -1dt mas-engineer_fork_*
        2>/dev/null | head -1); if [ -n "$LATEST" ]; then ln -s "$LATEST" mas-engineer_active
        && echo "[AUTO_REPAIR] safezone-restored fork: $LATEST -> mas-engineer_active";
        else echo "[AUTO_REPAIR] no safezone-fork to restore"; fi; else echo "[AUTO_REPAIR]
        safezone-fork already active"; fi'
      timeout: 15
      on_error: skip
  wf_recovery_timeline:
    desc: Find best recovery point
    steps:
    - id: find_latest
