            version: 1.0.0
            constitution: sub_mas-master-constitution.yaml
            title: 🚀 GIT-PUSHER — Git Push Operations
            description: 'v1.0.0 | MAS-internal: Handles git push operations with safety checks'
            instructions: |
              # sub_mas-git-pusher — Git Push (v1.0.0)

