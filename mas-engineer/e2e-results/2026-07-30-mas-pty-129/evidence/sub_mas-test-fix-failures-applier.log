  - id: F-PTY-001
    type: S1
    severity: high
    file: tools/mas_e2e_pty_all.sh
    field: status_detection_regex (line 81)
    from: elif grep -qE "(Traceback|^Error\b|Exception:)" "\$log"; then
    to: elif grep -qE "(Traceback|^Error:(?! unsupported image format)|Exception:)"
      "\$log"; then
    reason: "Why: Status detector false-positive \u2014 ^Error\\b matches \"Error:\
      \ unsupported image format\" (goose read_image noise). All 8 FAIL_ERROR entries\
      \ in latest run are false positives. Use negative lookahead to exclude known\
      \ goose-tooling noise while catching real errors (Traceback, Exception). Goose-expert\
      \ verdict: CONFORM \u2014 Goose has zero native mechanism for post-hoc grep-based\
      \ log classification. This is pure shell-level orchestration."
    priority: 1.0
    current_chars: 61
    target_chars: 89
    goose_verdict: CONFORM
  - id: F-001
    type: MM2
    severity: medium
    file: recipe/multi-arch-30/multi-arch-30.yaml
    field: add prompt field
    from: 'prompt: (missing)'
    to: "prompt: \"\U0001F9E0 multi-arch-30 (v1.0.0)\n\u26D4 ONLY orchestration \u2014\
      \ NO direct changes\n\u2192 Delegate to teams via delegate()\""
    reason: "Why: Missing prompt: field \u2014 Goose requires prompt: for headless\
      \ (non-interactive) mode. All 130 installed MAS recipes (100%) have prompt:\
      \ field. Without it, headless execution may fail for the 30-agent master orchestrator.\
      \ Goose-expert verdict: CONFORM \u2014 matches established MAS pattern (root_recipe.yaml,\
      \ dev-mas-engineer.yaml)."
    priority: 0.82
    current_chars: 0
    target_chars: 98
    goose_verdict: CONFORM
  - id: F-002
    type: A5
    severity: medium
    file: recipe/multi-arch-30/multi-arch-30.yaml
    field: add settings block
    from: "settings: (missing \u2014 Goose defaults: timeout=300, max_steps=25)"
    to: 'settings: timeout=1200, max_steps=200'
    reason: "Why: Missing settings: block \u2014 master orchestrator managing 30 sub-agents\
      \ across 6 teams needs significantly higher timeout and steps than Goose defaults\
      \ (300s/25). 1200s timeout and 200 max_steps are within proven range (dev-mas-engineer-30agents.yaml\
      \ uses timeout:1800, max_steps:200). Goose-expert verdict: CONFORM \u2014 Goose\
      \ fully supports per-recipe settings overrides with clear precedence chain."
    priority: 0.82
    current_chars: 0
    target_chars: 47
    goose_verdict: CONFORM
  - id: F-093
    type: Q1
    severity: medium
    file: recipe/sub/sub_mas-clone.yaml
    field: add name field
    from: 'name: (missing)'
    to: 'name: sub_mas-clone'
    reason: "Why: Missing required name: field at top-level YAML \u2014 schema validators\
      \ may reject recipe without it. The name is only embedded inside the instructions\
      \ YAML string but not at the top level."
    priority: 0.82
    current_chars: 0
    target_chars: 22
    goose_verdict: "N/A \u2014 Q1 not in mandatory consultation scope"
