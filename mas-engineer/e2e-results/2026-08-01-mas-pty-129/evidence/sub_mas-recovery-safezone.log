  wf_safezone_fork:
    desc: Fork-Workspace output
    steps:
    - id: check_fork
      action: shell
      cmd: '[ -L {workspace}/mas-engineer_active ] && echo ''Fork active'' || echo
        ''No Fork'''
    - id: create_fork
      action: shell
      cmd: 'cp -r {workspace} {workspace}__{fork_name} && ln -sf {workspace}__{fork_name}
        {workspace}/mas-engineer_active && echo ''Fork: {fork_name}'''
      depends_on:
      - check_fork
  wf_safezone_merge:
    desc: Fork in Main abouttake
    steps:
    - id: validate_fork
      action: shell
      cmd: 'FORK=$(readlink -f {workspace}/mas-engineer_active 2>/dev/null); for f
        in $(find $FORK/recipe -name ''*.yaml'' 2>/dev/null); do python3 -c "import
        yaml; yaml.safe_load(open(''$f''))" 2>/dev/null || echo "Invalid: $f"; done'
    - id: merge
      action: shell
      cmd: FORK=$(readlink -f {workspace}/mas-engineer_active); rm -rf {workspace}/recipe
        {workspace}/tools; cp -r $FORK/recipe $FORK/tools {workspace}/; rm $FORK;
        rm {workspace}/mas-engineer_active; echo 'Merge OK'
      depends_on:
      - validate_fork
  wf_safezone_abort:
    desc: Fork verwerfen
    steps:
    - id: abort
      action: shell
      cmd: FORK=$(readlink -f {workspace}/mas-engineer_active 2>/dev/null); [ -n "$FORK"
        ] && { rm -rf "$FORK"; rm {workspace}/mas-engineer_active; echo 'Fork verworfen';
        } || echo 'No Fork active'
  wf_safezone_diff:
    desc: Difference fork vs main
    steps:
    - id: show_diff
      action: shell
      cmd: FORK=$(readlink -f {workspace}/mas-engineer_active 2>/dev/null); [ -n "$FORK"
        ] && diff -rq {workspace} $FORK 2>/dev/null | grep -v '.git/' | head -30 ||
        echo 'No Fork active'
  wf_timeline_findbest:
    desc: Find best checkpoint
    steps:
    - id: scan_checkpoints
      action: shell
      cmd: for d in $(ls -1t {workspace}/.state/checkpoints/ 2>/dev/null); do python3
        -c "import yaml; yaml.safe_load(open('{workspace}/.state/checkpoints/$d/recipe/dev-mas-engineer.yaml'))"
        2>/dev/null && echo "✅ $d"; done | head -1
      timeout: 60