# Example env file. Copy to .env and fill in real values.
# .env is gitignored - never commit it.
# Usage: source .env  OR  set in your shell.

# DeepSeek API key (https://platform.deepseek.com/)
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=***

# GitHub PAT for mczardybon/mas-engineer (write access)
GH_PAT=ghp_your-token-here

# === Goose / DeepSeek-Via-OpenAI-Shim Config (added 2026-07-28) ===
# These 3 vars tell the goose CLI to talk to DeepSeek via the
# OpenAI-compatible API. Without them, goose 1.44 hits api.openai.com
# and gets 401.
#
# OPENAI_API_KEY:  goose reads this, not DEEPSEEK_API_KEY, even though
#                  goose is configured for provider=openai. So alias it.
# OPENAI_MODEL:    the model on the OpenAI-compat endpoint. NOT
#                  'deepseek-chat' (deprecated 2026-07-23). Use
#                  'deepseek-v4-flash' (faster, cheaper) or
#                  'deepseek-v4-pro' (smarter).
# OPENAI_HOST:     the base URL. MUST end with /v1 — without it, goose
#                  hits /chat/completions on the root and gets 404.
#                  This is the most common silent failure mode.
OPENAI_API_KEY=${DEEPSEEK_API_KEY}
OPENAI_MODEL=deepseek-v4-flash
OPENAI_HOST=https://api.deepseek.com/v1
