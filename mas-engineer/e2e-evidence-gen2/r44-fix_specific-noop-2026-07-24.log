import json, sys
from datetime import datetime, timezone

today = datetime.now(timezone.utc).date()
data = json.load(sys.stdin)
changes = data.get('changes', [])
self_improve_today = []
for c in changes:
    ts = c.get('timestamp', '')
    stage = c.get('stage', '')
    # Only entries from today that are self-improvement types
    if ts.startswith(str(today)):
        if stage in ('full_improvement_override', 'full_improvement', 'apply_only', 'fix_specific'):
            self_improve_today.append(c)
print(f'Total entries today ({today}): {len(self_improve_today)}')
for c in self_improve_today:
    print(f\"  {c.get('timestamp','')} | stage={c.get('stage','')} | patches={c.get('patches_applied','?')} | note={c.get('note','')[:80]}\")
print(f'---')
print(f'Current count: {data.get(\"metadata\",{}).get(\"current_count\",\"?\")}')
print(f'Reset reason: {data.get(\"metadata\",{}).get(\"reset_reason\",\"?\")}')
