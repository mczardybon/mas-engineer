import yaml
with open('/workspace/mas-engineer-src/mas-engineer/.state/pipeline/findings.yaml') as f:
    data = yaml.safe_load(f)
print('Top keys:', list(data.keys()))
findings = data.get('data', {}).get('findings', [])
print(f'Findings count: {len(findings)}')

# Count by severity
from collections import Counter
severities = Counter()
categories = Counter()
for f in findings:
    s = f.get('severity', 'unknown')
    cat = f.get('type', f.get('category', 'unknown'))
    severities[s] += 1
    categories[cat] += 1
print('Severity distribution:', dict(severities))
print('Category distribution:', dict(categories.most_common(10)))

