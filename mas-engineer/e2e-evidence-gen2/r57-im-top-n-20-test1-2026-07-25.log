import sqlite3
db_path = '/workspace/mas-engineer-src/mas-engineer/.state/sessions.db'
import os
if not os.path.exists(db_path):
    db_path = os.path.expanduser('~/.local/share/goose/sessions/sessions.db')
    print(f'Using: {db_path}')

conn = sqlite3.connect(db_path)
cur = conn.cursor()

# List tables
cur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")
tables = cur.fetchall()
print('Tables:', [t[0] for t in tables])

# Try to find error/timeout related data
for table in tables:
    tname = table[0]
    try:
        cur.execute(f'PRAGMA table_info({tname})')
        cols = cur.fetchall()
        col_names = [c[1] for c in cols]
        # Check for columns that might indicate status/error
        if any(c in col_names for c in ['status', 'error', 'result', 'state']):
            print(f'\n--- {tname} columns: {col_names}')
            cur.execute(f'SELECT * FROM {tname} LIMIT 5')
            rows = cur.fetchall()
            for r in rows:
                print(f'  {r}')
    except:
        pass

conn.close()
