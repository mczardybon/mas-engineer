import sqlite3, os
db_path = os.path.expanduser('~/.local/share/goose/sessions/sessions.db')
conn = sqlite3.connect(db_path)
cur = conn.cursor()

# sessions table schema
cur.execute('PRAGMA table_info(sessions)')
cols = cur.fetchall()
print('sessions columns:')
for c in cols:
    print(f'  {c}')

# Get a few recent sessions with their data
cur.execute('SELECT id, created_at, rowid FROM sessions ORDER BY created_at DESC LIMIT 5')
rows = cur.fetchall()
print('\nRecent sessions:')
for r in rows:
    print(f'  {r}')

# Check messages for error patterns
cur.execute(\"SELECT session_id, COUNT(*) as cnt FROM messages WHERE role='assistant' AND content LIKE '%error%' GROUP BY session_id ORDER BY cnt DESC LIMIT 10\")
rows = cur.fetchall()
print('\nSessions with error mentions:')
for r in rows:
    print(f'  {r}')

# Check for timeout patterns
cur.execute(\"SELECT session_id, COUNT(*) as cnt FROM messages WHERE role='assistant' AND content LIKE '%timeout%' GROUP BY session_id ORDER BY cnt DESC LIMIT 10\")
rows = cur.fetchall()
print('\nSessions with timeout mentions:')
for r in rows:
    print(f'  {r}')

# Check usage_ledger for errors
cur.execute('PRAGMA table_info(usage_ledger)')
cols = cur.fetchall()
print('\nusage_ledger columns:')
for c in cols:
    print(f'  {c}')

conn.close()
