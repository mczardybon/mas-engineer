import json, re, yaml
from datetime import datetime, timezone

with open('/tmp/scan_output.txt') as f:
    content = f.read()

match = re.search(r'---JSON_START---\n(.*)', content, re.DOTALL)
data = json.loads(match.group(1))
findings = data['findings']

# Prefixes requiring goose_verdict (match alphabetically, not the full type code)
GOOSE_VERDICT_PREFIXES = ('M', 'A', 'B', 'D', 'J', 'L', 'S', 'H', 'BB')

def extract_alphabet_prefix(type_code):
    """Extract the alphabetical prefix from type code like 'B2' -> 'B', 'BB1' -> 'BB', 'MM8' -> 'MM'"""
    result = ''
    for ch in type_code:
        if ch.isalpha():
            result += ch
        else:
            break
    return result

def build_goose_verdict(finding):
    f_type = finding['type']
    prefix = extract_alphabet_prefix(f_type)
    
    # Knowledge-based verdicts derived from goose-docs.ai
    if prefix == 'B':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': f'Goose does not enforce prompt structure rules for type {f_type}. Prompt engineering patterns (length limits, context-info, I_AM identity) are MAS conventions optimized for agent performance, not Goose-native requirements. Goose supports prompts of any content via the `prompt:` field in recipe YAML. Goose also provides .goosehints and persistent_instructions.md as alternative context mechanisms.'
        }
    elif prefix == 'BB':
        return {
            'verdict': 'RESTRICTED',
            'confidence': 'MEDIUM',
            'explanation': 'Goose provides adversary.md (~/.config/goose/adversary.md) for security block/allow rules and prompt injection detection as native mechanisms. However, ⛔ prohibition markers in recipe instructions are a MAS convention for directing agent behavior. The adversary.md approach is the Goose-native way for security constraints; ⛔ markers complement this at the instruction level.'
        }
    elif prefix == 'MM':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': f'Goose supports YAML recipe structure per https://goose-docs.ai/docs/category/recipes. MM-type issues ({f_type}) relate to MAS convention compliance (prompt I_AM identity, MODE-CHECK markers), not Goose-native requirements. Goose natively supports prompt:, instructions:, settings:, extensions: fields without requiring specific content markers.'
        }
    elif prefix == 'A':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': 'Goose supports configurable timeout and max_steps settings per recipe. Default sub-agent timeout is 5min, max_turns default is 25. These can be overridden via settings.timeout and settings.max_steps in recipe YAML, or via GOOSE_SUBAGENT_MAX_TURNS env var.'
        }
    elif prefix == 'D':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': 'Goose supports multi-step recipes with any STEP ordering. STEP numbering is a MAS convention for orchestrator readability, not a Goose-native requirement.'
        }
    elif prefix == 'JJ':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': 'Goose sub-agents require `summon` in extensions if they themselves need to spawn sub-agents. Extension inheritance means child agents inherit parent extensions, but if extensions: is explicitly defined, summon must be listed. Sub_recipes get summon auto-injected.'
        }
    elif prefix == 'LL':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': 'Goose supports user-facing text in any language via recipes. LL-type issues (error clarity, language mixing) are UX best practices, not Goose-native requirements.'
        }
    elif prefix == 'S':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': 'Goose sub-agent coupling is managed via extensions inheritance and summon mechanism. If extensions: is listed, summon must be explicit. SOS-based agents auto-inherit summon.'
        }
    elif prefix == 'H':
        return {
            'verdict': 'CONFORM',
            'confidence': 'HIGH',
            'explanation': 'Goose does not require constitution rule citations. Rule references (R01-R18) are a MAS convention for governance, not a Goose-native requirement.'
        }
    
    return None

# Process all findings
processed = []
goose_verdict_count = 0
count_by_type = {}

for f in findings:
    f_type = f['type']
    prefix = extract_alphabet_prefix(f_type)
    
    entry = dict(f)
    
    if prefix in GOOSE_VERDICT_PREFIXES:
        verdict = build_goose_verdict(f)
        if verdict:
            entry['goose_verdict'] = verdict
            goose_verdict_count += 1
