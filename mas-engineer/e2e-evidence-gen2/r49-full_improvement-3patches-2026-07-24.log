import yaml
import uuid
from datetime import datetime, timezone
from collections import Counter

# Load findings
with open('.state/pipeline/findings.yaml') as f:
    raw = yaml.safe_load(f)

findings = raw.get('data', {}).get('findings', [])
request_id = raw.get('request_id', str(uuid.uuid4()))
print(f"Loaded {len(findings)} findings, request_id={request_id}")

# ============================================================
# STEP 1 — REMOVE DUPLICATES
# ============================================================
seen = {}
duplicates_removed = 0
deduped = []
for f in findings:
    # Normalize detail/issue as dedup key
    detail = f.get('issue', f.get('detail', ''))
    key = (f.get('type',''), f.get('file',''), detail)
    if key in seen:
        duplicates_removed += 1
        continue
    seen[key] = True
    deduped.append(f)

print(f"STEP 1: Removed {duplicates_removed} duplicates, {len(deduped)} remaining")

# ============================================================
# STEP 1.5 — APPLY SEVERITY CEILING
# ============================================================
ceiling_order = ["high", "medium", "low", "info"]
active_ceiling = raw.get('severity_ceiling', 'high')  # default 'high'
ceiling_idx = ceiling_order.index(active_ceiling)

filtered = []
ceiling_filtered = 0
for f in deduped:
    sev = f.get('severity', 'info')
    try:
        finding_idx = ceiling_order.index(sev)
    except ValueError:
        finding_idx = ceiling_order.index('info')  # unknown → treat as info
    
    if finding_idx < ceiling_idx:
        ceiling_filtered += 1
    else:
        filtered.append(f)

print(f"STEP 1.5: ceiling={active_ceiling}, filtered={ceiling_filtered}, remaining={len(filtered)}")

if ceiling_filtered > 0 and len(filtered) == 0:
    print(f"WARNING: severity_ceiling={active_ceiling} filtered out all {ceiling_filtered} findings.")
    print("Setting top_5 = [] (no design work possible)")

# ============================================================
# STEP 2 — SORT BY SEVERITY
# ============================================================
severity_rank = {"high": 0, "medium": 1, "low": 2, "info": 3}

def deprioritize_by_not_possible(f, base_rank):
    """Deprioritize if goose_verdict is NOT_POSSIBLE"""
    gv = f.get('goose_verdict', {})
    if isinstance(gv, dict) and gv.get('verdict') == 'NOT_POSSIBLE':
        return base_rank + 1  # one level lower
    return base_rank

# Each finding gets a sort key
for f in filtered:
    f['_sort_key'] = (
        deprioritize_by_not_possible(f, severity_rank.get(f.get('severity','info'), 3)),
        f.get('id', 'Z-999')
    )

filtered.sort(key=lambda f: f['_sort_key'])

print(f"STEP 2: Sorted {len(filtered)} findings by severity")

# ============================================================
# STEP 3 — ART.1-6 CHECK (Constitution Check)
# ============================================================
BLOCKED_REASONS = {
    'ART1': 'Changes the Constitution (Sovereignty)',
    'ART2': 'Restricts System-Autonomy',
    'ART3': 'Generates Security holes',
    'ART4': 'Endangers System-Stability',
    'ART6': 'Wastes more resources than it saves',
}

blocked = []
passed = []
for f in filtered:
    blocked_art = None
    issue_lower = f.get('issue', '').lower()
    type_f = f.get('type', '')
    
    # Art.1 (Sovereignty): anything modifying constitution/master files
    if any(kw in issue_lower for kw in ['constitution', 'master constitution', 'sovereignty']):
        blocked_art = 'ART1'
    # Art.4 (Stability): system-stability related issues
    elif any(kw in issue_lower for kw in ['stability', 'crash', 'infinite loop']):
        blocked_art = 'ART4'
    # Art.3 (Security): security issues  
    elif any(kw in issue_lower for kw in ['security', 'injection', 'vulnerability', 'exploit']):
        blocked_art = 'ART3'
    # Art.2 (Autonomy): restrictions on autonomy
    elif any(kw in issue_lower for kw in ['autonomy', 'restrict', 'limit agent']):
        blocked_art = 'ART2'
    # Art.6 (Cost-efficiency): resource waste
    elif any(kw in issue_lower for kw in ['resource waste', 'inefficient', 'expensive']):
        blocked_art = 'ART6'
    
    if blocked_art:
        f['_blocked_reason'] = BLOCKED_REASONS[blocked_art]
        blocked.append(f)
    else:
        passed.append(f)

print(f"STEP 3: {len(blocked)} blocked by Art.1-6, {len(passed)} passed")

# ============================================================
# COMPUTE RANK SCORE
# ============================================================
for f in passed:
    rank_sev = severity_rank.get(f.get('severity','info'), 3)
    # Lower score = higher priority
    score = rank_sev * 100
    
    # Goose verdict modifier
    gv = f.get('goose_verdict', {})
    if isinstance(gv, dict):
        v = gv.get('verdict', '')
        if v == 'RESTRICTED':
            score += 10  # slightly deprioritize
        if v == 'NOT_POSSIBLE':
            score += 50  # significantly deprioritize
    
    # File importance: files in recipe/sub/ are higher touch
    file_path = f.get('file', '')
    if 'recipe/sub/' in file_path:
        score -= 5  # slightly prioritize recipe files
    
    f['rank_score'] = score

passed.sort(key=lambda f: (f['rank_score'], f.get('id', 'Z-999')))

# ============================================================
# STEP 4 — TOP-5 SELECTION
# ============================================================
top_5 = passed[:5]
top_5_ids = [f['id'] for f in top_5]

print(f"\nSTEP 4: Top-5 selected:")
for i, f in enumerate(top_5, 1):
    print(f"  {i}. {f['id']} | severity={f['severity']} | type={f['type']} | "
          f"file={f['file'][:60]}... | score={f['rank_score']}")
    print(f"     issue: {f.get('issue','')[:100]}")

# ============================================================
# OUTPUT
# ============================================================
output = {
    'signal': 'DONE',
    'request_id': request_id,
    'from': 'sub_mas-im-rank',
    'to': 'sub_mas-general-improver',
    'status': 'success',
    'timestamp': datetime.now(timezone.utc).isoformat(),
    'data': {
        'ranked_findings': [],
        'top_5': top_5_ids,
        'skipped': [{'id': f['id'], 'reason': f.get('_blocked_reason', 'duplicate')} for f in blocked],
        'ceiling_filtered': ceiling_filtered,
        'active_ceiling': active_ceiling,
        'stats': {
            'total_input': len(findings),
            'duplicates_removed': duplicates_removed,
            'after_dedup': len(deduped),
            'after_ceiling': len(filtered),
            'blocked_by_constitution': len(blocked),
            'final_candidates': len(passed),
        }
    }
}

# Build ranked_findings (all passed ones)
for f in passed:
    entry = {
        'id': f['id'],
        'type': f['type'],
        'severity': f['severity'],
        'file': f['file'],
        'issue': f.get('issue', ''),
        'rank_score': f.get('rank_score', 99),
    }
    if 'goose_verdict' in f:
        entry['goose_verdict'] = f['goose_verdict']
    output['data']['ranked_findings'].append(entry)

# Print most important stats
print(f"\n=== FINAL SUMMARY ===")
print(f"Total input: {len(findings)}")
print(f"Duplicates removed: {duplicates_removed}")
print(f"After ceiling filter: {len(filtered)}")
print(f"Blocked by Art.1-6: {len(blocked)}")
print(f"Final ranked candidates: {len(passed)}")
print(f"Top-5 IDs: {top_5_ids}")

# Write output
with open('.state/pipeline/ranked_findings.yaml', 'w') as f:
    yaml.dump(output, f, default_flow_style=False, sort_keys=False, allow_unicode=True)

print(f"\n✅ Written to .state/pipeline/ranked_findings.yaml")
