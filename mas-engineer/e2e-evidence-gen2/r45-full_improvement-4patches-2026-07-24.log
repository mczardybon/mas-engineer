  - name: sub_mas-framework-auditor
    path: ./sub_mas-framework-auditor.yaml
    description: Framework auditing and validation
  - name: sub_mas-framework-finder
    path: ./sub_mas-framework-finder.yaml
    description: Framework file and structure search
  - name: sub_mas-framework-hardener
    path: ./sub_mas-framework-hardener.yaml
    description: Framework hardening and security
