# mas-engineer/.state/goose-defaults.env
# ============================================================
# Centralized Goose provider/model defaults for ALL mas-engineer recipes
# ============================================================
# Source this file before running any recipe:
#   source .state/goose-defaults.env
#   goose run --recipe <recipe.yaml>
#
# Env-vars OVERRIDE recipe settings (goose precedence: env > recipe.yaml > default)
# Reference: https://goose-docs.ai/docs/guides/environment-variables/
# ============================================================

# Provider: which LLM backend (openai, anthropic, databricks, ollama, ...)
export GOOSE_PROVIDER=openai

# Model: which model the provider uses
# (with provider=openai, this hits OPENAI_HOST below)
# NOTE: deepseek-chat was deprecated server-side 2026-07-23. Use deepseek-v4-flash.
export GOOSE_MODEL=deepseek-v4-flash

# DeepSeek-compatible OpenAI host
# NOTE: MUST end with /v1 (gotcha 3b in goose-cli-e2e-testing skill).
# Without /v1, goose hits https://api.deepseek.com/chat/completions and gets 404.
export OPENAI_HOST=https://api.deepseek.com/v1

# API key (Hermes auto-loads DEEPSEEK_API_KEY from .env into OPENAI_API_KEY)
# If you source this file standalone, you need:
#   export OPENAI_API_KEY=$DEEPSEEK_API_KEY
