findings = doc["data"]["findings"]
print(f"stage={doc.get('stage')} agent={doc.get('agent')} ts={doc.get('timestamp')}")
print(f"raw findings: {len(findings)}")

# --- STEP 1: REMOVE DUPLICATES (type + file + detail) ---
seen = set(); deduped = []
for f in findings:
    key = (f.get("type"), f.get("file"), f.get("issue"))
    if key in seen: continue
    seen.add(key); deduped.append(f)
print(f"after dedupe: {len(deduped)}  (removed {len(findings)-len(deduped)})")

# --- STEP 1.4: ISSUE-DB STATUS FILTER ---
try:
    with open("issue_db.json") as f:
        db = json.load(f)
    status_map = {i.get("issue_hash"): i.get("status") for i in db.get("issues", [])}
    ex = {h for h,s in status_map.items() if s in ("fixed","wontfix","false_positive")}
    kept, dropped = [], []
    for f in deduped:
        h = f.get("issue_hash")
        if h is None or h == "":
            kept.append(f); print(f"WARNING: finding {f.get('id')} without issue_hash, keeping")
        elif h in ex:
            dropped.append(f); print(f"ISSUE-DB-SKIP: {h} ({status_map[h]})")
        else:
            kept.append(f)
    print(f"issue_db_filtered: {len(dropped)} dropped")
    deduped = kept
except Exception as e:
    print(f"issue-db unavailable ({e}); keeping all")

# --- STEP 1.5: SEVERITY CEILING ---
ceiling = doc.get("data", {}).get("severity_ceiling") or "high"
order = ["high","medium","low","info"]
ci = order.index(ceiling) if ceiling in order else 0
before = len(deduped)
deduped = [f for f in deduped if order.index(f.get("severity","info") if f.get("severity") in order else "info") >= ci]
print(f"severity_ceiling={ceiling} ceiling_filtered={before-len(deduped)} remaining={len(deduped)}")

# --- STEP 2: SORT BY SEVERITY (+ NOT_POSSIBLE deprioritize) ---
sev_val = {"high":300,"medium":200,"low":100,"info":50}
def keyf(f):
    s = f.get("severity","info")
    v = sev_val.get(s, 50)
    gv = (f.get("goose_verdict") or {}).get("verdict")
    if gv == "NOT_POSSIBLE": v -= 1
    # tie-break: breadths/structural, stable by id
    return (-v, f.get("id",""))
sorted_f = sorted(deduped, key=keyf)

# --- STEP 3: ART.1-6 CHECK ---
art_skip = []
art_keep = []
for f in sorted_f:
    t = (f.get("type") or "").lower(); fl = (f.get("file") or "").lower()
    reason = None
    if "constitution" in fl or "master-constitution" in t: reason = "Art.1: touches constitution"
    if "general-improver" in fl: reason = "R04: general-improver off-limits"
    if reason: art_skip.append((f, reason)); continue
    art_keep.append(f)
print(f"Art.1-6/R04 skipped: {len(art_skip)}")

# --- STEP 4: TOP-N ---
N = int(os.environ.get("IM_TOP_N","100")); 
if N < 1: N = 100
if N > 500: N = 500
top_N = [f.get("id") for f in art_keep[:N]]
print(f"[im-rank] IM_TOP_N={N} → selecting top {N} of {len(art_keep)} findings")

# --- summary by severity ---
from collections import Counter
print("severity counts (rankable):", dict(Counter(f.get("severity","?") for f in art_keep)))
print("types:", dict(Counter(f.get("type","?") for f in art_keep)))
print()
for i, f in enumerate(art_keep[:N], 1):
    gv = (f.get("goose_verdict") or {}).get("verdict","-")
    print(f"{i:>2}. {f.get('id'):<14} {f.get('severity','?'):<7} rank~{keyf(f)[0]:>4} type={f.get('type','?'):<38} {f.get('file','?')[:70]}")
