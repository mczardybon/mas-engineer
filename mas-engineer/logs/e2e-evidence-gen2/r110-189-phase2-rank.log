import yaml, os, sys
from dev_issue_db import IssueDB

doc = yaml.safe_load(open(".mase/pipeline/findings.yaml"))
findings = doc["data"]["findings"]

# --- STEP 1 dedupe with transparency ---
seen, deduped, dup_log = {}, [], []
for f in findings:
    key = (f.get("type"), f.get("file"), f.get("issue"))
    if key in seen:
        dup_log.append((f.get("id"), seen[key]))
        continue
    seen[key] = f.get("id")
    deduped.append(f)
print(f"STEP1 dedupe: {len(findings)} -> {len(deduped)}  removed={[(d,s) for d,s in dup_log]}")

# --- STEP 1.4 issue-db filter via library (spec-compliant) ---
db = IssueDB(db_path=".mase/pipeline/issue_db.json")
kept, dropped = db.filter_findings(deduped)
print(f"STEP1.4 issue_db_filtered: {dropped} dropped, {len(kept)} kept")
no_hash = [f["id"] for f in kept if not f.get("issue_hash")]
print(f"  warning: {len(no_hash)} findings without issue_hash kept -> {no_hash}")
deduped = kept

# --- STEP 1.5 ceiling ---
ceiling = "high"; order = ["high","medium","low","info"]
ci = order.index(ceiling)
before = len(deduped)
deduped = [f for f in deduped if order.index(f.get("severity","info") if f.get("severity") in order else "info") >= ci]
print(f"STEP1.5 ceiling={ceiling} ceiling_filtered={before-len(deduped)} remaining={len(deduped)}")

# --- STEP 2 sort ---
sev_val = {"high":300,"medium":200,"low":100,"info":50}
def score(f):
    v = sev_val.get(f.get("severity","info"),50)
    if ((f.get("goose_verdict") or {}).get("verdict")) == "NOT_POSSIBLE": v -= 1
    return v
sorted_f = sorted(deduped, key=lambda f: (-score(f), f.get("id","")))

# --- STEP 3 Art.1-6 ---
rankable, skipped = [], []
for f in sorted_f:
    fl = (f.get("file") or "").lower()
    if "constitution" in fl: skipped.append({"id": f["id"], "reason":"Art.1 BLOCKED (constitution)"})
    elif "general-improver" in fl: skipped.append({"id": f["id"], "reason":"R04 off-limits"})
    else: rankable.append(f)
print(f"STEP3 Art.1-6: rankable={len(rankable)} skipped={skipped}")

# --- STEP 4 top-N ---
N = int(os.environ.get("IM_TOP_N","100")); N = 100 if N < 1 else min(N,500)
top = rankable[:N]
print(f"[im-rank] IM_TOP_N={N} -> selecting top {N} of {len(rankable)} findings")
if len(rankable) < N: print(f"WARNING: mismatch — only {len(rankable)} available < IM_TOP_N={N}; fallback to {len(rankable)}")

print()
print(f"{'#':>2} {'id':<14} {'sev':<7} {'score':>5}  file")
for i,f in enumerate(top,1):
    print(f"{i:>2} {f.get('id'):<14} {f.get('severity'):<7} {score(f):>5}  {f.get('file')}")

# JSON for final output
out = {
  "top_N": len(top),
  "ranked_findings": [
    {"finding_id": f.get("id"), "priority": score(f), "severity": f.get("severity")} for f in top
  ]
}
import json
print("\n=== FINAL JSON ===")
