mas-engineer/.state/rules/.last_refresh

# Pipeline transient artifacts (regenerated by im-pipeline runs)
.state/pipeline/findings.yaml
.state/pipeline/ranked_findings.yaml
.state/pipeline/patches.yaml
.state/pipeline/validation.yaml
.state/pipeline/pre_push_validation.yaml
.state/pipeline/summarizer_result.yaml
.state/pipeline/summarizer_result_*.yaml

# Test runtime
__pycache__/
*.pyc
tests/.cache/

# MCP node modules (external deps, not our code)
.mas/mcp/node_modules/

# Checkpoint snapshots (regenerated by recovery sub-agents)
.state/checkpoints/*/
!.state/checkpoints/.gitkeep

# Workflow run logs (runtime, not source)
.state/workflow_runs/
.state/.immune_clean
.state/immune_violations.log

# Secrets - NEVER COMMIT
.env
.env.*
!.env.example
*.env.local
*.env.prod
*DEEPSEEK*key*
*deepseek*key*
.keys
*api_key*
*apikey*
# Runtime/backup
.state/backups/
recipe/dev-mas-engineer.yaml.backup
recipe/sub/*.bak
recipe/sub/*.yaml.bak

# Backup files (created by im-pipeline pre-reset hooks, regenerated on next run)
.state/*.backup
.state/*.backup-*
changes.json
social-media-draft.md
# e2e-results/ runtime (R110-74a — raw-results.json + wrappers sind runtime,
# alle anderen (SUMMARY.txt, RESULT.json, agent-logs/, EVIDENCE-*, REPORT.md,
# MM6-VERIFICATION.md, README.md) werden explizit committed)
# NOTE: e2e-results/ + e2e-evidence/ liegen seit der logs/-Migration (2026-08-07)
# im zentralen Repo-Root-Ordner `logs/`. Die Regel unten bleibt als
# r110134_8-Testbedingung ("e2e-results" im .gitignore) bestehen.
e2e-results/*/raw-results.json
e2e-results/*/wrappers/
 !e2e-results/*/agent-logs/*.log
 !e2e-results/*/evidence/*.log
 logs/**/*.log
 logs/**/*.log.*
 logs/**/raw-results.json
 logs/**/wrappers/*.log
 logs/**/wrappers/*.yaml
 logs/**/agent-logs/*.log
 logs/**/agent-logs/*.log.*
 logs/**/evidence/*.log
 DEEPSEEK_API_KEY
 sk-[a-f0-9]{30,}
 r55_session_count.yaml

# Pre-push-validator runtime artifacts (regenerated on every validator run)
.state/pre-push-e2e-baseline.json
.state/pre-push-test-coverage.json
.state/todo.md
.state/.last_confirmation

# Test coverage (pytest-cov runtime output, binary)
.coverage
