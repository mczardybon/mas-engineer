.mase/audit_result.yaml
.mase/analysis.json
.mase/changes.json
.mase/guardian.yaml
.worktrees/
.monitor/   # mas-controller runtime sidecar (heartbeat, memory/, checkpoints/) — regenerated each cycle
.mase/rules/.last_refresh

# Pipeline transient artifacts (regenerated by im-pipeline runs)
.mase/pipeline/findings.yaml
.mase/pipeline/ranked_findings.yaml
.mase/pipeline/patches.yaml
.mase/pipeline/validation.yaml
.mase/pipeline/pre_push_validation.yaml
.mase/pipeline/summarizer_result.yaml
.mase/pipeline/summarizer_result_*.yaml

# Test runtime
__pycache__/
*.pyc
tests/.cache/

# MCP node modules (external deps, not our code)
.mase/mcp/node_modules/

# Checkpoint snapshots (regenerated by recovery sub-agents)
.mase/checkpoints/*/
!.mase/checkpoints/.gitkeep

# Workflow run logs (runtime, not source)
.mase/workflow_runs/
.mase/.immune_clean
.mase/immune_violations.log

# Secrets - NEVER COMMIT
.env
.env.*
!.env.example
*.env.local
*.env.prod
*DEEPSEEK*key*
*deepseek*key*
.keys
*api_key*
*apikey*
# Runtime/backup
.mase/backups/
recipe/dev-mas-engineer.yaml.backup
recipe/sub/*.bak
recipe/sub/*.yaml.bak

# Backup files (created by im-pipeline pre-reset hooks, regenerated on next run)
.mase/*.backup
.mase/*.backup-*
changes.json
 social-media-draft.md
 # e2e-results/ runtime (R110-74a — raw-results.json + wrappers sind runtime,
 # alle anderen (SUMMARY.txt, RESULT.json, agent-logs/, EVIDENCE-*, REPORT.md,
 # MM6-VERIFICATION.md, README.md) werden explizit committed)
 # NOTE: e2e-results/ + e2e-evidence/ liegen seit der logs/-Migration (2026-08-07)
 # im zentralen Repo-Root-Ordner `logs/`. Seit R110-143 (2026-08-07) werden die
 # e2e .log-Dateien als ÖFFENTLICHER BEWEIS committet (sie sind der Nachweis,
 # dass mas-engineer funktioniert). Sie werden vor Commit auf Secrets gescannt.
 # Die Secret-Muster unten (DEEPSEEK_API_KEY, sk-[a-f0-9]{30,}) verhindern, dass
 # echte Keys je committet werden.
 DEEPSEEK_API_KEY
 sk-[a-f0-9]{30,}
 r55_session_count.yaml

# Pre-push-validator runtime artifacts (regenerated on every validator run)
.mase/pre-push-e2e-baseline.json
.mase/pre-push-test-coverage.json
.mase/todo.md
.mase/.last_confirmation

# Test coverage (pytest-cov runtime output, binary)
.coverage

# R110-164: dev_message_queue runtime state (created by mq tools during tests)
.mase/mq/
.mase/workflow_runs/
.mase/cpdone_consumed.log
.mase/sessionend_consumed.log
.mase/error_consumed.log
