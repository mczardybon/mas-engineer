#!/usr/bin/env python3
"""
mas_cost — Central cost monitoring CLI for mas-engineer.

Usage:
    mas_cost --status                    # show today's cost + budget
    mas_cost --status --workspace PATH   # custom workspace
    mas_cost --set daily_budget_usd=10   # adjust budget in cost.yaml
    mas_cost --reset                     # reset cost_today counter (no-op, just informational)
    mas_cost --breakdown                 # show top-N most expensive sessions
    mas_cost --check                     # exit 0 if ok, exit 1 if exceeded (for scripts)

Configuration: reads/writes .mase/config/cost.yaml
Data source: mas-engineer/.mase/data/goose/sessions.db (per cost.yaml)
"""
import argparse
import os
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML required. Install: pip install pyyaml", file=sys.stderr)
    sys.exit(2)


DEFAULT_COST_CONFIG = {
    "daily_budget_usd": 5.00,
    "per_run_max_usd": 1.00,
    "per_session_max_usd": 0.50,
    "gate": {"daily": "block", "per_run": "block", "per_session": "warn"},
    "cost_source": {
        "db_path": "mas-engineer/.mase/data/goose/sessions.db",
        "table": "sessions",
        "cost_column": "accumulated_cost",
        "timestamp_column": "created_at",
    },
    "display": {"top_n_sessions": 10, "currency_symbol": "$"},
}


def load_config(workspace: Path) -> dict:
    cfg_path = workspace / ".mase" / "config" / "cost.yaml"
    if not cfg_path.exists():
        return DEFAULT_COST_CONFIG
    try:
        loaded = yaml.safe_load(cfg_path.read_text()) or {}
        merged = {**DEFAULT_COST_CONFIG, **loaded}
        for k in ("gate", "cost_source", "display"):
            if k in loaded:
                merged[k] = {**DEFAULT_COST_CONFIG[k], **loaded[k]}
        return merged
    except Exception as e:
        print(f"WARN: cost.yaml unreadable ({e}); using defaults", file=sys.stderr)
        return DEFAULT_COST_CONFIG


def save_config(workspace: Path, config: dict) -> None:
    cfg_path = workspace / ".mase" / "config" / "cost.yaml"
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text(yaml.safe_dump(config, sort_keys=False))


def get_cost_data(workspace: Path, config: dict) -> dict:
    """Read cost data from sqlite db. Returns dict with totals + session list."""
    src = config.get("cost_source", {})
    db_path = workspace / src.get("db_path", "mas-engineer/.mase/data/goose/sessions.db")
    if not db_path.exists():
        return {"cost_today": 0.0, "session_count": 0, "sessions": [], "db_missing": True}

    try:
        con = sqlite3.connect(str(db_path))
        cur = con.cursor()
        # 24h rolling window — supports both text timestamps (sessions.created_at)
        # and unix epoch seconds (usage_ledger.created_timestamp).
        ts_col = src['timestamp_column']
        cur.execute(f"PRAGMA table_info({src['table']})")
        cols = {row[1]: row[2].upper() for row in cur.fetchall()}
        ts_type = cols.get(ts_col, "TEXT")
        if ts_type in ("INTEGER", "REAL", "NUMERIC"):
            # Unix epoch seconds — compare to strftime('%s','now', '-24 hours')
            where_ts = f"{ts_col} >= strftime('%s','now', '-24 hours')"
        else:
            # Text/timestamp — compare to datetime('now', '-24 hours')
            where_ts = f"{ts_col} >= datetime('now', '-24 hours')"
        cur.execute(
            f"SELECT COALESCE(SUM({src['cost_column']}), 0.0) "
            f"FROM {src['table']} "
            f"WHERE {where_ts}"
        )
        cost_today = float(cur.fetchone()[0] or 0.0)
        # Session count
        cur.execute(
            f"SELECT COUNT(*) FROM {src['table']} "
            f"WHERE {where_ts}"
        )
        session_count = int(cur.fetchone()[0] or 0)
        # Top-N sessions
        top_n = config.get("display", {}).get("top_n_sessions", 10)
        # For ledger (per-call) there's no session id column on the row;
        # group by session_id for top-N breakdown.
        id_col = "id" if src["table"] == "sessions" else "session_id"
        name_col = "name" if src["table"] == "sessions" else "session_id"
        sched_col = "schedule_id" if src["table"] == "sessions" else "NULL"
        cur.execute(
            f"SELECT {id_col}, SUM({src['cost_column']}), MAX({ts_col}), "
            f"  MAX({name_col}), MAX({sched_col}) "
            f"FROM {src['table']} "
            f"WHERE {where_ts} "
            f"GROUP BY {id_col} "
            f"ORDER BY SUM({src['cost_column']}) DESC LIMIT {top_n}"
        )
        sessions = [
            {"id": r[0], "cost": float(r[1] or 0), "created_at": r[2], "name": r[3], "schedule": r[4]}
            for r in cur.fetchall()
        ]
        con.close()
        return {"cost_today": cost_today, "session_count": session_count, "sessions": sessions, "db_missing": False}
    except Exception as e:
        return {"cost_today": 0.0, "session_count": 0, "sessions": [], "error": str(e)}


def cmd_status(args, workspace: Path) -> int:
    cfg = load_config(workspace)
    data = get_cost_data(workspace, cfg)
    budget = float(cfg.get("daily_budget_usd", 5.00))
    src = cfg.get("cost_source", {})
    cur = data["cost_today"]
    pct = (cur / budget * 100) if budget else 0
    sym = cfg.get("display", {}).get("currency_symbol", "$")
    gate = cfg.get("gate", {}).get("daily", "block")

    is_ledger = src.get("table") == "usage_ledger"
    unit = "API calls" if is_ledger else "sessions"
    print(f"=== MAS-ENGINEER COST STATUS ===")
    print(f"Workspace:    {workspace}")
    print(f"Source:       {src.get('table')}.{src.get('cost_column')} ({'per-call ledger' if is_ledger else 'per-session'})")
    print(f"Today:        {sym}{cur:.4f} ({data['session_count']} {unit} in 24h)")
    print(f"Daily budget: {sym}{budget:.2f}  ({pct:.0f}% used)")
    print(f"Gate mode:    {gate}")
    if cur >= budget:
        print(f"Status:       ❌ EXCEEDED — runs will be BLOCKED")
    elif cur >= budget * 0.8:
        print(f"Status:       ⚠ WARNING — {(budget-cur):.2f} {sym} remaining")
    else:
        print(f"Status:       ✅ OK — {(budget-cur):.2f} {sym} remaining")

    if args.breakdown and data["sessions"]:
        print(f"\nTop {len(data['sessions'])} most expensive sessions (24h):")
        print(f"  {'ID':32s}  {'Cost':>8s}  {'Created':19s}  Schedule")
        for s in data["sessions"]:
            ca = s['created_at']
            if isinstance(ca, (int, float)):
                # Unix epoch seconds — format to UTC
                from datetime import datetime, timezone
                ca = datetime.fromtimestamp(int(ca), tz=timezone.utc).strftime('%Y-%m-%d %H:%M:%S')
            elif ca is None:
                ca = ''
            print(f"  {s['id'][:32]:32s}  {sym}{s['cost']:>6.3f}  "
                  f"{ca[:19]:19s}  {s['schedule'] or '-'}")
    return 0


def cmd_check(args, workspace: Path) -> int:
    """Exit 0 if ok, 1 if exceeded. For use in cron/scripts."""
    cfg = load_config(workspace)
    data = get_cost_data(workspace, cfg)
    budget = float(cfg.get("daily_budget_usd", 5.00))
    gate = cfg.get("gate", {}).get("daily", "block")
    if data["cost_today"] >= budget:
        if gate == "block":
            print(f"BLOCKED: ${data['cost_today']:.2f}/${budget:.2f}", file=sys.stderr)
            return 1
    print(f"OK: ${data['cost_today']:.2f}/${budget:.2f}")
    return 0


def cmd_set(args, workspace: Path) -> int:
    """Set a config value: --set daily_budget_usd=10"""
    if "=" not in args.set:
        print("ERROR: --set expects key=value (e.g. daily_budget_usd=10)", file=sys.stderr)
        return 2
    key, _, val = args.set.partition("=")
    cfg = load_config(workspace)
    # Type coerce
    if key in ("daily_budget_usd", "per_run_max_usd", "per_session_max_usd"):
        try:
            val = float(val)
        except ValueError:
            print(f"ERROR: {key} must be numeric (USD)", file=sys.stderr)
            return 2
    # Handle nested: gate.daily
    if "." in key:
        section, sub = key.split(".", 1)
        if section not in cfg:
            cfg[section] = {}
        cfg[section][sub] = val
    else:
        cfg[key] = val
    save_config(workspace, cfg)
    print(f"✓ Set {key} = {val} in {workspace}/.mase/config/cost.yaml")
    return 0


def cmd_reset(args, workspace: Path) -> int:
    """Informational: the cost_today counter is read from sqlite at call time.
    Use --prune to archive old sessions, --no-prune to dry-run.
    """
    cfg = load_config(workspace)
    src = cfg.get("cost_source", {})
    db_path = workspace / src.get("db_path", "")
    if not db_path.exists():
        print(f"No db at {db_path}")
        return 0
    # Show what's old
    con = sqlite3.connect(str(db_path))
    cur = con.cursor()
    ts_col = src['timestamp_column']
    cur.execute(f"PRAGMA table_info({src['table']})")
    cols = {row[1]: row[2].upper() for row in cur.fetchall()}
    ts_type = cols.get(ts_col, "TEXT")
    if ts_type in ("INTEGER", "REAL", "NUMERIC"):
        where_ts_old = f"{ts_col} < strftime('%s','now', '-24 hours')"
    else:
        where_ts_old = f"{ts_col} < datetime('now', '-24 hours')"
    cur.execute(
        f"SELECT COUNT(*), COALESCE(SUM({src['cost_column']}),0) "
        f"FROM {src['table']} "
        f"WHERE {where_ts_old}"
    )
    old_count, old_cost = cur.fetchone()
    con.close()
    print(f"Old sessions (>24h): {old_count} (cost: ${float(old_cost):.2f})")
    print("These do NOT count toward 'today' but are kept in db.")
    print("To archive: archive_via_goose_ui OR delete rows manually.")
    print("To change 'today' window: edit cost.yaml cost_source.timestamp_column logic")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="MAS-Engineer cost monitor")
    ap.add_argument("--workspace", default=".", help="Path to mas-engineer workspace (default: cwd)")
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("status", help="Show today's cost + budget")
    s.add_argument("--breakdown", action="store_true", help="Show top-N most expensive sessions")

    c = sub.add_parser("check", help="Exit 0 if ok, 1 if exceeded (for scripts)")

    st = sub.add_parser("set", help="Set config value: --set daily_budget_usd=10")
    st.add_argument("set", help="key=value (e.g. daily_budget_usd=10 or gate.daily=warn)")

    sub.add_parser("reset", help="Show what's outside the 24h window")

    args = ap.parse_args()
    workspace = Path(args.workspace).resolve()
    if not (workspace / ".mase" / "config" / "cost.yaml").exists() and not (workspace / "tools" / "dev_recursion_override.py").exists():
        # Try as parent (in case cwd is mas-engineer/)
        if (workspace / "mas-engineer" / "tools" / "dev_recursion_override.py").exists():
            workspace = workspace / "mas-engineer"
        else:
            print(f"ERROR: workspace not found: {workspace}", file=sys.stderr)
            return 1

    if args.cmd in (None, "status"):
        return cmd_status(args, workspace)
    elif args.cmd == "check":
        return cmd_check(args, workspace)
    elif args.cmd == "set":
        return cmd_set(args, workspace)
    elif args.cmd == "reset":
        return cmd_reset(args, workspace)
    return 0


if __name__ == "__main__":
    sys.exit(main())
