    check_type: length
    check_value: '10'
    found_in: 'Round 1 (User: ''No full-width ASCII'')'
    id: BP-C-001
    rule: No multi-line ASCII frames (>10 lines) in reports
    severity: 🟡 important
  - auto_apply: false
    check_type: contains
    check_value: 5 Bullet
    found_in: 'Round 1 (User: ''No Tablen >10 lines'')'
    id: BP-C-002
    rule: Limit reports to 5 bullet points
    severity: 🟢 info
  prompt:
  - auto_apply: true
    check_type: contains_all
    check_value:
    - v1.0.0
    - ⛔
    found_in: Round 2 (8/14 Sub-agents missing ⛔)
    id: BP-P-001
    rule: Every prompt needs (v1.0.0) + ⛔ boundary
    severity: 🔴 critical
  - auto_apply: true
    check_type: length
    check_value: '500'
    found_in: 'Round 2 (goose-expert: 1842 chars shortened to 500)'
    id: BP-P-002
    rule: prompt ≤500 chars — details belong in instructions
    severity: 🟡 important
  - auto_apply: true
    check_type: regex
    check_value: (v1\.0\.0\)
    found_in: Round 2 (missing at 8/14 sub-agents)
    id: BP-P-003
    rule: 'prompt has Identity: {EMOJI} {NAME} (v1.0.0)'
    severity: 🟡 important
