---
  wf_session_correlate:
    desc: Correlate sessions with changes
    steps:
    - id: gather_data
      action: parallel
      parallel_steps:
      - id: sessions
        action: shell
        cmd: python3 {tools_dir}/dev_goose_db.py --sessions 2>/dev/null | tail -50
        timeout: 30
      - id: costs
        action: shell
        cmd: python3 {tools_dir}/dev_goose_db.py --costs 2>/dev/null | tail -20
        timeout: 30
      - id: change
        action: shell
        cmd: cat {workspace}/.state/change.json 2>/dev/null | tail -30
        timeout: 10
      on_error: continue
    - id: correlate
      action: shell
      cmd: echo 'Timeline created. Pattern will be extracted.'
      depends_on:
      - gather_data
  wf_session_cost: