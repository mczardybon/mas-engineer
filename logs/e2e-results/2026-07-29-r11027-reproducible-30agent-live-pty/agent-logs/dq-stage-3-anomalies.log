import csv
import statistics
from collections import Counter, defaultdict
from datetime import datetime, timedelta
import math

DATA_PATH = "/workspace/dev-branch/mas-engineer/e2e-results/2026-07-29-r11027-reproducible-30agent-live-pty/sample-input/data.csv"

with open(DATA_PATH) as f:
    reader = csv.DictReader(f)
    rows = list(reader)
    cols = reader.fieldnames

n = len(rows)

# ========================
# 1. STAGE 1 PROFILE
# ========================
print("=" * 70)
print("STAGE 1 — DATA PROFILE")
print("=" * 70)
print(f"Rows: {n}, Columns: {cols}")

for col in cols:
    vals = [r[col].strip() for r in rows]
    nulls = sum(1 for v in vals if v == '')
    
    # Try numeric
    nums = []
    for v in vals:
        if v:
            try:
                nums.append(float(v))
            except ValueError:
                pass
    
    print(f"\n--- {col} ---")
    print(f"  Missing: {nulls}/{n} ({100*nulls/n:.1f}%)")
    
    if nums:
        nums_sorted = sorted(nums)
        mean = sum(nums) / len(nums)
        variance = sum((x - mean)**2 for x in nums) / len(nums)
        std = math.sqrt(variance)
        if len(nums_sorted) % 2 == 1:
            median = nums_sorted[len(nums_sorted)//2]
        else:
            median = (nums_sorted[len(nums_sorted)//2 - 1] + nums_sorted[len(nums_sorted)//2]) / 2
        
        # Quartiles for IQR
        def q(data, p):
            idx = int(len(data) * p)
            return data[min(idx, len(data)-1)]
        q1 = q(nums_sorted, 0.25)
        q3 = q(nums_sorted, 0.75)
        iqr = q3 - q1
        
        print(f"  Type: numeric ({len(nums)} non-null)")
        print(f"  Min={min(nums):.0f}, Max={max(nums):.0f}, Mean={mean:.2f}, Median={median:.1f}")
        print(f"  Std={std:.2f}, Q1={q1:.0f}, Q3={q3:.0f}, IQR={iqr:.0f}")
        print(f"  Range [Q1-1.5*IQR, Q3+1.5*IQR] = [{q1-1.5*iqr:.1f}, {q3+1.5*iqr:.1f}]")
        
        # Z-scores
        print(f"  Z-scores:")
        for i, r in enumerate(rows):
            v_str = r[col].strip()
            if v_str and std > 0:
                try:
                    v = float(v_str)
                    z = (v - mean) / std
                    if abs(z) > 2:
                        marker = "⚠️ OUTLIER" if abs(z) > 3 else "⚡ SUSPECT"
                        print(f"    Row {i+1}: {v}  (z={z:.2f}) {marker}")
                except ValueError:
                    pass
    else:
        distinct = set(v for v in vals if v)
        counts = Counter(v for v in vals if v)
        print(f"  Type: categorical ({len(distinct)} distinct values)")
        for val, cnt in counts.most_common():
            print(f"    '{val}': {cnt}")

# ========================
# 2. STAGE 2 VALIDATION
# ========================
print("\n" + "=" * 70)
print("STAGE 2 — VALIDATION (Rule Checks)")
print("=" * 70)

violations = []

for i, r in enumerate(rows):
    row_num = i + 1
    row_violations = []
    
    # Rule 1: id must be present and positive
    id_val = r['id'].strip()
    if not id_val:
        row_violations.append("id missing")
    elif not id_val.isdigit():
        row_violations.append(f"id non-numeric: '{id_val}'")
    
    # Rule 2: age must be 0-120 and present
    age_val = r['age'].strip()
    if not age_val:
        row_violations.append("age MISSING")
    else:
        try:
            age = float(age_val)
            if age < 0:
                row_violations.append(f"age NEGATIVE ({age})")
            elif age > 120:
                row_violations.append(f"age EXCEEDS MAX ({age} > 120)")
            elif age < 18:
                row_violations.append(f"age BELOW MINOR ({age})")
        except ValueError:
            row_violations.append(f"age non-numeric: '{age_val}'")
    
    # Rule 3: country must be a valid 2-letter code
    country_val = r['country'].strip().upper()
    valid_countries = {'DE', 'US', 'UK', 'FR'}
    if not country_val:
        row_violations.append("country MISSING")
    elif country_val not in valid_countries:
        row_violations.append(f"country UNKNOWN CODE: '{country_val}'")
    
    # Rule 4: signup_date must be valid YYYY-MM-DD
    date_val = r['signup_date'].strip()
    if not date_val:
        row_violations.append("signup_date MISSING")
    else:
        try:
            dt = datetime.strptime(date_val, '%Y-%m-%d')
        except ValueError:
            row_violations.append(f"signup_date invalid format: '{date_val}'")
    
    if row_violations:
        violations.append((row_num, r, row_violations))

print(f"Total rows with violations: {len(violations)}/{n}")
for rn, r, v in violations:
    print(f"\n  Row {rn}: id={r['id']}, age='{r['age']}', country='{r['country']}', date='{r['signup_date']}'")
    for vv in v:
        print(f"    ❌ {vv}")

# ========================
# 3. STAGE 3 ANOMALY DETECTION
# ========================
print("\n" + "=" * 70)
print("STAGE 3 — ANOMALY DETECTION")
print("=" * 70)

anomalies = []

# 3a. Statistical outliers (IQR method on age)
age_vals = []
for r in rows:
    v = r['age'].strip()
    if v:
        try:
            age_vals.append(float(v))
        except ValueError:
            pass

if age_vals:
    age_sorted = sorted(age_vals)
    def percentile(data, p):
        k = (len(data) - 1) * p
        f = math.floor(k)
        c = math.ceil(k)
        if f == c:
            return data[int(k)]
        return data[f] * (c - k) + data[c] * (k - f)
    
    q1_age = percentile(age_sorted, 0.25)
    q3_age = percentile(age_sorted, 0.75)
    iqr_age = q3_age - q1_age
    lower_fence = q1_age - 1.5 * iqr_age
    upper_fence = q3_age + 1.5 * iqr_age
    
    mean_age = statistics.mean(age_vals)
    std_age = statistics.stdev(age_vals) if len(age_vals) > 1 else 0
    
    print(f"\n--- Statistical Outliers (age) ---")
    print(f"  Q1={q1_age:.1f}, Q3={q3_age:.1f}, IQR={iqr_age:.1f}")
    print(f"  Inner fences: [{lower_fence:.1f}, {upper_fence:.1f}]")
    print(f"  Mean={mean_age:.1f}, Std={std_age:.1f}")
    
    for i, r in enumerate(rows):
        v = r['age'].strip()
        if v:
            try:
                age = float(v)
                z = (age - mean_age) / std_age if std_age > 0 else 0
                is_iqr = age < lower_fence or age > upper_fence
                is_z = abs(z) > 2
                
                if is_iqr or is_z:
                    severity = "🔴 SEVERE" if (age < 0 or age > 120) else "🟡 MODERATE"
                    methods = []
                    if is_iqr: methods.append("IQR")
                    if is_z: methods.append(f"Z={z:.2f}")
                    
                    anomalies.append({
                        'row': i+1,
                        'field': 'age',
                        'value': age,
                        'method': ', '.join(methods),
                        'severity': severity,
                        'detail': ''
                    })
                    
                    detail_parts = []
                    if age == 150:
                        detail_parts.append("Likely data-entry error (150 instead of 15 or 50)")
                        detail_parts.append("Possible: swapped digits, double-key")
                    if age == -5:
                        detail_parts.append("Impossible negative value — sign error or sensor glitch")
                        detail_parts.append("Possible: missing leading digit e.g. -5 → 25 or 35")
                    
                    print(f"\n  Row {i+1}: age={age}")
                    print(f"    Detection: {', '.join(methods)}")
                    print(f"    Severity: {severity}")
                    for d in detail_parts:
                        print(f"    → {d}")

# 3b. Duplicate records
print(f"\n--- Duplicate Records ---")
seen_rows = set()
dupes = []
for i, r in enumerate(rows):
    row_key = tuple(r[c].strip() for c in cols)
    if row_key in seen_rows:
        dupes.append(i+1)
    else:
        seen_rows.add(row_key)

if dupes:
    print(f"  Found {len(dupes)} duplicate rows: {dupes}")
    anomalies.append({'type': 'duplicate', 'rows': dupes, 'severity': '🟡 MODERATE'})
else:
    print(f"  ✅ No duplicate records found")

# 3c. Temporal anomalies (signup_date gaps, patterns)
print(f"\n--- Temporal Anomalies (signup_date) ---")
dates = []
for i, r in enumerate(rows):
    try:
        dt = datetime.strptime(r['signup_date'].strip(), '%Y-%m-%d')
        dates.append((i+1, dt))
    except ValueError:
        pass

dates.sort(key=lambda x: x[1])

if len(dates) > 1:
    print(f"  Date range: {dates[0][1].date()} to {dates[-1][1].date()}")
    print(f"  Span: {(dates[-1][1] - dates[0][1]).days} days")
    
    # Check for gaps > 60 days
    gaps = []
    for j in range(1, len(dates)):
        diff = (dates[j][1] - dates[j-1][1]).days
        if diff > 60:
            gaps.append((dates[j-1], dates[j], diff))
            anomalies.append({
                'row': dates[j][0],
                'field': 'signup_date',
                'value': str(dates[j][1].date()),
                'method': 'Temporal',
                'severity': '🟡 MODERATE',
                'detail': f"Gap of {diff} days since previous date ({dates[j-1][1].date()})"
            })
    
    if gaps:
        for prev, curr, diff in gaps:
            print(f"  ⚡ Gap detected: {diff} days between row {prev[0]} ({prev[1].date()}) → row {curr[0]} ({curr[1].date()})")
    else:
        print(f"  ✅ No unusual gaps (all gaps < 60 days)")
    
    # Check for monthly distribution
    month_counts = Counter(dt[1].month for dt in dates)
    print(f"  Monthly distribution: {dict(sorted(month_counts.items()))}")
    
    # Check for weekend signups
    weekend_count = sum(1 for _, dt in dates if dt.weekday() >= 5)
    if weekend_count > 0:
        print(f"  Weekend signups: {weekend_count}")
else:
    print(f"  Insufficient dates for temporal analysis")

# 3d. Missing value pattern analysis
print(f"\n--- Missing Value Pattern Analysis ---")
missing_rows = []
for i, r in enumerate(rows):
    empty_cols = [c for c in cols if r[c].strip() == '']
    if empty_cols:
        missing_rows.append((i+1, empty_cols))

if missing_rows:
    print(f"  Total rows with missing values: {len(missing_rows)}")
    # Group by pattern
    pattern_counts = Counter(tuple(sorted(empties)) for _, empties in missing_rows)
