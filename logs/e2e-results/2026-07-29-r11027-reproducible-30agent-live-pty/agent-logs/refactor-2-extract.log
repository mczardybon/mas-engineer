# AFTER — Pipeline.run() becomes a thin orchestrator
def run_pipeline(config: PipelineConfig) -> dict[str, Any]:
    df = DataLoader.load(config)
    X_train, X_test, y_train, y_test = DataCleaner.clean(df, config)
    model = ModelTrainer(config).train(X_train, y_train)
    results = ModelEvaluator.evaluate(model, X_test, y_test)

    model_path = _save_model(model, config.model_dir)
    result_path = _save_results(results, config.output_dir)
    deploy_path = Deployer(config.deploy_target).deploy(config.model_dir)

    return {**results, "model_path": str(model_path),
            "result_path": str(result_path), "deploy_path": str(deploy_path)}
```

**Benefit:** Each class is independently testable, importable without side effects, and swappable (e.g., swap `RandomForestClassifier` for `XGBClassifier` by swapping the `ModelTrainer`).

