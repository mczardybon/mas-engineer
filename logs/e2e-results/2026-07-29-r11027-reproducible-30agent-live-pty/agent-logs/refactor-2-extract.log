def _build_markdown(summary: ReportSummary) -> str:
    lines = [f"# Data Report — {datetime.now().strftime('%Y-%m-%d')}", "",
             f"**Total Records:** {summary.total}", ""]
    lines += _bullet_section("Categories", summary.categories)
    lines += _bullet_section("Statuses", summary.statuses)
    lines += _bullet_section("Priorities", summary.priorities)
    lines += _bullet_section("Assignees", summary.assignees)
    if summary.date_range:
        lines += ["", f"**Date Range:** {summary.date_range[0]} → {summary.date_range[1]}"]
    lines += ["", f"**Total Value:** ${summary.total_value:,.2f}"]
    return "\n".join(lines)

def _bullet_section(title: str, counter: Counter) -> list[str]:
    return [f"## {title}", *[f"- **{k}:** {v}" for k, v in counter.most_common()]]

