```python
# AFTER — extracted
def _validate_row(row: dict[str, str], line_no: int) -> tuple[dict[str, str] | None, list[str]]:
    """Validate a single user row. Returns (validated_dict, error_list)."""
    errs: list[str] = []
    email = _validate_email(row.get("email", "").strip(), errs)
    name = _validate_name(row.get("name", "").strip(), errs)
    age = _validate_age(row.get("age", "").strip(), errs)
    password = row.get("password", "")
    _validate_password(password, errs)
    role = _validate_role(row.get("role", "user").strip(), errs)

    if errs:
        return None, errs
    return {
        "email": email, "name": name, "age": str(age),
        "role": role,
        "password_hash": hashlib.sha256(password.encode()).hexdigest(),
    }, []

def _validate_email(email: str, errs: list[str]) -> str:
    if not email:
        errs.append("email is required")
    elif not re.match(r"[^@]+@[^@]+\.[^@]+", email):
        errs.append(f"invalid email: {email!r}")
    return email
# ... similar for _validate_name, _validate_age, _validate_password, _validate_role
```

**Benefit:** Each validator is independently testable, reusable, and the loop body shrinks from ~40 lines to ~5.

### Extraction 1b — Output writers

```python
# AFTER — extracted
def _write_valid_users(records: list[dict[str, str]], path: Path) -> None:
    with open(path, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=list(records[0].keys()))
        writer.writeheader()
        writer.writerows(records)

def _write_error_report(errors: list[dict[str, str]], path: Path) -> None:
    with open(path, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=["line", "errors"])
        writer.writeheader()
        writer.writerows(errors)

def _write_summary(total: int, valid: int, errors: int, path: Path) -> None:
    text = (
        f"Import completed at {datetime.now().isoformat()}\n"
        f"Total: {total}, Valid: {valid}, Errors: {errors}\n"
    )
    path.write_text(text)
```

**Benefit:** Each writer is independently testable. The main function becomes a clear 3-phase pipeline.

