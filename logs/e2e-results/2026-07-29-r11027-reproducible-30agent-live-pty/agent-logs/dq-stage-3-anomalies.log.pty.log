                        "recommendation": "Remove or impute with median (~33.5)" if severity == "CRITICAL" else "Review and validate"
                    })

                    print(f"\n  Row {i+1}: age={age}")
                    print(f"    Detection: {', '.join(methods)}")
                    print(f"    Severity: {severity}")
                    for d in details:
