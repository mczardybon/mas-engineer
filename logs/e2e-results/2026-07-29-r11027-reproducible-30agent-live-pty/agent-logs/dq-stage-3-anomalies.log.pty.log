        except:
            pass

if len(pairs) > 2:
    n_p = len(pairs)
    sum_x = sum(p[0] for p in pairs)
    sum_y = sum(p[1] for p in pairs)
    sum_xy = sum(p[0] * p[1] for p in pairs)
    sum_x2 = sum(p[0]**2 for p in pairs)
    sum_y2 = sum(p[1]**2 for p in pairs)
    r_num = n_p * sum_xy - sum_x * sum_y
    r_den = math.sqrt((n_p * sum_x2 - sum_x**2) * (n_p * sum_y2 - sum_y**2))
    r_corr = r_num / r_den if r_den != 0 else 0
    print(f"  Pearson r = {r_corr:.3f}")
    if abs(r_corr) > 0.5:
        print(f"  ⚠️ Moderate correlation between id and age (r={r_corr:.3f}) — possible data artifact")

