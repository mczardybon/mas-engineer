from sample_with_bugs import average, find_user, Counter


# ===========================================================================
# 1. average()
# ===========================================================================

def examples_average() -> None:
    """Demonstrate the intended use of ``average()``.

    **Known bugs**
        - Off-by-one in the loop (``range(len(numbers) + 1)``) → raises
          ``IndexError`` on most non-empty inputs.
        - Missing empty-list guard → ``ZeroDivisionError`` when input is ``[]``.
    """

    # -- Normal case --------------------------------------------------------
    nums = [1, 2, 3, 4, 5]
    result = average(nums)           # intended: (1+2+3+4+5) / 5 = 3
    print(f"average({nums}) = {result}  (expected 3)")

    # -- Single-element list ------------------------------------------------
    result = average([10])            # intended: 10 / 1 = 10
    print(f"average([10]) = {result}  (expected 10)")

    # -- All zeros ----------------------------------------------------------
    result = average([0, 0, 0])       # intended: 0
    print(f"average([0, 0, 0]) = {result}  (expected 0)")

    # -- Negative numbers ---------------------------------------------------
    result = average([-5, 0, 5])      # intended: 0
    print(f"average([-5, 0, 5]) = {result}  (expected 0)")

    # -- Empty list (triggers ZeroDivisionError) ----------------------------
    try:
        average([])
    except ZeroDivisionError:
        print("average([]) → ZeroDivisionError (expected: bug — no guard)")

    # -- Off-by-one: every non-empty list will try to access an out-of-range
    #    index, raising IndexError.  Uncomment to observe:
    # try:
    #     average([1, 2])
    # except IndexError:
    #     print("average([1, 2]) → IndexError (expected: bug — off-by-one)")


