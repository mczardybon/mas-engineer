import csv, sys
from collections import Counter, defaultdict

infile = '/workspace/dev-branch/mas-engineer/e2e-results/2026-07-29-r11027-reproducible-30agent-live-pty/sample-input/data.csv'

with open(infile) as f:
    reader = csv.DictReader(f)
    rows = list(reader)

cols = reader.fieldnames
n = len(rows)
print(f'=== Data Profile: {infile} ===')
print(f'Row count (excl. header): {n}')
print(f'Columns ({len(cols)}): {cols}')
print()

# Per-column analysis
missing = {}
types_ = {}
stats = defaultdict(lambda: {'numeric': [], 'non_numeric': []})

for col in cols:
    vals = [r[col] for r in rows]
    nulls = sum(1 for v in vals if v.strip() == '')
    missing[col] = nulls
    # Attempt numeric
    numeric_vals = []
    for v in vals:
        v = v.strip()
        if v == '':
            continue
        try:
            numeric_vals.append(float(v))
        except ValueError:
            pass
    if numeric_vals:
        sv = sorted(numeric_vals)
        m = sum(sv) / len(sv)
        # crude median
        if len(sv) % 2 == 1:
            median = sv[len(sv)//2]
        else:
            median = (sv[len(sv)//2 - 1] + sv[len(sv)//2]) / 2
        stats[col] = {
            'type': 'numeric',
            'non_null': len(numeric_vals),
            'min': min(sv),
            'max': max(sv),
            'mean': round(m, 2),
            'median': median,
            'std': round((sum((x - m)**2 for x in sv) / len(sv))**0.5, 2)
        }
    else:
        # categorical / string
        distinct = len(set(v.strip() for v in vals if v.strip() != ''))
        top_vals = Counter(v.strip() for v in vals if v.strip() != '').most_common(5)
        stats[col] = {
            'type': 'categorical/string',
            'non_null': n - nulls,
            'distinct_values': distinct,
            'top_values': top_vals
        }

for col in cols:
    s = stats[col]
    print(f'[{col}]')
    print(f'  Missing: {missing[col]}  ({100*missing[col]/n:.1f}%)')
    print(f'  Type: {s[\"type\"]}')
    if s['type'] == 'numeric':
        print(f'  Non-null: {s[\"non_null\"]}')
        print(f'  Min: {s[\"min\"]} | Max: {s[\"max\"]} | Mean: {s[\"mean\"]} | Median: {s[\"median\"]} | Std: {s[\"std\"]}')
    else:
        print(f'  Non-null: {s[\"non_null\"]}')
        print(f'  Distinct values: {s[\"distinct_values\"]}')
        for val, cnt in s['top_values']:
            print(f'    \"{val}\": {cnt}')
    print()

# Also show a sample of missing cells
print('=== Rows with missing values ===')
for i, r in enumerate(rows, start=1):
    empties = [c for c in cols if r[c].strip() == '']
    if empties:
        print(f'  Row {i}: missing columns {empties}')
"
