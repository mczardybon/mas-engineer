    command: cd /tmp/mas-engineer-test/mas-engineer && echo "=== YAML VALIDATION ===" && for f in $(find recipe/ -name "*.yaml" -not -path "*/legacy/*" 2>/dev/null); do python3 -c "import yaml,sys; yaml.safe_load(open('$f'))" 2>&1 && echo "PASS: $f" || echo "FAIL: $f"; done


