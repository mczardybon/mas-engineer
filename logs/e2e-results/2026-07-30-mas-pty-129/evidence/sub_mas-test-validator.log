  ▸ shell
    command: cd /tmp/mas-engineer-test/mas-engineer && echo "=== SCHEMA CHECK: required fields ===" && python3 -c "
import yaml, glob, os

required_top = ['name', 'version', 'title', 'description']
required_sub_recipe = ['name', 'path']
required_settings = ['timeout', 'max_steps']
required_test_fields = ['name', 'version', 'title', 'description', 'instructions', 'prompt', 'settings']

failures = []
for f in glob.glob('recipe/**/*.yaml', recursive=True):
    if '/legacy/' in f or '/template/' in f:
        continue
    try:
        d = yaml.safe_load(open(f))
        if not isinstance(d, dict):
            failures.append((f, 'not a dict'))
            continue
        
        # Check top-level required fields
        for k in required_top:
            if k not in d:
                failures.append((f, f'missing top-level field: {k}'))
        
        # Check version format
        if 'version' in d and not str(d['version']).startswith('1.'):
            failures.append((f, f'unusual version format: {d[\"version\"]}'))
        
        # Check settings
        if 'settings' in d:
            for k in required_settings:
                if k not in d['settings']:
                    failures.append((f, f'missing settings.{k}'))
        
        # Check sub_recipes if present
        if 'sub_recipes' in d:
            for i, sr in enumerate(d['sub_recipes']):
                if isinstance(sr, dict):
                    for k in required_sub_recipe:
                        if k not in sr:
                            failures.append((f, f'sub_recipes[{i}] missing: {k}'))
        
        # Check extensions if present
        if 'extensions' in d:
            for i, ext in enumerate(d['extensions']):
                if isinstance(ext, dict):
                    if 'name' not in ext:
                        failures.append((f, f'extensions[{i}] missing name'))
                    if 'type' not in ext:
                        failures.append((f, f'extensions[{i}] missing type'))
        
    except Exception as e:
        failures.append((f, str(e)))

if failures:
    for f, msg in failures:
        print(f'FAIL: {f} — {msg}')
else:
    print('ALL PASS: All configs have required fields')
print(f'Total files checked: {len(glob.glob(\"recipe/**/*.yaml\", recursive=True))}')
"


