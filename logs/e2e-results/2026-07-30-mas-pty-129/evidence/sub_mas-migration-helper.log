import yaml

with open('/tmp/mas-engineer-test/mas-engineer/.state/workflows.yaml.backup-r11036-fix') as f:
    bak = yaml.safe_load(f)

with open('/tmp/mas-engineer-test/mas-engineer/.state/workflows.yaml') as f:
    cur = yaml.safe_load(f)

# Compare sub_agents
bak_subs = set()
cur_subs = set()

for cat, agents in bak.get('configs', {}).get('mas-self', {}).get('sub_agents', {}).items():
    if isinstance(agents, list):
        for a in agents:
            if isinstance(a, str) and a.startswith('sub_mas-'):
                bak_subs.add(a)

for cat, agents in cur.get('configs', {}).get('mas-self', {}).get('sub_agents', {}).items():
    if isinstance(agents, list):
        for a in agents:
            if isinstance(a, str) and a.startswith('sub_mas-'):
                cur_subs.add(a)

new_subs = cur_subs - bak_subs
removed_subs = bak_subs - cur_subs

print(f'=== SUB-AGENT REGISTRY COMPARISON ===')
print(f'Backup: {len(bak_subs)} sub-agents')
print(f'Current: {len(cur_subs)} sub-agents')
print(f'')
print(f'NEW (added in current): {len(new_subs)}')
for s in sorted(new_subs):
    print(f'  + {s}')
print(f'')
print(f'REMOVED (in backup, not in current): {len(removed_subs)}')
for s in sorted(removed_subs):
    print(f'  - {s}')

# Compare top-level keys
print(f'')
print(f'=== TOP-LEVEL KEYS ===')
bak_keys = set(bak.keys())
cur_keys = set(cur.keys())
print(f'New keys: {cur_keys - bak_keys}')
print(f'Removed keys: {bak_keys - cur_keys}')

# Compare agents section
bak_agents = set()
cur_agents = set()
if isinstance(bak.get('configs', {}).get('mas-self', {}), dict):
    for k, v in bak.get('configs', {}).get('mas-self', {}).items():
        if isinstance(v, dict) and v.get('type') == 'agent':
            bak_agents.add(k)
if isinstance(cur.get('configs', {}).get('mas-self', {}), dict):
    for k, v in cur.get('configs', {}).get('mas-self', {}).items():
        if isinstance(v, dict) and v.get('type') == 'agent':
            cur_agents.add(k)

print(f'')
print(f'=== AGENT DEFINITIONS ===')  
print(f'Backup: {len(bak_agents)} agents defined')
print(f'Current: {len(cur_agents)} agents defined')
new_agents = cur_agents - bak_agents
removed_agents = bak_agents - cur_agents
print(f'New agents: {sorted(new_agents) if new_agents else \"none\"}')
print(f'Removed agents: {sorted(removed_agents) if removed_agents else \"none\"}')
"


