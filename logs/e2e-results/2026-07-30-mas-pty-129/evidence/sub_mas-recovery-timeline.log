import yaml, json
with open('/tmp/mas-engineer-test/mas-engineer/.state/workflows.yaml') as f:
    data = yaml.safe_load(f)

# Search for recovery-timeline in all sections
def find_key(data, target, path=''):
    results = []
    if isinstance(data, dict):
        for k, v in data.items():
            p = f'{path}.{k}' if path else k
            if target in str(k).lower() or target in str(v).lower()[:50]:
                results.append(f'{p}: {json.dumps(v)[:300]}')
            results.extend(find_key(v, target, p))
    elif isinstance(data, list):
        for i, item in enumerate(data):
            p = f'{path}[{i}]'
            results.extend(find_key(item, target, p))
    return results

for r in find_key(data, 'timeline'):
    print(r)
print('---')
for r in find_key(data, 'recovery'):
    print(r)
