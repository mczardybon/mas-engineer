    content: #!/usr/bin/env python3
"""Python Validator v1.0.0 — batch validation of all .py files."""
import subprocess, sys, os, re

RESULTS = []

def color(s, code):
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else s

def check_file(path):
    rel = os.path.relpath(path, start=os.path.dirname(os.path.abspath(__file__)))
    issues = []

    # 1) Syntax check
    with open(path, 'r') as f:
        code = f.read()
    try:
        compile(code, path, 'exec')
    except SyntaxError as e:
        issues.append(f"  🔴 SYNTAX ERROR: {e}")

    # 2) Print debugging
    print_lines = []
    for i, line in enumerate(code.split('\n'), 1):
        stripped = line.strip()
        if stripped.startswith('print(') and 'TODO' not in stripped and 'FIXME' not in stripped:
            print_lines.append(f"    L{i}: {line.rstrip()}")
    if print_lines:
        issues.append(f"  🟡 print() statements ({len(print_lines)}):")
        issues.extend(print_lines[:5])
        if len(print_lines) > 5:
            issues.append(f"    ... and {len(print_lines)-5} more")

    # 3) Hardcoded paths (/home/)
    home_lines = []
    for i, line in enumerate(code.split('\n'), 1):
        if '/home/' in line and not line.strip().startswith('#'):
            home_lines.append(f"    L{i}: {line.rstrip()}")
    if home_lines:
        issues.append(f"  🟠 Hardcoded /home/ paths ({len(home_lines)}):")
        issues.extend(home_lines[:5])
        if len(home_lines) > 5:
            issues.append(f"    ... and {len(home_lines)-5} more")

    # 4) TODO/FIXME/HACK
    todo_lines = []
    for i, line in enumerate(code.split('\n'), 1):
        if re.search(r'(TODO|FIXME|HACK)', line):
            todo_lines.append(f"    L{i}: {line.rstrip()}")
    if todo_lines:
        issues.append(f"  🟡 TODO/FIXME/HACK markers ({len(todo_lines)}):")
        issues.extend(todo_lines[:5])
        if len(todo_lines) > 5:
            issues.append(f"    ... and {len(todo_lines)-5} more")

    status = "✅ PASS" if not issues else "⚠️  ISSUES"
    return rel, status, issues

def main():
    root = os.path.dirname(os.path.abspath(__file__))
    # Find all .py files
    py_files = []
    for dirpath, dirnames, filenames in os.walk(root):
        # Skip e2e-results, testproject
        dirnames[:] = [d for d in dirnames if d not in ('e2e-results', 'testproject', '__pycache__', '.git')]
        for fn in sorted(filenames):
            if fn.endswith('.py'):
                py_files.append(os.path.join(dirpath, fn))

    print(f"🔍 PYTHON-VALIDATOR v1.0.0")
    print(f"📁 Scanning {len(py_files)} Python files\n")

    all_ok = True
    for pf in py_files:
        rel, status, issues = check_file(pf)
        if issues:
            all_ok = False
            print(f"─── {rel} ───")
            print(f"  {status}")
            for i in issues:
                print(i)
            print()
        else:
            print(f"  ✅ {rel}")

    total_issues = sum(1 for pf in py_files if check_file(pf)[1] == "⚠️  ISSUES")
    print(f"\n{'='*60}")
    print(f"📊 SUMMARY: {len(py_files)} files checked")
    print(f"   ✅ Pass: {len(py_files) - total_issues}")
    print(f"   ⚠️  Issues: {total_issues}")
    return 0 if all_ok else 1

if __name__ == '__main__':
    sys.exit(main())


