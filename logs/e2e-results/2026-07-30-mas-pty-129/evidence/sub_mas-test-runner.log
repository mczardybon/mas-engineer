import yaml, subprocess, sys

# Use find to get all yaml files excluding hidden dirs
result = subprocess.run(
    'find . -name \"*.yaml\" -o -name \"*.yml\" | grep -v \"/\\.\" | sort',
    shell=True, capture_output=True, text=True
)
files = [f for f in result.stdout.strip().split('\n') if f]

errors = []
for path in files:
    try:
        with open(path) as fh:
            data = yaml.safe_load(fh)
        if data is None:
            errors.append(f'{path}: EMPTY')
    except yaml.YAMLError as e:
        errors.append(f'{path}: {e}')

if errors:
    for e in errors:
        print(f'  ❌ {e}')
    sys.exit(len(errors))
else:
    print(f'  ✅ All {len(files)} YAML files in workspace passed CORONASHIELD validation.')
