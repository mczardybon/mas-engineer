import yaml, os

# Check recipe files for settings, version, description
recipe_dir = '/tmp/mas-engineer-test/mas-engineer/recipe'
results = []
for root, dirs, files in os.walk(recipe_dir):
    for f in files:
        if f.endswith('.yaml') and f.startswith('sub_mas-'):
            path = os.path.join(root, f)
            try:
                with open(path) as fh:
                    data = yaml.safe_load(fh)
                if isinstance(data, dict):
                    name = data.get('name', f)
                    desc = data.get('description', '')
                    version = data.get('version', '')
                    settings = data.get('settings', {})
                    if isinstance(settings, dict):
                        gm = settings.get('goose_model', '')
                        gp = settings.get('goose_provider', '')
                        timeout = settings.get('timeout', '')
                        max_steps = settings.get('max_steps', '')
                        results.append({
                            'name': name,
                            'desc': str(desc)[:60],
                            'version': version,
                            'goose_model': gm,
                            'goose_provider': gp,
                            'timeout': timeout,
                            'max_steps': max_steps
                        })
            except Exception as e:
                pass

# Count unique values
versions = set()
models = set()
providers = set()
timeouts = set()
max_stepss = set()
for r in results:
    if r['version']: versions.add(str(r['version']))
    if r['goose_model']: models.add(str(r['goose_model']))
    if r['goose_provider']: providers.add(str(r['goose_provider']))
    if r['timeout']: timeouts.add(r['timeout'])
    if r['max_steps']: max_stepss.add(r['max_steps'])

print(f'Total sub recipes checked: {len(results)}')
print(f'Unique versions: {sorted(versions)}')
print(f'Unique goose_model: {sorted(models)}')
print(f'Unique goose_provider: {sorted(providers)}')
print(f'Unique timeout: {sorted(timeouts)}')
print(f'Unique max_steps: {sorted(max_stepss)}')
print()
print('=== SAMPLE ENTRIES ===')
for r in results[:5]:
    print(f'{r[\"name\"]}: v={r[\"version\"]}, model={r[\"goose_model\"]}, prov={r[\"goose_provider\"]}, to={r[\"timeout\"]}, ms={r[\"max_steps\"]}')
