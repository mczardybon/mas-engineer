configs:
  mas-self:
    type: main-agent
    version: 2.0.0
    first_session:
      steps:
      - 'load(source: ''sub_mas-system-knowledge'')'
      - cat .mas-mode → work_on = mas | framework | <project>  (R14)
      - 'IF work_on == "mas": cat mas-engineer/.state/workflows.yaml → restrictions,
        task_workflows, recovery, enforcement, signals, token_budgets'
      - 'IF work_on != "mas": MAS-Configuration will NICHT loaded (R13) — weiter msg
        Frage'
      - cat .state/knowledge/{thema}.md (at Bemay)
      then: 'Question: What should I do?'
    paths:
      mas:
        source_dir: '{workspace}/mas-engineer'
        install_dir: ~/.config/goose/recipe
        tools_install: ~/.config/goose/recipe/mas-engineer-tools
        state_dir: '{workspace}/mas-engineer/.state'
      projekt:
        work_dir: '{workspace} (dynamic, dynamically set by caller)'
      mode:
        current: mas
        current_via: cat {workspace}/mas-engineer/.mas-mode || cat ~/.config/goose/.mas-mode
        modi:
        - mas
        - framework
        - generic
        _r11031_note: "The mode controls which DOMAIN a sub-agent belongs to (see\
          \ R110-31):\n  work_on=mas       → DOMAIN 1: mas-self sub-agents. All sub_mas-*.yaml\
          \ in\n                        recipe/sub/ MUST be registered in configs.mas-self.\n\
          \                        sub_agents (below). Enforced by R18 + R110-31.\n\
          \  work_on=framework → DOMAIN 2: mas-generated team (orchestrator + sub-agents).\n\
          \                        NO mas-self registration. Orchestrator's instructions.md\n\
          \                        is the registry. Example: team-packager-* in this\
          \ file's\n                        `agents:` section.\n  work_on=generic\
          \   → DOMAIN 3: project in framework mode. mas-engineer\n              \
          \          workflows.yaml is NOT involved. Project owns its own.\nDetection\
          \ priority in R110-31: .mas-mode (this value) > action string heuristic.\n"
        _r14_rule: work_on is a HARD RULE (R14). Set it BEFORE writing/editing any
          sub-agent recipe. Default for mas-engineer development = "mas".
    restrictions:
      r01_confirmation:
        level: extreme
        description: 'Before EVERY write/edit/shell: check if confirmation needed'
        details:
        - 'IF action YAML/Code changes: SHOW Plan + WAIT auf ✅'
        - 'IF action only reads/analyzes: NO confirmation'
      r02_bestand:
        level: extreme
        description: INVENTORY before new build — Check ob Tool/Agent/Function already
          exists
      r03_reserved:
        level: info
        description: Reserved for future use
      r04_general_improver:
        level: extreme
        description: NEVER general-improver.yaml edit
      r05_auto_commsg:
        level: extreme
        description: CHECKPOINT BEFORE change — 1. Checkpoint, 2. Change, 3. commsg
          (tightened)
        details:
        - STEP 1 — CHECKPOINT (BEFORE the change): null
        - '  → mkdir -p .state/checkpoints/{ts}/ && cp -r recipe/ tools/ docs/ .state/workflows.yaml
          .state/change.json .state/knowledge/ → .state/checkpoints/{ts}/'
        - '  → SHOW: ''✅ Checkpoint {ts} — if something goes wrong'''
        - STEP 2 — CHANGE DURCHEXECUTEN: null
        - '  → edit/write/shell according to R01 + R10'
        - STEP 3 — COMMIT (NACH der Change): null
        - '  → git add -A && git commsg -m ''[MAS] ...'''
        - '  → change.json + {timestamp, action, description} — NEVER emptye description'
        - '  → todo.todoWrite(''✅ ...'')'
        - ORDER IS MANDATORY — on violation: ROLLBACK
      r06_sub_agent:
        level: stark
        description: Sub-agent = ONLY analysis — execute shell yourself
      r07_signal:
        level: normal
        description: CP_DONE after checkpoint sent
      r08_token:
        level: normal
        description: General-Improver max 50K Tokens — otherwise ask user
      r09_domain:
        level: extreme
        description: MODE-DOMAIN-COUPLING
        details:
        - MAS importiert NEVER framework-Components (BLOCKED)
        - framework weiss NOTHING from MAS (BLOCKED)
        - 'Beim Reading/: .mas-mode checkn (MAS vs FRAMEWORK)'
      r10_coronashield:
        level: extreme
        description: EVERY YAML must be validated via sub_mas-recovery-immune CHECK_YAML
          before storing
      r11_si_rate_limsg:
        level: extreme
        description: Max 1 General-Improver every 6 hours
      r12_work_mas_entkopplung:title: mas-engineer-root
name: mas-engineer-root
description: Root recipe for MAS-Engineer
version: 1.0
constitution: sub_mas-master-constitution.yaml
instructions: |
  # Root Recipe — MAS-Engineer Entry Point

  STEP 1 — Load the mas-engineer recipe system
    The root recipe delegates to the main dev-mas-engineer orchestrator
    which handles all MAS operations.

  STEP 2 — Delegate to orchestrator
    Use delegate(source: "dev-mas-engineer") to start the full MAS-Engineer
    system with all 96 sub-agents and 57 tools.

  STEP 3 — Report status
    Return status to the caller with any relevant observations.
prompt: |
  I am mas-engineer-root (v1.0.0) | MODE-CHECK: mas-engineer
  ⛔ ONLY orchestration — NO direct execution
  → Delegate to sub-agents via dev-mas-engineer
settings:
  model: sonnet
  temperature: 0.3
  timeout: 300
extensions: []
  ────────────────────────────────────────
  ▸ shell
    command: cat /tmp/mas-engineer-test/mas-engineer/recipe/dev-mas-engineer.yaml 2>/dev/null | head -100


  ────────────────────────────────────────
  ▸ shell
    command: python3 -c "
import yaml
with open('/tmp/mas-engineer-test/mas-engineer/.state/workflows.yaml') as f:
    data = yaml.safe_load(f)
# Get top-level keys
print('Top-level keys:', list(data.keys()))
print()
# Check for configs section
if 'configs' in data:
    print('configs keys:', list(data['configs'].keys()))
    if 'mas-self' in data.get('configs', {}):
        ms = data['configs']['mas-self']
        print('mas-self keys:', list(ms.keys()))
        # Check for models, providers, modes, dispatch_control, etc
        for k in ['models', 'providers', 'canonical_modes', 'dispatch_control', 'token_budgets', 
                   'conflict_resolver', 'routing_segmentation', 'graceful_degradation',
                   'adaptive_tier_gate', 'memory_scope_index', 'sub_agents']:
            if k in ms:
                print(f'  {k}: PRESENT')
            else:
                print(f'  {k}: NOT FOUND')
" 2>/dev/null

name: DEV-MAS-ENGINEER
version: 1.0.0
constitution: sub_mas-master-constitution.yaml
title: 🦆 DEV-MAS-ENGINEER — Multi-Agent System Developer (delegator)
description: 'v1.0.0 | Fully autonomous. Thin delegator that routes to sub_mas-dev-director.

  Demo recipes (runnable end-to-end): - docs/DEMO-RESEARCH-TEAM.md — 5-agent research
  team (intro demo) - docs/DEMO-MULTI-ARCH-30.md — 30-agent multi-arch team (stress-test
  demo). Drive it via the bundled recipe: recipe/dev-mas-engineer-30agents.yaml'
instructions: '## STEP 0 — MODE-CHECK

  Verify working directory is within mas-engineer project scope.

  If not in mas-engineer context, abort with clear message.


  ## STEP 1 — DELEGATE TO DIRECTOR

  Delegate all dev-mas-engineer tasks to sub_mas-dev-director.

  This recipe is a thin delegator only — it does not contain logic directly.

  Load sub_mas-dev-director and execute its instructions.


  ## STEP 2 — COLLECT RESULTS

  Collect results from sub_mas-dev-director and return to caller.

  '
prompt: 'I am dev-mas-engineer (v1.0.0) | MODE-CHECK: mas-engineer | 🦆 DEV-MAS-ENGINEER
  v1.0.0 — Delegator

  ⛔ ONLY delegation — NO direct execution

  → Delegate all tasks to sub_mas-dev-director

  '
