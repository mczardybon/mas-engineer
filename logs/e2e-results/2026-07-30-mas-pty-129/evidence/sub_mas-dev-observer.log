- type: platform
  name: summon
- type: builtin
  name: developer
  display_name: Developer
  timeout: 300
  bundled: true
sub_recipes:
- name: sub_mas-dashboard-collector
  path: ./sub_mas-dashboard-collector.yaml
  description: Collect and validate dashboard data from projects and state files
