from pathlib import Path
import re

recovery_dir = Path('recipe/template/recovery')

for f in sorted(recovery_dir.glob('*.yaml')):
    content = f.read_text()
    print(f'--- {f.name} (lines={len(content.splitlines())}, size={len(content)} bytes) ---')
    
    # Check for Jinja2 variable syntax
    jinja_vars = re.findall(r'\{\{.*?\}\}', content)
    if jinja_vars:
        print(f'  Jinja2 variables: {jinja_vars}')
    
    # Check for Jinja2 block syntax
    jinja_blocks = re.findall(r'\{%[-+]?.*?%\}', content)
    if jinja_blocks:
        print(f'  Jinja2 blocks: {jinja_blocks}')
    
    # Check for Go template syntax
    go_tmpl = re.findall(r'\{\{[^%].*?\}\}', content)
    if go_tmpl:
        print(f'  Go template: {go_tmpl}')
    
    # Check for brace-enclosed variables (template variables like {workspace})
    brace_vars = re.findall(r'\{(\w+)\}', content)
    if brace_vars:
        unique_vars = sorted(set(brace_vars))
        print(f'  Brace-style vars: {unique_vars}')
    
    print()
