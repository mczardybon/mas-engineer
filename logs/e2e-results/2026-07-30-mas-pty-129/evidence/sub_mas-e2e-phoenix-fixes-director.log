    command: cd /tmp/mas-engineer-test/mas-engineer && python3 -c "
import yaml, os, sys
from pathlib import Path

recovery_dir = Path('recipe/template/recovery')
files = sorted(recovery_dir.glob('*.yaml'))
print(f'Found {len(files)} template files:')
errors = 0
for f in files:
    try:
        with open(f) as fh:
            data = yaml.safe_load(fh)
        name = data.get('name', 'UNKNOWN')
        ver = data.get('version', 'MISSING')
        title = data.get('title', 'MISSING')
        desc = data.get('description', 'MISSING')
        settings = data.get('settings', {})
        print(f'  ✓ {f.name}: name={name!r}, version={ver}, timeout={settings.get(\"timeout\", \"not-set\")}')
        # Check required fields
        missing = []
        for field in ['name', 'version', 'title', 'description', 'instructions', 'prompt', 'settings']:
            if field not in data:
                missing.append(field)
        if missing:
            print(f'    ⚠ Missing fields: {missing}')
            errors += 1
    except Exception as e:
        print(f'  ✗ {f.name}: {e}')
        errors += 1

print(f'\nTotal errors: {errors}')
sys.exit(0 if errors == 0 else 1)
" 2>&1


