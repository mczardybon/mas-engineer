for v in sorted(all_vars):
    files_using = [fname for fname, vlist in vars_by_file.items() if v in vlist]
    print('  {%s} — used in: %s' % (v, ', '.join(files_using)))

print()
print('=== Per-file variable definitions ===')
for fname, vlist in vars_by_file.items():
    print('  %s: {%s}' % (fname, ', '.join('{%s}' % v for v in vlist)))
