from pathlib import Path
import re

recovery_dir = Path('recipe/template/recovery')

all_vars = set()
vars_by_file = {}
for f in sorted(recovery_dir.glob('*.yaml')):
    content = f.read_text()
    brace_vars = re.findall(r'\{([a-zA-Z_][a-zA-Z0-9_]*)\}', content)
    vars_by_file[f.name] = sorted(set(brace_vars))
    all_vars.update(brace_vars)

