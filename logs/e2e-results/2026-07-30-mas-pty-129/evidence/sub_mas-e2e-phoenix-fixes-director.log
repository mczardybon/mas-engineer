from pathlib import Path

recovery_dir = Path('recipe/template/recovery')

# Check for Jinja2/go template syntax patterns
import re
jinja_patterns = {
    'jinja2_variable': r'\{\{.*?\}\}',
    'jinja2_block': r'\{%\s*(if|for|set|include|extends|block|macro|call|raw)\b.*?%\}',
    'jinja2_comment': r'\{#.*?#\}',
    'go_template_variable': r'\{\{[^%].*?\}\}',
    'go_template_action': r'\{\{.*?\}\}',
}

for f in sorted(recovery_dir.glob('*.yaml')):
    content = f.read_text()
    print(f'--- {f.name} (lines={len(content.splitlines())}, size={len(content)} bytes) ---')
    for pname, pattern in jinja_patterns.items():
        matches = re.findall(pattern, content, re.DOTALL)
        if matches:
            print(f'  {pname}: {len(matches)} found -> {matches[:3]}')
    # Check for template variables (lowercase names in braces)
    var_pattern = r'\{(\w+)\}'
    vars_found = re.findall(var_pattern, content)
    if vars_found:
        unique_vars = sorted(set(vars_found))
        print(f'  template vars {{{var}}}: {unique_vars}')
    print()
