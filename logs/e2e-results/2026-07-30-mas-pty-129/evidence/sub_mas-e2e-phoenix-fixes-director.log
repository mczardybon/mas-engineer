from pathlib import Path
from jinja2 import Template, Environment, meta, BaseLoader
import yaml

recovery_dir = Path('recipe/template/recovery')

print("=== JINJA2 TEMPLATE RENDER TEST ===")
print()

env = Environment(autoescape=False, undefined=__import__('jinja2').StrictUndefined)

errors = 0
for f in sorted(recovery_dir.glob('*.yaml')):
    content = f.read_text()
    try:
        # Try to parse as Jinja2 template
        env.parse(content)
        print("-> %s: Jinja2 parse OK" % f.name)
        
        # Extract undefined variables
        ast = env.parse(content)
        variables = meta.find_undeclared_variables(ast)
        if variables:
            print("   Template variables: %s" % sorted(variables))
        
        # Try rendering with empty context (will fail on undefined vars but not syntax)
        try:
            t = env.from_string(content)
            # Provide minimal context
            context = {v: 'test' for v in variables}
            rendered = t.render(**context)
            print("   Render: OK (%d chars)" % len(rendered))
            # Verify rendered output is valid YAML
            yaml.safe_load(rendered)
            print("   YAML valid after render: OK")
        except Exception as e:
            # Only count as error if it's a syntax issue, not undefined vars
            err_str = str(e)
            if 'undefined' in err_str.lower():
                print("   Render: SKIP (undefined vars expected: %s)" % err_str[:60])
            else:
                print("   Render ERROR: %s" % err_str[:100])
                errors += 1
    except Exception as e:
        print("-> %s: Jinja2 PARSE ERROR: %s" % (f.name, e))
        errors += 1
    print()

print("Total syntax errors: %d" % errors)
