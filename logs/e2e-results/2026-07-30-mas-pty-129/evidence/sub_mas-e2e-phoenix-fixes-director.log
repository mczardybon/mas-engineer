import yaml
with open('/tmp/mas-engineer-test/mas-engineer/.state/workflows.yaml') as f:
    data = yaml.safe_load(f)

# Check task_workflows
print('=== task_workflows keys ===')
tw = data.get('task_workflows', {})
for k in sorted(tw.keys()):
    if 'recovery' in k.lower():
        print(f'  {k}: {tw[k].get(\"desc\", \"no desc\")}')
        
print()
print('=== recovery sub_agents ===')
recovery_agents = data.get('configs', {}).get('mas-self', {}).get('sub_agents', {}).get('recovery', [])
for a in recovery_agents:
    if 'recovery' in a:
        print(f'  {a}')

print()
print('=== recovery dispatch ===')
recovery = data.get('configs', {}).get('mas-self', {}).get('enforcement', {}).get('recovery', {}).get('5_leveln', {})
for level, cfg in recovery.items():
    print(f'  {level}:')
    print(f'    command: {cfg.get(\"befehl\", \"N/A\")}')
    print(f'    workflow: {cfg.get(\"workflow\", \"N/A\")}')
    print(f'    sub_agent: {cfg.get(\"sub_agent\", \"N/A\")}')
"



