from pathlib import Path
import re

recovery_dir = Path('recipe/template/recovery')

# Collect all template variables across all files
all_vars = set()
vars_by_file = {}
for f in sorted(recovery_dir.glob('*.yaml')):
    content = f.read_text()
    brace_vars = re.findall(r'\{(\w+)\}', content)
    vars_by_file[f.name] = sorted(set(brace_vars))
    all_vars.update(brace_vars)

print('All unique template variables used:')
for v in sorted(all_vars):
    files_using = [fname for fname, vars_list in vars_by_file.items() if v in vars_list]
    print(f'  {{{v}}} — used in: {files_using}')

print()
print('Definitions per file:')
for fname, vars_list in vars_by_file.items():
    print(f'  {fname}: {{{', {'.join(vars_list)}}}')
