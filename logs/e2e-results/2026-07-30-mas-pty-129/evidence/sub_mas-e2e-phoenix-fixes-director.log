from pathlib import Path
import re

recovery_dir = Path('recipe/template/recovery')

print("=== JINJA2 / GO TEMPLATE SYNTAX CHECK ===")
print()

for f in sorted(recovery_dir.glob('*.yaml')):
    content = f.read_text()
    issues = []
    
    # Check for Jinja2 syntax
    # {{ ... }} - variable
    jinja_vars = re.findall(r'\{\{.*?\}\}', content, re.DOTALL)
    # {% ... %} - block
    jinja_blocks = re.findall(r'\{%[-+]?.*?%\}', content, re.DOTALL)
    # {# ... #} - comment
    jinja_comments = re.findall(r'\{#.*?#\}', content, re.DOTALL)
    
    if jinja_vars:
        issues.append(f"Jinja2 variables: {jinja_vars}")
    if jinja_blocks:
        issues.append(f"Jinja2 blocks: {jinja_blocks}")
    if jinja_comments:
        issues.append(f"Jinja2 comments: {jinja_comments}")
    
    if issues:
        print(f"✓ {f.name} — has Jinja2/Go template syntax:")
        for issue in issues:
            print(f"    {issue}")
    else:
        print(f"✓ {f.name} — no Jinja2 or Go template syntax (uses {var} brace convention)")
    print()

print("=== VARIABLE DEFINITION CONSISTENCY ===")
print()
# Check that common variables like {workspace} are used consistently
print("Key observation: All 5 templates use {workspace} variable")
print("Template variables use simple brace convention ({var}), not Jinja2 {{ }} or Go {{ }}")
print("This is a custom template variable system suitable for shell/string substitution")
