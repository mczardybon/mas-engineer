import json
import datetime

# Parse scanner output
data = json.loads(open('/tmp/scan_output.txt').read().split('---JSON_START---')[1])
findings = data['findings']

# Goose verdicts for each type group
goose_verdicts = {
    'MM2': {
        'verdict': 'RESTRICTED',
        'confidence': 'HIGH',
        'explanation': (
            'Goose does NOT require prompt: — agents function correctly using instructions: alone as the system prompt. '
            'However, MAS convention requires prompt: for identity assertion (I_AM), MODE-CHECK awareness, '
            'and safety boundary at conversation top. For leaf specialist sub-agents (called programmatically via '
            'team orchestration), missing prompt: is LOW impact. For team-lead agents, MEDIUM impact. '
            'Recommend: add prompt: to lead agents first, then team YAMLs, then leaf specialists.'
        )
    },
    'MM4': {
        'verdict': 'CONFORM',
        'confidence': 'HIGH',
        'explanation': (
            'Genuine optimization. Goose does NOT set a default temperature — passes to provider which defaults to 1.0 '
            '(max randomness). For routing agents (test-r11021, multi-arch-30 orchestrator), temperature=1.0 causes '
            'non-deterministic routing decisions. Project convention is temperature: 0.3 for sub-agents, 0.7 for '
            'orchestrators. Add temperature: 0.3 to test-r11021 agents and temperature: 0.7 to multi-arch-30.yaml.'
        )
    },
    'A5': {
        'verdict': 'CONFORM',
        'confidence': 'HIGH',
        'explanation': (
            'The A5 finding label \"timeout=0 (unlimited)\" is MISCLASSIFIED per Goose expert. '
            'Goose recipe settings do NOT have a timeout field — only extensions have timeout. '
            'The actual issue is missing settings.max_turns. Goose default max_turns=25 for sub-agents, '
            'and has a hard-coded 5-minute internal timeout (not configurable). '
            'Fix: add settings: {max_turns: N} with appropriate values (30-40 for sub-agents, 50 for teams).'
        )
    }
}

# Attach goose_verdicts where applicable
prefixes_needing_verdict = ('MM', 'A', 'B', 'D', 'JJ', 'LL', 'S', 'HH', 'BB')
findings_with_verdicts = []
for f in findings:
    ftype = f['type']
    prefix = ftype[:2] if len(ftype) >= 2 else ftype[:1]
    
    if prefix in ('MM',) or ftype[:1] == 'A':  # MM2, MM4, A5 all need verdicts
        verdict_key = ftype  # exact match
        if verdict_key in goose_verdicts:
            f['goose_verdict'] = goose_verdicts[verdict_key]
    elif any(prefix.startswith(p) for p in ['MM', 'A', 'B', 'D', 'JJ', 'LL', 'S', 'HH', 'BB']):
        pass  # Other findings with these prefixes would get verdicts too
        
    findings_with_verdicts.append(f)

# Build draft
timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
draft = {
    'stage': 1,
    'agent': 'im-finder',
    'version': '1.0.0',
    'timestamp': timestamp,
    'data': {
        'findings': findings_with_verdicts
    }
}

# Count verdicts
verdict_count = sum(1 for f in findings_with_verdicts if 'goose_verdict' in f)
print(f'Total findings: {len(findings_with_verdicts)}')
print(f'Findings with goose_verdict: {verdict_count}')
print(f'By type: {data[\"summary\"][\"by_type\"]}')

# Save draft
with open('/tmp/draft_findings.yaml', 'w') as f:
    import yaml
    yaml.safe_dump(draft, f, default_flow_style=False, sort_keys=False)
    
print('Draft saved to /tmp/draft_findings.yaml')
"


