    command: cd /tmp/mas-engineer-test/mas-engineer && echo "=== CHECK SUB_RECIPE RESOLUTION ===" && python3 -c "
import yaml, os
from pathlib import Path

repo = Path('.')
ok = 0
fail = 0
missing = []

# Check all YAML files with sub_recipes
for p in sorted(repo.rglob('*.yaml')):
    if '.backup' in p.name or '.llm-backup' in p.name:
        continue
    try:
        data = yaml.safe_load(p.read_text())
    except:
        continue
    if not isinstance(data, dict):
        continue
    subs = data.get('sub_recipes', [])
    if not subs:
        continue
    parent = p.parent
    for s in subs:
        if not isinstance(s, dict):
            continue
        path = s.get('path', '')
        if not path:
            continue
        if path.startswith('./'):
            target = (parent / path[2:]).resolve()
        else:
            target = (parent / path).resolve()
        if not target.exists():
            missing.append(f'{p.name} -> {s.get(\"name\",\"?\")} -> {path} (not found)')
            fail += 1
        else:
            ok += 1

print(f'Sub-recipe paths resolved: {ok} OK, {fail} FAIL')
if missing:
    for m in missing:
        print(f'  MISSING: {m}')
"


