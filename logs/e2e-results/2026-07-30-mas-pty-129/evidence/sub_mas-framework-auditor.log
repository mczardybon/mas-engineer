import yaml
from pathlib import Path

repo = Path('.')

for p in sorted(repo.rglob('*.yaml')):
    if '.backup' in p.name or '.llm-backup' in p.name:
        continue
    try:
        data = yaml.safe_load(p.read_text())
    except:
        continue
    if not isinstance(data, dict):
        continue
    subs = data.get('sub_recipes', [])
    if not subs:
        continue
    for s in subs:
        if isinstance(s, dict):
            path = s.get('path', '')
            if path and 'sub_mas-' in path:
                parent_dir = p.parent
                target = (parent_dir / path).resolve()
                exists = target.exists()
                print(f'  {p.relative_to(repo)} -> {s.get(\"name\",\"?\")}: {path} -> {\"OK\" if exists else \"BROKEN\"}')
" 2>&1

