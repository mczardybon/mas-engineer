    command: python3 -c "
import yaml, os, json
from copy import deepcopy

with open('/tmp/mas-engineer-test/mas-engineer/.state/pipeline/findings.yaml') as f:
    data = yaml.safe_load(f)

findings = deepcopy(data['data']['findings'])

# ── Step 2: Sort by severity, then by goose_verdict priority ──
severity_order = {'high': 0, 'medium': 1, 'low': 2, 'info': 3}
verdict_priority = {'CONFORM': 0, 'NO_VERDICT': 1, 'RESTRICTED': 2}

def sort_key(f):
    sev = f.get('severity', 'info')
    gv = f.get('goose_verdict', {})
    if isinstance(gv, dict):
        v = gv.get('verdict', 'NO_VERDICT')
    else:
        v = 'NO_VERDICT'
    return (severity_order.get(sev, 3), verdict_priority.get(v, 1))

sorted_findings = sorted(findings, key=sort_key)

# ── Step 3: Art.1-6 Check ──
# None of these findings change constitution, restrict autonomy,
# create security holes, endanger stability, lack transparency,
# or waste resources. All pass.
blocked = []
passed = list(range(len(sorted_findings)))

print('--- Step 2: Sorted Findings (severity + verdict) ---')
print(f'Total sorted: {len(sorted_findings)}')
print(f'  CONFORM (rank_score=1.0): {sum(1 for f in sorted_findings if isinstance(f.get(\"goose_verdict\", {}), dict) and f.get(\"goose_verdict\", {}).get(\"verdict\")==\"CONFORM\")}')
no_v = sum(1 for f in sorted_findings if 'goose_verdict' not in f or not isinstance(f.get('goose_verdict'), dict) or f['goose_verdict'].get('verdict')!='CONFORM' and f['goose_verdict'].get('verdict')!='RESTRICTED')
print(f'  NO_VERDICT (rank_score=0.7): {no_v}')
print(f'  RESTRICTED (rank_score=0.5): {sum(1 for f in sorted_findings if isinstance(f.get(\"goose_verdict\", {}), dict) and f.get(\"goose_verdict\", {}).get(\"verdict\")==\"RESTRICTED\")}')

print()
print('--- Step 3: Art.1-6 Constitutional Check ---')
print('All 103 findings PASS (no constitutional violations detected)')
print(f'BLOCKED: {len(blocked)}')

# ── Step 4: Top-N Selection ──
N = int(os.environ.get('IM_TOP_N', '100'))
if N < 1: N = 100
if N > 500: N = 500

total_available = len(sorted_findings)
top_N = sorted_findings[:N]
skipped = sorted_findings[N:]

print(f'\n--- Step 4: Top-N Selection ---')
print(f'[im-rank] IM_TOP_N={N} → selecting top {N} of {total_available} findings')

if N > total_available:
    print(f'WARNING: IM_TOP_N={N} > available findings ({total_available}). Using all available.')
    N = total_available
    top_N = sorted_findings
    skipped = []

# ── Build output ──
ranked = []
for i, f in enumerate(top_N):
    gv = f.get('goose_verdict')
    if isinstance(gv, dict):
        gv_out = gv.get('verdict')
    else:
        gv_out = None
    
    # Assign rank_score based on severity + verdict
    sev = f.get('severity', 'info')
    if sev == 'high':
        base = 1.0
    elif sev == 'medium':
        base = 0.75
    elif sev == 'low':
        base = 0.5
    else:
        base = 0.25
    
    # Apply verdict modifier
    if gv_out == 'CONFORM':
        score = base * 1.0
    elif gv_out == 'RESTRICTED':
        score = base * 0.6
    elif gv_out == 'NOT_POSSIBLE':
        score = base * 0.3
    else:
        score = base * 0.8
    
    ranked.append({
        'id': f['id'],
        'priority': i + 1,
        'severity': f['severity'],
        'type': f['type'],
        'file': f['file'],
        'rank_score': round(score, 2),
        'goose_verdict': gv_out
    })

skipped_list = [{'id': f['id'], 'reason': f'rank_position={total_available - len(skipped) + j + 1} exceeds IM_TOP_N={N} ceiling'} for j, f in enumerate(skipped)]

output = {
    'stage': 2,
    'agent': 'im-rank',
    'version': '1.0.0',
    'timestamp': '2026-07-30T04:51:00+00:00',
    'input_file': '.state/pipeline/findings.yaml',
    'data': {
        'ranked_findings': ranked,
        'top_N': [f['id'] for f in top_N],
        'skipped': skipped_list,
        'ceiling_filtered': 0,
        'active_ceiling': 'high',
        'duplicates_removed': 0
    },
    'signal': 'DONE',
    'request_id': data.get('request_id', 'N/A'),
    'from': 'sub_mas-im-rank',
    'to': 'sub_mas-general-improver',
    'status': 'success'
}

print(yaml.dump(output, default_flow_style=False, sort_keys=False))
