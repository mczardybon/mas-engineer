  wf_web_search:
    desc: Web-Recherche throughexecuten
    steps:
    - id: fetch
      action: shell
      cmd: 'echo ''Rechercheree: {inputs.topics} (focus={inputs.focus})'''
      timeout: 5
    - id: results
      action: shell
      cmd: echo 'Recherche completed — resultse follow'
      timeout: 5
  wf_team_package:
    desc: Package a team as standalone goose-installable directory
    tier: balanced
    on_error: abort
    steps:
    - id: validate_inputs
      action: shell
      cmd: test -f "{inputs.root_recipe}" && echo "Root recipe exists" || echo "Root
        recipe missing"
      timeout: 5
    - id: create_package_structure
      action: shell
      cmd: mkdir -p "{inputs.output_path}/{inputs.team_name}/recipe/sub" "{inputs.output_path}/{inputs.team_name}/.state/knowledge"
        && echo "Package structure created"
      timeout: 5
    - id: copy_agents
      action: shell
      cmd: cp "{inputs.root_recipe}" "{inputs.output_path}/{inputs.team_name}/recipe/"
        && mkdir -p "{inputs.output_path}/{inputs.team_name}/recipe/sub" && for f
        in $(echo "{inputs.sub_recipes_csv}" | tr ',' ' '); do cp "$f" "{inputs.output_path}/{inputs.team_name}/recipe/sub/"
        2>/dev/null || true; done && echo "Agents copied"
      timeout: 10
    - id: generate_root_recipe
      action: delegate
      agent: sub_mas-team-packager
      task: GENERATE_ROOT_RECIPE
      params:
        team_name: '{inputs.team_name}'
        output_path: '{inputs.output_path}'
      depends_on:
      - create_package_structure
    - id: generate_sot
      action: delegate
      agent: sub_mas-team-packager
      task: GENERATE_SOT
      params:
        team_name: '{inputs.team_name}'
        sub_recipes: '{inputs.sub_recipes}'
        output_path: '{inputs.output_path}'
      depends_on:
      - copy_agents
    - id: generate_knowledge
      action: delegate
      agent: sub_mas-team-packager
      task: GENERATE_KNOWLEDGE
      params:
        team_name: '{inputs.team_name}'
        output_path: '{inputs.output_path}'
      depends_on:
      - create_package_structure
    - id: generate_install_scripts
      action: delegate
      agent: sub_mas-team-packager
      task: GENERATE_INSTALL
      params:
        team_name: '{inputs.team_name}'
        output_path: '{inputs.output_path}'
      depends_on:
      - create_package_structure
    - id: validate_package
      action: shell
      cmd: test -f "{inputs.output_path}/{inputs.team_name}/install.sh" && test -f
        "{inputs.output_path}/{inputs.team_name}/recipe/{inputs.team_name}-root.yaml"
        && echo "Package valid" || echo "Package incomplete"
      timeout: 5
      depends_on:
      - generate_root_recipe
      - generate_sot
      - generate_knowledge
      - generate_install_scripts
  wf_team_validate:
    desc: Validate an existing team package
    tier: balanced
    on_error: abort
    steps:
    - id: check_structure
      action: shell
      cmd: test -d "{inputs.package_path}" && test -f "{inputs.package_path}/install.sh"
        && test -f "{inputs.package_path}/README.md" && echo "Structure valid" ||
        echo "Structure invalid"
      timeout: 5
    - id: check_yaml
      action: shell
      cmd: python3 -c "import yaml; import glob; [yaml.safe_load(open(f)) for f in
        glob.glob('{inputs.package_path}/recipe/**/*.yaml', recursive=True)]" && echo
        "YAML valid" || echo "YAML invalid"
      timeout: 10
      depends_on:
      - check_structure
    - id: check_no_mas_deps
      action: shell
      cmd: '! grep -rE "sub_mas-master-constitution|general-improver|\.state/knowledge/(01|02|03|04|05|06|07|08|09)"
        "{inputs.package_path}/recipe/" 2>/dev/null && echo "No MAS-Engineer deps"
        || echo "Has MAS-Engineer deps"'
      timeout: 5
      depends_on:
      - check_yaml
workflows:
  build-test:
    desc: Build + extract ZIP + check contents
    params:
      VERSION:
        type: string
        default: 1.0.0
    steps:
    - id: preflight
      action: rule_check
      action_type: build
      call: python3 tools/dev_rule_checker.py --all --action build
      on_error: abort
    - id: build
      action: shell
      cmd: bash tools/dev_build.sh --full
      depends_on:
      - preflight
      timeout: 120
    - id: extract
      action: shell
      cmd: 'ZIP=$(ls -t dist/*.zip | head -1); rm -rf /tmp/wf_build_test; unzip -q
        "$ZIP" -d /tmp/wf_build_test; echo "OK: $(find /tmp/wf_build_test -type f
        | wc -l) file"'
      depends_on:
      - build
    - id: validate
      action: shell
      cmd: 'cd /tmp/wf_build_test && echo "YAMLs: $(find . -name ''*.yaml'' | wc -l)"
        && [ -f installr.sh ] && echo ''installr.sh: OK'' || echo ''installr.sh: FEHLT''
        && [ -f .mas-mode ] && echo ''.mas-mode: OK'' || echo ''.mas-mode: FEHLT''
        && [ -f mas-engineer/recipe/dev-mas-engineer.yaml ] && echo ''main-recipe:
        OK'' || echo ''main-recipe: FEHLT'''
      depends_on:
      - extract
    - id: cleanup
      action: shell
      cmd: rm -rf /tmp/wf_build_test
      depends_on:
      - validate
  si-analyse:
    desc: General-Improver full analysis + report
    steps:
    - id: checkpoint
      action: shell
      cmd: mkdir -p .state/checkpoints/si_$(date +%Y%m%d_%H%M%S)
    - id: scan_recipe
      action: shell
      cmd: python3 ~/.config/goose/recipe/mas-engineer-tools/dev_agent_doctor.py --all
        2>&1 | tail -30
      timeout: 120
    - id: scan_tools
      action: shell
      cmd: 'echo ''Tools-Check: max_steps, hardcodierte Pathe'''
      depends_on:
      - checkpoint
    - id: report
      action: shell
      cmd: echo 'SI $(date)' >> .state/todo.md
      depends_on:
      - scan_recipe
      - scan_tools
  knowledge-refresh:
    desc: List all 8 knowledge files and validate currency
    steps:
    - id: check_file
      action: shell
      cmd: 'for f in .state/knowledge/*.md; do [ -f "$f" ] && echo "OK: $(basename
        $f) ($(wc -c < $f) bytit)" || echo "FEHLT: $f"; done'hardness: 5
rules:
- block: true
  check: python3 tools/dev_rule_checker.py --check R01 --action {aktion}
  hardness: 5
  id: R01
  name: CONFIRMATION_REQUIRED
  prompt_text: CONFIRMATION before write/edit — Show plan + WAIT for ✅
  text: ⛔⛔⛔⛔⛔ CONFIRMATION before write/edit — Show plan + WAIT for ✅
- block: true
  check: null
  hardness: 5
  id: R02
  name: INVENTORY_CHECK
  prompt_text: INVENTORY before new build — exists already? User ask
  text: ⛔⛔⛔⛔⛔ INVENTORY before new build — exists already? User ask
- block: true
  check: python3 tools/dev_rule_checker.py --check R04 --action {aktion}
  hardness: 5
  id: R04
  name: GENERAL_IMPROVER_PROTECTION
  prompt_text: NEVER edit general-improver.yaml (no recursion)
  text: ⛔⛔⛔⛔⛔ NEVER edit general-improver.yaml
- block: true
  check: python3 tools/dev_rule_checker.py --check R09 --action {aktion}
  hardness: 5
  id: R09
  name: MODE_DOMAIN_COUPLING
  prompt_text: MODE-DOMAIN-COUPLING — Mode determines domain. Imports forbidden.
  text: ⛔⛔⛔⛔⛔ MODE-DOMAIN-COUPLING — Mode determines domain
- block: true
  check: python3 tools/dev_rule_checker.py --check R05 --action {aktion}
  hardness: 5
  id: R05
  name: AUTO_COMMIT
  prompt_text: AUTO-COMMIT after write/edit — git commsg + changes.json + checkpoint
  text: ⛔⛔⛔⛔⛔ AUTO-COMMIT after Change — git+checkpoint+changes
- block: false
  check: python3 tools/dev_rule_checker.py --check R06 --action {aktion}
  hardness: 4
  id: R06
  name: SUB_AGENT_CONTAINMENT
  prompt_text: Sub-Agent delegate = ONLY analysis. Execute shell yourself.
  text: ⛔⛔⛔ SUB-AGENT-CONTAINMENT — Sub-Agent = ONLY analysis
- block: false
  check: python3 tools/dev_rule_checker.py --check R07 --action {aktion}
  hardness: 2
  id: R07
  name: SIGNAL_CP_DONE
  prompt_text: CP_DONE after Checkpoint — else WARNING
  text: ⛔ SIGNAL_CP_DONE after Checkpoint
- block: false
  check: python3 tools/dev_rule_checker.py --check R08 --action {aktion}
  hardness: 2
  id: R08
  name: TOKEN_BUDGET
  prompt_text: SI-RUN max 50K Tokens — else User ask
  text: ⛔ TOKEN-BUDGET — Self-Improver max 50K
- block: true
  check: python3 tools/dev_rule_checker.py --check R10 --action {aktion}
  hardness: 5
  id: R10
  name: CORONASHIELD
  prompt_text: CORONASHIELD — Every YAML must be validated via sub_mas-recovery-immune CHECK_YAML before saving
  text: ⛔⛔⛔⛔⛔ CORONASHIELD — Every YAML must be validated via sub_mas-recovery-immune CHECK_YAML before saving
- block: true
  check: python3 tools/dev_rule_checker.py --check R55 --action {aktion}
  hardness: 5
  id: R55
  name: IM_TOP_N_ENFORCEMENT
  prompt_text: IM_TOP_N code-enforced top-N (env var, default 100, max 500) at im-rank step
  text: ⛔⛔⛔⛔⛔ IM_TOP_N code-enforced top-N selection — R57 user-correction 2026-07-25

- block: true
  check: python3 tools/dev_rule_checker.py --check R56 --action {aktion}
  hardness: 5
  id: R56
  name: EDIT_SPIN_LOOP
  prompt_text: NO placeholder edits — every edit call must use the EXACT existing text as 'before' (read first if unsure). 3+ edits in a row with non-matching before/after text = spin-loop = BLOCKED.
  text: ⛔⛔⛔⛔⛔ NO placeholder edits — read file first, then edit with EXACT text match. 3+ failures = BLOCKED.
