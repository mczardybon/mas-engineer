    command: cat /tmp/mas-engineer-test/mas-engineer/.state/rules/rules_5_extreme.yaml

    - id: conceive
      action: shell
      cmd: 'cd {workspace} && echo ''CONCEIVE: {name} ({emoji})'''
    - id: design
      action: shell
      cmd: 'cd {workspace} && echo ''DESIGN: sub_{project}-{name}.yaml'''
      depends_on:
      - conceive
    - id: workflows
      action: shell
      cmd: 'cd {workspace} && echo ''WORKFLOWS: {name} Tasks'''
      depends_on:
      - design
    - id: sot
      action: shell
      cmd: 'cd {workspace} && echo ''SOT: agents+sub_agents+sub_recipe'''
      depends_on:
      - workflows
    - id: knowledge
      action: shell
      cmd: 'cd {workspace} && echo ''KNOWLEDGE: 07-agents.md + 06-tools.md'''
      depends_on:
