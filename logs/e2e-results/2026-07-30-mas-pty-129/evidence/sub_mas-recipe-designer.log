agent_schema:
  required:
  - name
  - type
  - task
  optional:
  - desc
  - emoji
  - domain
  - template
  - large_file
  restrictions:
    allowed_paths: []
    forbidden_paths: []
    max_steps: 100
    timeout: 600
    requires_confirmation: true
    requires_coronashield: true
    allowed_actions:
    - shell
    - delegate
    - write
    - edit
    - read
    - signal
    forbidden_actions: []
    allowed_tools: []
    forbidden_tools: []
    allowed_delegates: []
    forbidden_delegates:
    - sub_mas-general-improver
  workflow:
    steps:
    - id: string
      action: shell | delegate | write | edit | signal | rule_check | sub_workflow
      cmd: string
      agent: string
      task: string
      target: string
      depends_on:
      - string
      on_error: abort | continue | retry(3)
      timeout: int
      condition: string
