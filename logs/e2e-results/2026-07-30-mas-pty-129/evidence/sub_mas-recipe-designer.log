      r12_work_mas_entkopplung:
        level: extreme
        description: NO dependency between work/ and MAS. MAS lives in ~/.config/goose/.state/mas/
        details:
        - MAS-State liegt in ~/.config/goose/.state/mas/ (not in work/.../)
        - work/ can deleted will without MAS zu corrupt
        - BEIM START: Check ob work/ a Project ist — NICHT ob it MAS ist
        - work/ contains NOE MAS-statesfileen (.state/, checkpoints/, .backups/ —
          bis auf .mas-mode)
        - MAS-install.sh und update.sh copy State NACH ~/.config/goose/.state/mas/
      r13_newes_projekt_ignore:
        level: extreme
        description: Newit Project = MAS-Configuration ignore (prompt_1)
        details:
        - 'IF .mas-mode not exists OR work_on = "<project>" (per R14):'
        - → .mas-mode takes precedence over .goosehints heuristic
        - '  → ''This is a new project – ignore the MAS config'''
        - NOE .state/Check, NOE MAS-Specialhandling
        - DELEGATE to sub_mas-generic-init WITHOUT MAS context
        - MAS-internale Commande (/develop, /workflow) bleiben available
      r14_work_on_mode:
        level: extreme
        description: work_on = mas | framework | <project> — hard domain separation
        details:
        - IF work_on == "mas": work/mas/ will wie a normalit Project behandelt
        - IF work_on == "<projekt>": MAS-Components are UNSICHTBAR for Project-Context
        - 'IF work_on == "framework": framework mode — wie <project>, but msg agents
          (Imperver-ready)'
        - 'CHECKED VIA: cat .mas-mode → "mas" | "framework" | "<project>"'
        - NO Access auf MAS-Config/State from dem Project out
        - 'BEI newem Project without .goosehints: R13 greift (generic-init Delegation)'
        - 'MONITORING: Selbe agents in alln Modi — Mode-Detection via .mas-mode (R23)'
      r15_architektur_genehmigung:
        level: extreme
        description: Architecture change requires user approval (dev_architecture_checker.py)
        details:
        - The following changes qualify as "architecture change": null
        - '  → Newen Agent/Tool output (CREATE)'
        - '  → workflows.yaml SOT-rules change (R01-R18)'
        - '  → Constitution change (Typeikel 1-11)'
        - '  → master-constitution.yaml change'
        - '  → dev-mas-engineer.yaml sub_recipe-List change'
        - ON DETECTION: STOP → SHOW user the change → WAIT for ✅
        - IF User ❌: ROLLBACK + DOCUMENT in change.json
        - CHECK VIA: dev_architecture_checker.py --action "{action}" --file "{file}"
      r16_tool_vor_experte:
        level: extreme
        description: Tool → Expert (Sub-agent) → New Agent — IN THIS ORDER
        details:
        - 'BEVOR a Task started will:'
        - '  → 1. Tool? CHECK: tools/dev_*.py — IF ja: shell(tool)'
        - '  → 2. Expert? CHECK: sub_mas-*.yaml msg matchingem task — IF ja: delegate(experte)'
        - '  → 3. Newer Agent? CHECK: intention-parser + architecture_genehmigung
          (R15)'
        - R02 (Inventory vor Newbau) will through R16 ERSETZT
      r17_improvement_push:
        level: stark
        description: Improvements to MAS will be made available to the user via generic-init
          PUSH_IMPROVEMENTS
        details:
        - NACH JEDEM FULL_IMPROVEMENT oder REVIEW: null
        - '  → CHECK: user_workspace = {workspace} (aus Call-parameterssssn, not .mas-mode)'
        - '  → IF user_workspace exists + {workspace}/00-GUIDELINES.md exists + generic-init
          installd:'
        - '    → delegate(sub_mas-generic-init, task=PUSH_IMPROVEMENTS)'
        - '    → Copyre: BP-CHECKLIST.md, template/agent_template.yaml, rulit/rules.yaml'
        - '    → SHOW: ''✅ Improvements available in {user_project}'''
        - '  → IF no user_project: LOG in change.json'
      r18_delegation:
        level: extreme
        description: NEVER do it yourself — delegate to sub-agents (R16 + verschaerft)
        details:
        - 'VOR each shell/write/edit: CHECK ob a Sub-agent exists'
        - 'IF Sub-agent exists: delegate() INSTEAD OF doing it yourself'
        - 'IF no matchinger Sub-agent: CHECK ob Tool exists → shell(tool)'
        - 'IF weder Agent still Tool: NEUEN Agent via intention-parser + R15'
        - 'VIOLATION = BLOCKED + "❌ R18: Sub-agent {name} exists for this task"'
        - 'Exception: Analysis-Steps (cat, grep, ls) — but ONLY to the Orientierung'
      r19_path_hierarchie:
        level: extreme
        description: Hard path separation — ONLY execute installed tools (NEVER source)
        details:
        - MAS_TOOLS_DIR = {paths.mas.tools_install} (ONLY diiter Path for Tool-Execution)
        - SOURCE_TOOLS_DIR = {paths.mas.source_dir}/tools/ (ONLY to the Entwickeln/Bauen
          — NIE execute)
        - 'JEDER Tool-Call: python3 {MAS_TOOLS_DIR}/dev_foo.py'
        - Source-Tools (mas-engineer/tools/) are AUSSCHLIESSLICH for dev_build.sh
          / dev_install.sh
        - 'Beim Start: dev_rule_checker.py --check R19 blocked Source-Tool-Call'
        exceptionn:
        - 'dev_build.sh: MAY Source liten (Bauzweck)'
        - 'dev_install.sh: MAY Source liten (Installationszweck)'
        enforcement:
        - 'vor eachm shell(): Check ob command ''mas-engineer/tools/'' contains →
          BLOCKED msg ''❌ R19: Source-Path! Nutze $MAS_TOOLS_DIR'''
        - 'vor eachm delegate(): Add MAS_TOOLS_DIR als Constante at'
        - dev_rule_checker.py --check R19 checks all Tool-Call
      r20_write_entzug:
        level: extreme
        description: Engineer has write/edit/shell-ENTZUG — delegiert an action-executor
          via gatekeeper
        details:
        - JEDE write/edit/shell → delegate(sub_mas-action-executor, ...)
        - DIREKTE write()/edit()/shell() = CRITICAL → .disziplin_lock → MAS friert
          ein
        - ALL write/edit/shell-Call MUSSEN via dev_gatekeeper.py run
        enforcement:
        - dev_gatekeeper.py checks R20 vor each action
        - pre-commsg blocked at R20-Violationsn
      r21_audit_pflicht:
        level: extreme
        description: JEDE action will in .state/audit.log.jsonl logged (JSON-Linit)
        details:
        - 'Dutyfelder: ts, action, agent, ziel, status, rule'
        - BLOCKED/CRITICAL-entriit block pre-commsg
        - dev_audit.py --status zeigt currentn State
        - dev_audit.py --violations zeigt last Violations
        enforcement:
        - dev_gatekeeper.py writit at JEDER action
      r22_responsibility_matrix:
        level: extreme
        description: RESPONSIBILITY-MATRIX — Jede action has an ritponsibleen Sub-agents
        details:
        - 'QUELLE: .state/rulit/ritponsibility_matrix.yaml'
        - 'VOR each shell/write/edit: Check action_map + file_map in der Matrix'
        - 'IF entry exists: delegate(agent, task=...)'
        - 'IF agent==zero UND in read_exceptions: selbst execute (allowed)'
        - 'IF no entry: BLOCK + "No Sub-agent for diite action"'
        - R18 will through Matrix automatic eingeholdn
        - pre-commsg ruft dev_audit.py --check auf
      r23_monitoring_agnostic:
        level: extreme
        description: monitoring macht NOEN Unterschied between MAS und framework
        details:
        - DETECTED_MODE will via .mas-mode wie at general-improver ermsgtelt
        - 'In MAS mode: target = mas-engineer/ (guardian.yaml in .state/)'
        - 'In framework/Generic mode: target = {workspace} (guardian.yaml im Project-.state/)'
        - Selbe agents (agent-guardian, monitor-*, health-reporter) for all Modi
      _dedup_note:
        level: normal
        description: 'REGEL-QUELLEN: rules_5_extreme.yaml (R01-R10), rules_4_strong.yaml
          (R06), hard_rules.yaml (R01-R10+R18), workflows.yaml (R01-R18). Duplicatee
          will via IDs entdupliziert.'
      verbote:
      - general-improver.yaml edit
      - framework-Components import
      - framework Concepts als MAS-Concepte designate
      - Never aufgive — always Oldrnative search (Retry Leveln 1-4)
      - Always Backup vor Changeen
      - Always YAML validate after Edit
      - Selbst shell/write/edit without previous delegate()-Check (R18)
      verstoesse:
        level: extreme
        description: VERSTOSS = SCHWERER ERROR — ROLLBACK ERZWINGEN
    enforcement:
      method_5_reactiveierung:
        all: 5 steps
        ausexecuten: bash tools/dev_rule_refresh.sh
        step_counter: step_counter
        bei_counter_5: step_counter = 0
      method_6_propagation:
        bei: delegate
        ausexecuten: python3 tools/dev_haerte_propagation.py {agent_name}
        output: in agent_intake.haerte_rulen einaddn
      method_9_ruletest:
        vor: write/edit/shell
        ausexecuten: python3 tools/dev_rule_checker.py --all --action {action}
        bei_exit_0: action freegegive
        bei_exit_1: AKTION BLOCKIERT → User informieren + WARTEN
        confirmation_valid: 5 Minutes ({workspace}/mas-engineer/.state/.last_bestaetigung
          OR {workspace}/.state/.last_bestaetigung)
      method_10_multiprompt:
        nutze: prompt_1 + prompt_2 + prompt_3
      method_1_multiplikator:
        optional: true
        description: 5⛔ = 5× Weight
      method_15_architektur_check:
        vor: write/edit/shell auf ARCHITEKTUR_DATEIEN
        ausexecuten: python3 tools/dev_architecture_checker.py --action "{action}"
          --file "{file}"
        bei_exit_0: No Architecture-Change – freegegive
        bei_exit_1: ARCHITEKTUR-CHANGE ERKANNT → SHOW User → WAIT auf ✅
        note: User must at Architecture-Change explicit zumatch (R15)
      method_18_pre_delegate:
        vor: shell/write/edit
        ausexecuten: python3 tools/dev_rule_checker.py --check R18 --action {action}
        bei_exit_0: No Sub-agent for diiten Task – freegegive
        bei_exit_1: SUB-AGENT AVAILABLE → delegate() instead do it yourself
        description: Checks vor each action ob a matchinger Sub-agent exists (R18)
      session_cleanup:
        bei: JEDER NEUEN SESSION
        ausexecuten: bash tools/dev_session_cleanup.sh --exec
    recovery:
      5_leveln:
        immune:
          befehl: recovery --immune
          workflow: wf_recovery_immune
          sub_agent: sub_mas-recovery-immune
        checkpoint:
          befehl: recovery --checkpoint
