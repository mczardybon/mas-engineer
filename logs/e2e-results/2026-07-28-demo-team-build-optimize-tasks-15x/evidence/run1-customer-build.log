    description: "Provides targeted solution based on category"
  - name: empathic-responder
    path: ./sub/empathic-responder.yaml
    description: "Formats final empathetic customer-facing reply"
parameters:
  - key: MESSAGE
    input_type: string
    requirement: required
    description: "The customer's support message to process"
