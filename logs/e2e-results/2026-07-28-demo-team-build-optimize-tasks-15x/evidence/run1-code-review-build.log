        mas_root = ws_abs
    elif os.path.isdir(os.path.join(ws_abs, 'mas-engineer', 'recipe')):
        # ws is the parent of mas-engineer
        mas_root = os.path.join(ws_abs, 'mas-engineer')
    else:
        mas_root = ws_abs

