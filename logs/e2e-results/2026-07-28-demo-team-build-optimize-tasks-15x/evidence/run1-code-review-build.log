import yaml, os, glob

issues = []
sub_dir = '/tmp/code-reviewer/recipe/sub'

# Check all 6 YAML files
files = ['/tmp/code-reviewer/recipe/code-reviewer.yaml'] + sorted(glob.glob(os.path.join(sub_dir, '*.yaml')))

for f in files:
    name = os.path.basename(f)
    with open(f) as fh:
        content = fh.read()
        try:
            data = yaml.safe_load(content)
        except yaml.YAMLError as e:
            issues.append({'file': name, 'issue': 'YAML parse error', 'detail': str(e)})
            continue
    
    if data is None:
        issues.append({'file': name, 'issue': 'Empty YAML', 'detail': 'File is empty'})
        continue
    
    # Check required fields
    for field in ['name', 'title', 'instructions']:
        if field not in data:
            issues.append({'file': name, 'issue': f'Missing field: {field}', 'detail': ''})
    
    # Check instructions length
    if 'instructions' in data and len(data['instructions']) < 100:
        issues.append({'file': name, 'issue': 'Instructions too short', 'detail': f'{len(data[\"instructions\"])} chars'})
    
    # Check for brittle patterns
    if 'instructions' in data:
        instr = data['instructions']
        if 'I will' in instr or "I'll" in instr:
            issues.append({'file': name, 'issue': 'First-person in instructions', 'detail': 'Use third-person imperative'})
        if 'you should' in instr:
            issues.append({'file': name, 'issue': 'Indirect language', 'detail': 'Replace with direct imperative'})
        if 'TODO' in instr or 'FIXME' in instr:
            issues.append({'file': name, 'issue': 'Unresolved placeholder', 'detail': 'Contains TODO/FIXME'})

    # Check returns section
    if 'returns' in data:
        ret = data['returns']
        if isinstance(ret, dict):
            props = ret.get('properties', {})
            if not isinstance(props, dict) or len(props) == 0:
                issues.append({'file': name, 'issue': 'returns.properties empty', 'detail': ''})

# Check parallel architecture
orchestrator_path = '/tmp/code-reviewer/recipe/code-reviewer.yaml'
with open(orchestrator_path) as f:
    orch = yaml.safe_load(f)
instr = orch.get('instructions', '')
if 'parallel' not in instr.lower():
    issues.append({'file': 'code-reviewer.yaml', 'issue': 'Missing parallel execution semantics', 'detail': 'Instructions should mention parallel dispatch'})

print(f'Issues found before optimization: {len(issues)}')
for i, iss in enumerate(issues):
    print(f'  {i+1}. [{iss[\"file\"]}] {iss[\"issue\"]}: {iss[\"detail\"]}')
