    content: #!/usr/bin/env node
const fs = require('fs'), path = require('path');
const DATA = path.join(__dirname, '..', 'dashboards', 'data.json');
process.stdin.on('data', c => {
  try {
    const m = JSON.parse(c.toString().trim());
    if (m.method === 'initialize') process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:m.id,result:{protocolVersion:'2024-11-05',capabilities:{resources:{}},serverInfo:{name:'code-reviewer-dashboard',version:'1.0.0'}}})+'\n');
    else if (m.method === 'resources/list') process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:m.id,result:{resources:[{uri:'dashboard://data',name:'Dashboard Data',mimeType:'application/json'}]}})+'\n');
    else if (m.method === 'resources/read') { const d = fs.existsSync(DATA)?fs.readFileSync(DATA,'utf8'):'{}'; process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:m.id,result:{contents:[{uri:m.params.uri,mimeType:'application/json',text:d}]}})+'\n'); }
    else process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:m.id,result:{}})+'\n');
  } catch(e) {}
});

