"""Quick audit for Cycle 2 optimization."""
import yaml, glob

files = ['/tmp/code-reviewer/recipe/code-reviewer.yaml'] + sorted(glob.glob('/tmp/code-reviewer/recipe/sub/*.yaml'))
issues = []

for f in files:
    name = f.split('/')[-1]
    with open(f) as fh:
        try:
            d = yaml.safe_load(fh)
        except Exception as e:
            issues.append(f'{name}: YAML error - {e}')
            continue
        if not d:
            issues.append(f'{name}: empty')
            continue
        for field in ['name', 'title', 'instructions', 'settings', 'extensions', 'returns']:
            if field not in d:
                issues.append(f'{name}: missing {field}')
        instr = d.get('instructions', '')
        if '```json' not in instr:
            issues.append(f'{name}: no JSON output example')
        if 'parallel' not in str(d.get('instructions', '')).lower() and 'orchestrator' in name.lower():
            issues.append(f'{name}: no parallel mention')

print(f'Issues: {len(issues)}')
for i in issues:
    print(f'  {i}')
print()
print(f'Delta: 0 -> {len(issues)} issues remaining (already optimized from Cycle 1)')


