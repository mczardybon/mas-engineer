    content: #!/usr/bin/env python3
"""Deep audit of YAML recipes for code-reviewer."""
import yaml, os, glob

sub_dir = '/tmp/code-reviewer/recipe/sub'
files = ['/tmp/code-reviewer/recipe/code-reviewer.yaml'] + sorted(glob.glob(os.path.join(sub_dir, '*.yaml')))
issues = []

for f in files:
    name = os.path.basename(f)
    with open(f) as fh:
        data = yaml.safe_load(fh)
    
    # Check all agent files have returns section
    if 'returns' not in data:
        issues.append({'file': name, 'issue': 'Missing returns section', 'severity': 'medium'})
    
    # Check instructions mention JSON output format
    if 'instructions' in data:
        instr = data['instructions']
        if '```json' not in instr:
            issues.append({'file': name, 'issue': 'Instructions lack JSON output format example', 'severity': 'low'})
        if 'severity' not in instr.lower():
            issues.append({'file': name, 'issue': 'Instructions lack severity classification', 'severity': 'medium'})
    
    # Check settings block
    if 'settings' not in data:
        issues.append({'file': name, 'issue': 'Missing settings block (timeout, max_steps)', 'severity': 'low'})
    
    # Check extensions
    if 'extensions' not in data:
        issues.append({'file': name, 'issue': 'Missing extensions declaration', 'severity': 'low'})

# Check orchestrator specifically
with open('/tmp/code-reviewer/recipe/code-reviewer.yaml') as f:
    orch = yaml.safe_load(f)

if 'recipe_type' not in orch:
    issues.append({'file': 'code-reviewer.yaml', 'issue': 'Missing recipe_type field', 'severity': 'low'})
if 'sub_agents' not in orch:
    issues.append({'file': 'code-reviewer.yaml', 'issue': 'Missing sub_agents list', 'severity': 'medium'})
if 'parallel_groups' not in orch:
    issues.append({'file': 'code-reviewer.yaml', 'issue': 'Missing parallel_groups configuration', 'severity': 'high'})
else:
    for g in orch['parallel_groups']:
        if 'depends_on' not in g and g['name'] != 'reviewers':
            issues.append({'file': 'code-reviewer.yaml', 'issue': 'parallel_groups entry "' + g['name'] + '" missing depends_on', 'severity': 'high'})

