import json
from datetime import datetime

# Create routing test entries
tests = [
    {'id': 'routing-01', 'task': 'Review this Python file for bugs', 'expected_team': 'code-review-team', 'expected_arch': 'HIERARCHICAL'},
    {'id': 'routing-02', 'task': 'Check this code for SQL injection', 'expected_team': 'security-scan-team', 'expected_arch': 'FLAT'},
    {'id': 'routing-03', 'task': 'Analyze this CSV for missing values', 'expected_team': 'data-quality-team', 'expected_arch': 'PIPELINE'},
    {'id': 'routing-04', 'task': 'Profile this function runtime', 'expected_team': 'perf-eval-team', 'expected_arch': 'HIERARCHICAL'},
    {'id': 'routing-05', 'task': 'Simplify this 200-line function', 'expected_team': 'refactor-team', 'expected_arch': 'FLAT'},
    {'id': 'routing-06', 'task': 'Generate docs for this module', 'expected_team': 'doc-gen-team', 'expected_arch': 'PIPELINE'},
]

# Routing logic (matching the master orchestrator's rules)
def route_task(task):
    task_lower = task.lower()
    if any(kw in task_lower for kw in ['review', 'bug', 'bugs', 'correctness', 'style', 'readability']):
        return 'code-review-team', 'HIERARCHICAL'
    elif any(kw in task_lower for kw in ['security', 'vulnerability', 'injection', 'sqli', 'xss']):
        return 'security-scan-team', 'FLAT'
    elif any(kw in task_lower for kw in ['data quality', 'csv', 'missing values', 'data profile', 'dataset']):
        return 'data-quality-team', 'PIPELINE'
    elif any(kw in task_lower for kw in ['performance', 'profiling', 'runtime', 'cpu', 'memory']):
        return 'perf-eval-team', 'HIERARCHICAL'
    elif any(kw in task_lower for kw in ['refactor', 'simplify', 'restructure', 'clean up']):
        return 'refactor-team', 'FLAT'
    elif any(kw in task_lower for kw in ['documentation', 'doc', 'generate docs', 'api doc']):
        return 'doc-gen-team', 'PIPELINE'
    return 'unknown', 'unknown'

results = []
all_pass = True
for t in tests:
    actual_team, actual_arch = route_task(t['task'])
    team_pass = actual_team == t['expected_team']
    arch_pass = actual_arch == t['expected_arch']
    passed = team_pass and arch_pass
    if not passed:
        all_pass = False
    result = {
        'id': t['id'],
        'task': t['task'],
        'expected_team': t['expected_team'],
        'expected_arch': t['expected_arch'],
        'actual_team': actual_team,
        'actual_arch': actual_arch,
        'team_match': team_pass,
        'arch_match': arch_pass,
        'passed': passed,
        'timestamp': datetime.utcnow().isoformat()
    }
    results.append(result)
    status = '✅' if passed else '❌'
    print(f'{status} {t[\"id\"]}: \"{t[\"task\"]}\" → {actual_team} ({actual_arch})')

# Write results
with open('/tmp/multi-arch-30/.state/routing-test.jsonl', 'w') as f:
    for r in results:
        f.write(json.dumps(r) + '\n')

print(f'\\nOverall: {\"✅ ALL PASS\" if all_pass else \"❌ SOME FAILED\"}')
print(f'Results written to /tmp/multi-arch-30/.state/routing-test.jsonl')
