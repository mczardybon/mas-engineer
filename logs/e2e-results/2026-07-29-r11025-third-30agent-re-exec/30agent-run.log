import yaml, glob, sys

files = sorted(glob.glob('/tmp/multi-arch-30/recipe/**/*.yaml', recursive=True))
print(f'Found {len(files)} YAML files to parse')
errors = []
parsed = []
for f in files:
    try:
        with open(f) as fh:
            data = yaml.safe_load(fh)
        if data is None:
            errors.append(f'{f}: empty file')
        else:
            parsed.append(f)
    except yaml.YAMLError as e:
        errors.append(f'{f}: {e}')
    except Exception as e:
        errors.append(f'{f}: {e}')

print(f'Parsed OK: {len(parsed)} / {len(files)}')
if errors:
    print(f'ERRORS ({len(errors)}):')
    for e in errors:
        print(f'  ❌ {e}')
else:
    print('✅ All files parse successfully!')

# Show all files
print()
print('=== All parsed files ===')
for f in parsed:
    print(f'  ✅ {f}')
