    command: # Count total errors by type across all agents (last 7 days)
sqlite3 ~/.local/share/goose/sessions/sessions.db "
SELECT 
  CASE 
    WHEN content_json LIKE '%not found%' AND content_json NOT LIKE '%unsupported%' THEN 'source_not_found'
    WHEN content_json LIKE '%unsupported image%' THEN 'unsupported_image_format'
    WHEN content_json LIKE '%goose_expert_check%' OR content_json LIKE '%usage:%dev_goose%' THEN 'goose_expert_check_usage_error'
    WHEN content_json LIKE '%REGEL-CHECK%CONFIRMATION_REQUIRED%' THEN 'rule_checker_confirmation_blocked'
    WHEN content_json LIKE '%REGEL-CHECK%unbekannt%' THEN 'rule_checker_unknown_action'
    WHEN content_json LIKE '%timeout%' OR content_json LIKE '%timed out%' THEN 'timeout'
    WHEN content_json LIKE '%concurrent%' OR content_json LIKE '%busy%' OR content_json LIKE '%cannot start%' THEN 'concurrency/parallelism'
    WHEN content_json LIKE '%syntax%' OR content_json LIKE '%invalid yaml%' OR content_json LIKE '%parse%' THEN 'syntax_error'
    WHEN content_json LIKE '%maximum%' OR content_json LIKE '%exceeded%' OR content_json LIKE '%limit%' THEN 'limit_exceeded'
    WHEN content_json LIKE '%permission%' OR content_json LIKE '%denied%' OR content_json LIKE '%not allowed%' THEN 'permission_denied'
    WHEN content_json LIKE '%is not a file%' OR content_json LIKE '%no such file%' OR content_json LIKE '%does not exist%' THEN 'file_not_found'
    WHEN content_json LIKE '%image file%' AND content_json LIKE '%No such file%' THEN 'image_file_not_found'
    WHEN content_json LIKE '%exit code%' OR content_json LIKE '%exited with code%' THEN 'command_exit_error'
    WHEN content_json LIKE '%not installed%' OR content_json LIKE '%command not found%' THEN 'tool_not_installed'
    ELSE 'other'
  END as error_class,
  count(*) as total
FROM messages m
JOIN sessions s ON m.session_id = s.id
WHERE m.created_timestamp > strftime('%s', 'now', '-7 days')
  AND m.role = 'user'
  AND m.content_json LIKE '%toolResponse%'
  AND m.content_json LIKE '%isError\":true%'
GROUP BY error_class
ORDER BY total DESC;
"

