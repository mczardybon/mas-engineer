    command: # Categorize SELF-AUDITOR error types
sqlite3 ~/.local/share/goose/sessions/sessions.db "
SELECT 
  CASE 
    WHEN content_json LIKE '%not found%' THEN 'source_not_found'
    WHEN content_json LIKE '%permission%' OR content_json LIKE '%denied%' THEN 'permission_denied'
    WHEN content_json LIKE '%timeout%' OR content_json LIKE '%timed out%' THEN 'timeout'
    WHEN content_json LIKE '%syntax%' OR content_json LIKE '%parse%' THEN 'parse_error'
    WHEN content_json LIKE '%not installed%' OR content_json LIKE '%not found%' THEN 'tool_not_found'
    ELSE 'other'
  END as error_category,
  count(*) as cnt
FROM messages m
JOIN sessions s ON m.session_id = s.id
WHERE m.created_timestamp > strftime('%s', 'now', '-7 days')
  AND m.role = 'user'
  AND m.content_json LIKE '%toolResponse%'
  AND m.content_json LIKE '%isError\":true%'
  AND s.name LIKE '%SELF-AUDITOR%'
GROUP BY error_category
ORDER BY cnt DESC;
"

