  ▸ shell
    command: # For each top agent, categorize their error types
for agent in "goose-expert" "GENERAL-IMPROVER" "im-finder" "yaml-editor" "im-validator" "PRE-PUSH-VALIDATOR" "im-designer" "SELF-AUDITOR" "im-rank" "im-session-reader" "DEV-MAS-ENGINEER"; do
  echo ""
  echo "=== $agent ==="
  sqlite3 ~/.local/share/goose/sessions/sessions.db "
  SELECT 
    CASE 
      WHEN content_json LIKE '%not found%' OR content_json LIKE '%not exist%' THEN 'source_not_found'
      WHEN content_json LIKE '%timeout%' OR content_json LIKE '%timed out%' THEN 'timeout'
      WHEN content_json LIKE '%permission%' OR content_json LIKE '%denied%' OR content_json LIKE '%not allowed%' THEN 'permission_denied'
      WHEN content_json LIKE '%syntax error%' OR content_json LIKE '%invalid%' THEN 'syntax_error'
      WHEN content_json LIKE '%maximum%' OR content_json LIKE '%exceeded%' OR content_json LIKE '%limit%' THEN 'limit_exceeded'
      WHEN content_json LIKE '%concurrent%' OR content_json LIKE '%busy%' OR content_json LIKE '%lock%' THEN 'concurrency'
      WHEN content_json LIKE '%no such%' THEN 'not_found'
      ELSE 'other'
    END as error_type,
    count(*) as cnt
  FROM messages m
  JOIN sessions s ON m.session_id = s.id
  WHERE m.created_timestamp > strftime('%s', 'now', '-7 days')
    AND m.role = 'user'
    AND m.content_json LIKE '%toolResponse%'
    AND m.content_json LIKE '%isError\":true%'
    AND (
      (s.name LIKE '%${agent}%') OR
      ('${agent}' = 'sub_agent (unnamed)' AND s.session_type = 'sub_agent' AND s.name = 'Delegated task') OR
      ('${agent}' = 'user_session' AND s.session_type = 'user')
    )
  GROUP BY error_type
  ORDER BY cnt DESC;
  "
done
