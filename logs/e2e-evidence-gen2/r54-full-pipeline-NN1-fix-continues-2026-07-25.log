    command: # Classify all agent types and their error patterns
sqlite3 ~/.local/share/goose/sessions/sessions.db "
SELECT 
  CASE 
    WHEN s.name LIKE '%SELF-AUDITOR%' THEN 'SELF-AUDITOR'
    WHEN s.name LIKE '%GENERAL-IMPROVER%' THEN 'GENERAL-IMPROVER'
    WHEN s.name LIKE '%PRE-PUSH%' THEN 'PRE-PUSH-VALIDATOR'
    WHEN s.name LIKE '%DEV-MAS-ENGINEER%' THEN 'DEV-MAS-ENGINEER'
    WHEN s.name LIKE '%im-finder%' THEN 'im-finder'
    WHEN s.name LIKE '%im-validator%' THEN 'im-validator'
    WHEN s.name LIKE '%im-designer%' THEN 'im-designer'
    WHEN s.name LIKE '%im-rank%' THEN 'im-rank'
    WHEN s.name LIKE '%yaml-editor%' THEN 'yaml-editor'
    WHEN s.name LIKE '%im-session%' THEN 'im-session-reader'
    WHEN s.name LIKE '%goose-expert%' OR s.name LIKE '%GOOSE-EXPERT%' THEN 'goose-expert'
    WHEN s.session_type = 'sub_agent' THEN 'sub_agent (unnamed)'
    WHEN s.session_type = 'user' THEN 'user_session'
    ELSE 'other'
  END as agent_group,
  count(*) as total_errors,
  count(DISTINCT m.session_id) as sessions_affected
FROM messages m
JOIN sessions s ON m.session_id = s.id
WHERE m.created_timestamp > strftime('%s', 'now', '-7 days')
  AND m.role = 'user'
  AND m.content_json LIKE '%toolResponse%'
  AND m.content_json LIKE '%isError\":true%'
GROUP BY agent_group
ORDER BY total_errors DESC;
