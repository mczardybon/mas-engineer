import yaml
import json
from collections import defaultdict

with open('.state/pipeline/findings.yaml') as f:
    data = yaml.safe_load(f)

findings = data['data']['findings']
request_id = data.get('request_id', 'unknown')
N = len(findings)
print(f"Total findings input: {N}")

# === STEP 1: Remove duplicates ===
# Group by (type + file + detail)
seen = set()
deduped = []
dupes = 0
for f in findings:
    key = (f.get('type',''), f.get('file',''), f.get('issue',''))
    if key in seen:
        dupes += 1
    else:
        seen.add(key)
        deduped.append(f)

print(f"Duplicates removed: {dupes}")
print(f"Unique findings: {len(deduped)}")

# === STEP 1.5: Apply severity ceiling ===
# Default = "high" (no filtering)
ceiling_order = ["high", "medium", "low", "info"]
active_ceiling = "high"  # default
ceiling_idx = ceiling_order.index(active_ceiling)

filtered = []
ceiling_filtered = 0
for f in deduped:
    sev = f.get('severity', 'info')
    try:
        finding_idx = ceiling_order.index(sev)
    except ValueError:
        finding_idx = ceiling_order.index('info')  # treat unknown as info
    if finding_idx < ceiling_idx:
        ceiling_filtered += 1
    else:
        filtered.append(f)

print(f"\nSeverity ceiling: {active_ceiling}")
print(f"Filtered by ceiling: {ceiling_filtered}")
print(f"Remaining after ceiling: {len(filtered)}")

# === STEP 2: Sort by severity ===
severity_rank = {"high": 0, "medium": 1, "low": 2, "info": 3}

def sort_key(f):
    sev = f.get('severity', 'info')
    base_rank = severity_rank.get(sev, 4)
    # NOT_POSSIBLE deprioritization (none exist here)
    gv = f.get('goose_verdict')
    if gv and gv.get('verdict') == 'NOT_POSSIBLE':
        base_rank += 1  # deprioritize by 1
    # Within same severity, keep original order (stable sort)
    return (base_rank, f.get('id', ''))

sorted_findings = sorted(filtered, key=sort_key)

# Print medium vs low counts
med_count = sum(1 for f in sorted_findings if f.get('severity') == 'medium')
low_count = sum(1 for f in sorted_findings if f.get('severity') == 'low')
print(f"\nMedium findings: {med_count}")
print(f"Low findings: {low_count}")

# === STEP 3: ART.1-6 CHECK ===
# Determine blocked findings based on type and issue heuristics
blocked = []
for f in sorted_findings:
    f_type = f.get('type', '')
    issue = f.get('issue', '').lower()
    blocked_reason = None
    
    # Art.1 (Sovereignty): Changes the Constitution?
    if any(kw in issue for kw in ['constitution', 'master_constitution', 'verfassung']):
        blocked_reason = 'Art.1 (Sovereignty)'
    
    # Art.2 (Autonomy): Restricts System-Autonomy?
    if any(kw in issue for kw in ['autonomy', 'restrict', 'limit agent', 'remove tool']):
        blocked_reason = 'Art.2 (Autonomy)'
    
    # Art.3 (Security): Security holes?
    if any(kw in issue for kw in ['security', 'injection', 'secret', 'vulnerability']):
        blocked_reason = 'Art.3 (Security)'
    
    # Art.4 (Stability): Endangers Stability?
    if any(kw in issue for kw in ['crash', 'stability', 'deadlock', 'infinite loop']):
        blocked_reason = 'Art.4 (Stability)'
    
    # Art.5: Always OK
    
    # Art.6 (Cost-efficiency): Wastes resources?
    if any(kw in issue for kw in ['waste', 'expensive', 'costly', 'overhead']):
        blocked_reason = 'Art.6 (Cost-efficiency)'
    
    if blocked_reason:
        blocked.append((f['id'], blocked_reason))

print(f"\nBlocked findings (Art.1-6): {len(blocked)}")
for bid, reason in blocked:
    print(f"  {bid}: {reason}")

# === STEP 4: Compute rank_score and select TOP-5 ===
# Rank score formula: based on severity, goose verdict, type priority
type_priority = {
    'E1': 0,    # Error/Exception patterns
    'NN1': 1,   # Multi-role agent
    'NN3': 2,   # Other NN issues
    'F4': 2,    # Structural issues
    'F3': 3,    # Functional issues
    'B2': 4,    # Goose-Restricted
    'B3': 4,    # Goose-Restricted
    'BB1': 4,   # Goose-Conform
    'MM8': 4,   # Goose-Conform
    'MM9': 4,   # Goose-Conform
}

goose_weight = {
    'CONFORM': 0.9,      # Conform findings are safer to implement
    'RESTRICTED': 0.6,   # Restricted need caution
    'NOT_POSSIBLE': 0.1, # Not possible = nearly impossible
}

for f in sorted_findings:
    sev = f.get('severity', 'info')
    base = severity_rank.get(sev, 4)
    
    # Goose verdict factor
    gv = f.get('goose_verdict')
    if gv:
        gv_mult = goose_weight.get(gv.get('verdict', ''), 0.5)
    else:
        gv_mult = 0.5  # neutral for no verdict
    
    # Type factor
    tp = f.get('type', '')
    type_factor = 1.0
    if tp in ['E1']:
        type_factor = 1.5
    elif tp in ['NN1', 'NN3']:
        type_factor = 1.3
    
    # Blocked findings get very low score
    blocked_flag = 1.0
    for bid, _ in blocked:
        if bid == f['id']:
            blocked_flag = 0.01
            break
    
    # Compute rank_score (lower is better for sorting)
    # Severity is primary, then goose_verdict, then type
    rank_score = (base * 1000) + ((1 - gv_mult) * 100) + (type_factor * 10)
    rank_score = rank_score * blocked_flag
    
    f['rank_score'] = round(rank_score, 2)

# Also add goose verdict info
for f in sorted_findings:
    gv = f.get('goose_verdict')
    if gv:
        f['goose_verdict_str'] = gv.get('verdict', 'UNKNOWN')
    else:
        f['goose_verdict_str'] = None

# === Extract TOP-5 (non-blocked, highest priority) ===
# Exclude blocked findings from top-5
eligible = [f for f in sorted_findings if not any(b[0] == f['id'] for b in blocked)]
top_5 = eligible[:5]

print(f"\n=== TOP 5 FINDINGS ===")
for i, f in enumerate(top_5, 1):
    gv = f.get('goose_verdict_str', 'none')
    print(f"\n  #{i}: {f['id']} | Severity: {f['severity']} | Type: {f['type']} | Score: {f['rank_score']}")
    print(f"  File: {f['file']}")
    print(f"  Issue: {f.get('issue','')[:100]}")
    print(f"  Goose: {gv}")

# === BUILD OUTPUT ===
ranked_findings_out = []
for f in sorted_findings:
    rf = {
        'id': f['id'],
        'priority': 'high' if f.get('severity') == 'medium' else 'normal',  # medium findings get high priority
        'severity': f.get('severity'),
        'type': f.get('type'),
        'file': f.get('file'),
        'rank_score': f['rank_score'],
        'goose_verdict': f.get('goose_verdict_str'),
        'blocked': any(b[0] == f['id'] for b in blocked)
    }
    ranked_findings_out.append(rf)

top_5_ids = [f['id'] for f in top_5]
skipped = [{'id': bid, 'reason': br} for bid, br in blocked]

output = {
    'signal': 'DONE',
    'request_id': request_id,
    'from': 'sub_mas-im-rank',
    'to': 'sub_mas-general-improver',
    'status': 'success',
    'data': {
        'ranked_findings': ranked_findings_out,
        'top_5': top_5_ids,
        'skipped': skipped,
        'ceiling_filtered': ceiling_filtered,
        'active_ceiling': active_ceiling,
        'summary': {
            'total_input': N,
            'duplicates_removed': dupes,
            'unique_findings': len(deduped),
            'medium_findings': med_count,
            'low_findings': low_count,
            'blocked_count': len(blocked),
            'eligible_count': len(eligible),
            'top_5_selected': len(top_5_ids)
        }
    }
}

print(f"\n\n=== OUTPUT YAML ===")
print(yaml.dump(output, default_flow_style=False, allow_unicode=True, sort_keys=False))

# Also save to file
with open('.state/pipeline/ranked_findings.yaml', 'w') as f:
    yaml.dump(output, f, default_flow_style=False, allow_unicode=True, sort_keys=False)
print("\n✅ Saved to .state/pipeline/ranked_findings.yaml")
