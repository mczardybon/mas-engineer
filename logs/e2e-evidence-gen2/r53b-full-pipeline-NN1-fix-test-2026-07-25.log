import json, yaml, datetime

with open('/tmp/scan_output.txt') as f:
    content = f.read()
start = content.find('---JSON_START---')
json_str = content[start + len('---JSON_START---'):].strip()
data = json.loads(json_str)
findings = data['findings']

# Goose knowledge-based verdicts by type (from goose-docs in sub_mas-goose-expert.md)
VERDICT_MAP = {
    'MM8': {  # prompt > 30 chars but no I_AM identity
        'verdict': 'CONFORM',
        'confidence': 'HIGH',
        'explanation': 'I_AM identity is a MAS convention for agent role clarity. Goose supports any prompt content. Adding I_AM improves readability without violating Goose rules. Source: docs/lessons-learned.md L01-L03.'
    },
    'MM9': {  # has I_AM but no MODE-CHECK
        'verdict': 'CONFORM',
        'confidence': 'HIGH',
        'explanation': 'MODE-CHECK is a MAS convention for domain awareness. Goose has no MODE-CHECK requirement. The pattern is fully compatible with Goose prompts. Source: Goose recipe YAML spec.'
    },
    'B2': {  # prompt > 300 chars
        'verdict': 'RESTRICTED',
        'confidence': 'HIGH',
        'explanation': 'Goose has no hard 300-char limit on prompts. Long prompts (e.g. 2000+ chars) work fine. The 300-char threshold is a MAS style guideline, not a Goose restriction. Only restrict if prompt exceeds Goose\'s practical context window (~128K tokens).'
    },
    'B3': {  # prompt missing context-info
        'verdict': 'RESTRICTED',
        'confidence': 'MEDIUM',
        'explanation': 'Goose provides .goosehints (~/.config/goose/.goosehints global, <project>/.goosehints project) and persistent_instructions.md for context delivery. Explicit \"context-info\" in prompt is a MAS convention supplement, not a Goose requirement.'
    },
    'BB1': {  # missing ⛔ prohibition list
        'verdict': 'CONFORM',
        'confidence': 'HIGH',
        'explanation': 'The ⛔ prohibition markers are a MAS convention for boundary clarity. Goose has no requirement for or against special Unicode markers in prompts. Adversary mode (~/.config/goose/adversary.md) provides native Goose security boundaries. ⛔ markers are complementary.'
    }
}

# Apply verdicts to findings
goose_types = {'MM8', 'MM9', 'B2', 'B3', 'BB1'}
applied = 0
failed = 0
for f in findings:
    t = f.get('type')
    if t in goose_types:
        verdict = VERDICT_MAP.get(t)
        if verdict:
            f['goose_verdict'] = verdict
            applied += 1
        else:
            f['goose_verdict'] = {'verdict': 'NOT_POSSIBLE', 'confidence': 'LOW', 'explanation': 'summon failed - no verdict template for this type'}
            failed += 1

print(f'Applied verdicts: {applied} findings')
print(f'Failed (fallback): {failed} findings')

# Verify all goose-related types have verdicts
remaining = [f['id'] for f in findings if f.get('type') in goose_types and 'goose_verdict' not in f]
if remaining:
    print(f'WARNING: {len(remaining)} findings still missing verdicts: {remaining[:5]}...')
else:
    print('All goose-type findings have verdicts attached.')
    
# Save draft with verdicts
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
draft = {
    'stage': 1,
    'agent': 'im-finder',
    'timestamp': now,
    'data': {'findings': findings}
}
with open('/tmp/draft_findings_with_verdicts.yaml', 'w') as f:
    yaml.safe_dump(draft, f, default_flow_style=False, sort_keys=False)
print(f'Saved draft with verdicts to /tmp/draft_findings_with_verdicts.yaml')
" 2>&1


