import json
with open('/tmp/scan_output.txt') as f:
    content = f.read()
start = content.find('---JSON_START---')
json_str = content[start + len('---JSON_START---'):].strip()
data = json.loads(json_str)

# Check MM8/MM9 files ARE NOT in template directories
