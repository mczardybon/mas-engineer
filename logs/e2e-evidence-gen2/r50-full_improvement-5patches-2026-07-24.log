import yaml
from collections import Counter

with open('.state/pipeline/findings.yaml') as f:
    data = yaml.safe_load(f)

findings = data.get('data', {}).get('findings', [])
print('=== IM-RANK ANALYSIS REPORT ===')
print()

# ========== STEP 1: Deduplication ==========
print('--- STEP 1: Deduplication ---')
seen = set()
unique = []
dupes = []
for f in findings:
    key = (f.get('type',''), f.get('file',''), f.get('issue',''))
    if key in seen:
        dupes.append(f['id'])
    else:
        seen.add(key)
        unique.append(f)
print(f'  Total input: {len(findings)}')
print(f'  Duplicates removed: {len(dupes)}')
print(f'  Unique findings: {len(unique)}')
print()

# ========== STEP 1.5: Severity Ceiling ==========
print('--- STEP 1.5: Severity Ceiling ---')
ceiling = data.get('severity_ceiling', 'high')
ceiling_order = ['high', 'medium', 'low', 'info']
ceiling_idx = ceiling_order.index(ceiling) if ceiling in ceiling_order else 0
filtered = []
for f in unique:
    sev = f.get('severity', 'info')
    sev_idx = ceiling_order.index(sev) if sev in ceiling_order else 3
    if sev_idx < ceiling_idx:
        filtered.append(f)
remaining = [f for f in unique if f not in filtered]
print(f'  Active ceiling: {ceiling}')
print(f'  Filtered out: {len(filtered)}')
print(f'  Remaining: {len(remaining)}')
if len(filtered) > 0 and len(remaining) == 0:
    print(f'  ⚠️ WARNING: All findings filtered out!')
print()

# ========== STEP 2: Sort by Severity ==========
print('--- STEP 2: Sort by Severity ---')
sev_order = {'high': 0, 'medium': 1, 'low': 2, 'info': 3}

# Deprioritize NOT_POSSIBLE by 1 level
def sort_key(f):
    base = sev_order.get(f.get('severity','info'), 3)
    v = f.get('goose_verdict', {})
    if isinstance(v, dict) and v.get('verdict') == 'NOT_POSSIBLE':
        base += 1  # deprioritize by 1 level
    return base

sorted_remaining = sorted(remaining, key=sort_key)

# Count by severity after sorting
sorted_sev = Counter(f.get('severity','unknown') for f in sorted_remaining)
print(f'  Sorted severity distribution: {dict(sorted_sev)}')
np_count = sum(1 for f in sorted_remaining if isinstance(f.get('goose_verdict'), dict) and f.get('goose_verdict',{}).get('verdict') == 'NOT_POSSIBLE')
print(f'  NOT_POSSIBLE findings: {np_count}')
print()

# ========== STEP 3: Art.1-6 Check ==========
print('--- STEP 3: Art.1-6 Constitution Check ---')
blocked = []
passed = []
for f in sorted_remaining:
    ftype = f.get('type','')
    issue = f.get('issue','').lower()
    blocked_reason = None
    
    # Art.1 (Sovereignty): Changes the Constitution?
    if any(kw in issue for kw in ['constitution', 'art.1', 'sovereignty']) and 'modify' in issue:
        blocked_reason = 'Art.1 (Sovereignty)'
    # Art.2 (Autonomy): Restricts system autonomy?
    elif any(kw in issue for kw in ['restrict autonomy', 'remove autonomy', 'disable']):
        blocked_reason = 'Art.2 (Autonomy)'
    # Art.3 (Security): Security holes?
    elif any(kw in issue for kw in ['security hole', 'vulnerability', 'backdoor']):
        blocked_reason = 'Art.3 (Security)'
    # Art.4 (Stability): Endangers system stability?
    elif any(kw in issue for kw in ['crash', 'instability', 'destabilize']):
        blocked_reason = 'Art.4 (Stability)'
    # Art.6 (Cost-efficiency): Wastes resources?
    elif any(kw in issue for kw in ['waste', 'inefficient', 'excessive resource']):
        blocked_reason = 'Art.6 (Cost-efficiency)'
    
    if blocked_reason:
        blocked.append((f['id'], blocked_reason))
    else:
        passed.append(f)

print(f'  Findings passed Art.1-6: {len(passed)}')
print(f'  Findings BLOCKED: {len(blocked)}')
for bid, reason in blocked[:10]:
    print(f'    ⛔ {bid}: {reason}')
if len(blocked) > 10:
    print(f'    ... and {len(blocked)-10} more')
print()

# ========== STEP 4: Top-5 Selection ==========
print('--- STEP 4: Top-5 Selection ---')
# Assign rank_score based on severity
# medium = 80-100, low = 20-79
import hashlib
def compute_rank_score(f, idx):
    base_scores = {'medium': 90, 'low': 50, 'info': 10}
    base = base_scores.get(f.get('severity','info'), 10)
    # Add a small deterministic offset for consistent ordering
    h = int(hashlib.md5(f['id'].encode()).hexdigest()[:4], 16) % 20
    return base + (h - 10)  # range around base

ranked = []
for i, f in enumerate(passed):
    f['rank_score'] = compute_rank_score(f, i)
    ranked.append(f)

# Sort by rank_score descending
ranked.sort(key=lambda f: f['rank_score'], reverse=True)

top5 = ranked[:5]
print(f'  Top-5 Findings:')
for r in top5:
    gv = r.get('goose_verdict', {})
    gv_str = f' [{gv.get(\"verdict\",\"N/A\")}/{gv.get(\"confidence\",\"N/A\")}]' if gv else ''
    print(f'    {r[\"id\"]} | type={r[\"type\"]} | sev={r[\"severity\"]} | score={r[\"rank_score\"]} | file={r[\"file\"][:55]}')
print()

# ========== Summary Statistics ==========
print('--- SUMMARY ---')
print(f'  Total findings ingested: {len(findings)}')
print(f'  After dedup: {len(unique)}')
print(f'  After severity ceiling: {len(remaining)}')
print(f'  Blocked by Constitution: {len(blocked)}')
print(f'  Available for design: {len(passed)}')
print(f'  Top-5 selected: {len(top5)}')
print(f'  Rank scores range: {ranked[-1][\"rank_score\"] if ranked else \"N/A\"} - {ranked[0][\"rank_score\"] if ranked else \"N/A\"}')
