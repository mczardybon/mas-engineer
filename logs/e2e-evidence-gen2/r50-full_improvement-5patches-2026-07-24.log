after_ceiling = []
for f in unique:
    sev = f.get('severity', 'info')
    try:
        fi = ceiling_order.index(sev)
    except ValueError:
        fi = 3
    if fi >= ceiling_idx:
        after_ceiling.append(f)

ceiling_filtered = len(unique) - len(after_ceiling)

# ── STEP 2: SORT ──
def sort_key(f):
    sev = f.get('severity', 'info')
    base = ceiling_order.index(sev)
    if f.get('goose_verdict', {}).get('verdict') == 'NOT_POSSIBLE':
        base += 1
    return (base, f['type'], f['id'])

sorted_f = sorted(after_ceiling, key=sort_key)

# Assign rank_score
n = len(sorted_f)
for i, f in enumerate(sorted_f):
