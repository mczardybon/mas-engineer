d.setdefault('history', []).append({'round': len(d.get('history', [])) + 1, 'time': 'now', 'findings_count': {findings_count}, 'duration_sec': {duration}})

with open('{workspace}/.state/schedule.yaml', 'w') as f:
  yaml.dump(d, f)
"

