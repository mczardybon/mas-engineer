        'explanation': 'Goose does not require context-info in prompts. Adding context improves clarity but is a MAS convention, not a Goose requirement.'
    },
    'BB1': {  # missing ⛔ prohibition list
        'verdict': 'CONFORM',
        'confidence': 'HIGH',
        'explanation': 'Goose supports ⛔ prohibition markers in prompts and instructions. This is a MAS convention for agent safety boundaries.'
    },
    'MM8': {  # prompt > 30 chars but no I_AM identity
