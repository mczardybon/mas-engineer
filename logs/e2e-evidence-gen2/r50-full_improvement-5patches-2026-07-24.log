import yaml
from datetime import datetime, timezone

with open('.state/pipeline/findings.yaml') as f:
    input_data = yaml.safe_load(f)

findings = input_data.get('data', {}).get('findings', [])
total_before = len(findings)
print(f'Total findings loaded: {total_before}')

# ── STEP 1: REMOVE DUPLICATES ──
# Group by (type + file + issue)
seen = {}
duplicates_removed = 0
unique_findings = []
for f in findings:
    key = (f['type'], f['file'], f['issue'])
    if key in seen:
        duplicates_removed += 1
        continue
    seen[key] = True
    unique_findings.append(f)

print(f'After dedup: {len(unique_findings)} (removed {duplicates_removed})')

# ── STEP 1.5: APPLY SEVERITY CEILING ──
severity_ceiling = 'medium'
ceiling_order = ['high', 'medium', 'low', 'info']
ceiling_idx = ceiling_order.index(severity_ceiling)

filtered_out = []
ceiling_filtered_findings = []
for f in unique_findings:
    sev = f.get('severity', 'info')
    try:
        finding_idx = ceiling_order.index(sev)
    except ValueError:
        finding_idx = 3  # treat unknown as 'info'
    
    if finding_idx < ceiling_idx:
        filtered_out.append(f)
    else:
        ceiling_filtered_findings.append(f)

ceiling_filtered_count = len(filtered_out)
print(f'After ceiling (severity_ceiling={severity_ceiling}): {len(ceiling_filtered_findings)} (filtered {ceiling_filtered_count})')

# ── STEP 2: SORT BY SEVERITY ──
# Modifier: if goose_verdict.verdict == 'NOT_POSSIBLE', deprioritize by 1 level
def severity_score(f):
    sev = f.get('severity', 'info')
    return ceiling_order.index(sev)

# Check for NOT_POSSIBLE verdicts
not_possible = [f for f in ceiling_filtered_findings if f.get('goose_verdict', {}).get('verdict') == 'NOT_POSSIBLE']
print(f'NOT_POSSIBLE verdicts: {len(not_possible)}')

# Sort: primary key = severity, secondary = type for stability
# For rank_score: medium=2, low=1, info=0 (higher = better)
# NOT_POSSIBLE gets -1 modifier
sorted_findings = sorted(ceiling_filtered_findings, 
    key=lambda f: (
        -severity_score(f) if f.get('goose_verdict', {}).get('verdict') != 'NOT_POSSIBLE' 
        else -(severity_score(f) - 1),  # deprioritize by 1 level
        f['type'],
        f['id']
    ))

# Assign rank_score
for i, f in enumerate(sorted_findings):
    base = 100 - i
    if f.get('goose_verdict', {}).get('verdict') == 'NOT_POSSIBLE':
        f['rank_score'] = base - 50  # significant deprioritization
    else:
        f['rank_score'] = base

# ── STEP 3: ART.1-6 CHECK ──
skipped = []
for f in sorted_findings[:]:  # iterate over copy since we might modify
    issue_lower = f.get('issue', '').lower()
    # Check against known blocking patterns
    reasons = []
    if 'constitution' in issue_lower or 'art.1' in issue_lower or 'sovereignty' in issue_lower:
        reasons.append('Art.1 (Sovereignty): Changes the Constitution')
    if 'autonomy' in issue_lower or 'art.2' in issue_lower:
        reasons.append('Art.2 (Autonomy): Restricts System-Autonomy')
    if 'security' in issue_lower or 'security hole' in issue_lower or 'art.3' in issue_lower:
        reasons.append('Art.3 (Security): Generates Security holes')
    if 'stability' in issue_lower or 'art.4' in issue_lower:
        reasons.append('Art.4 (Stability): Endangers System-Stability')
    if 'cost' in issue_lower or 'waste' in issue_lower or 'art.6' in issue_lower:
        reasons.append('Art.6 (Cost-efficiency): Wastes resources')
    
    if reasons:
        skipped.append({'id': f['id'], 'reason': '; '.join(reasons)})
        sorted_findings.remove(f)

# Active findings after all checks
active_findings = sorted_findings
print(f'After Art.1-6 check: {len(active_findings)} (skipped {len(skipped)})')

# ── STEP 4: TOP-5 SELECTION ──
top_5 = active_findings[:5]
