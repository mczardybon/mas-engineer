import yaml
from datetime import datetime, timezone

with open('.state/pipeline/findings.yaml') as f:
    input_data = yaml.safe_load(f)

findings = input_data.get('data', {}).get('findings', [])
total_before = len(findings)

# ── STEP 1: REMOVE DUPLICATES (type + file + issue) ──
seen = {}
duplicates_removed = 0
unique_findings = []
for f in findings:
    key = (f['type'], f['file'], f['issue'])
    if key in seen:
        duplicates_removed += 1
        continue
    seen[key] = True
    unique_findings.append(f)

# ── STEP 1.5: SEVERITY CEILING ──
severity_ceiling = 'medium'
ceiling_order = ['high', 'medium', 'low', 'info']
ceiling_idx = ceiling_order.index(severity_ceiling)

filtered_out = []
ceiling_filtered = []
for f in unique_findings:
    sev = f.get('severity', 'info')
    try:
        finding_idx = ceiling_order.index(sev)
    except ValueError:
        finding_idx = 3
    if finding_idx < ceiling_idx:
        filtered_out.append(f)
    else:
        ceiling_filtered.append(f)

ceiling_filtered_count = len(filtered_out)

# ── STEP 2: SORT BY SEVERITY (medium first, then low) ──
# severity_score: high=0, medium=1, low=2, info=3
# ascending sort → medium (1) < low (2) → medium FIRST ✓
# NOT_POSSIBLE deprioritizes: shift score by +1 (one level lower)
def sort_key(f):
    sev = f.get('severity', 'info')
    base = ceiling_order.index(sev)  # 0=high..3=info
    # NOT_POSSIBLE → deprioritize by 1 level
    if f.get('goose_verdict', {}).get('verdict') == 'NOT_POSSIBLE':
        base += 1  # shift down
    return (base, f['type'], f['id'])

sorted_findings = sorted(ceiling_filtered, key=sort_key)

# Assign rank_score (higher = more priority)
max_score = 1000.0
for i, f in enumerate(sorted_findings):
    f['rank_score'] = max_score - (i * (max_score / max(1, len(sorted_findings))))

# ── STEP 3: ART.1-6 CHECK ──
skipped = []
active = []
for f in sorted_findings:
    issue_lower = f.get('issue', '').lower()
    reasons = []
    
    # Check Art.1-6 violations
    patterns = [
        ('Art.1', ('constitution', 'art.1', 'sovereignty')),
        ('Art.2', ('autonomy', 'art.2')),
        ('Art.3', ('security hole', 'art.3', 'security vulnerability')),
        ('Art.4', ('stability', 'art.4', 'system stability')),
        ('Art.6', ('cost', 'waste', 'art.6', 'efficiency')),
    ]
    for art, keywords in patterns:
        for kw in keywords:
            if kw in issue_lower:
                reasons.append(f'{art} blocked')
                break
    
    if reasons:
        skipped.append({'id': f['id'], 'reason': '; '.join(reasons)})
    else:
        active.append(f)

# ── STEP 4: TOP-5 SELECTION ──
top_5 = active[:5]
top_5_ids = [f['id'] for f in top_5]

print(f'=== RANKING RESULTS ===')
print(f'Total input: {total_before}')
print(f'Dedup removed: {duplicates_removed}')
print(f'Ceiling filtered (severity > medium): {ceiling_filtered_count}')
print(f'Art.1-6 blocked: {len(skipped)}')
print(f'Active for design: {len(active)}')
print()

print(f'=== TOP-5 (by rank) ===')
for f in top_5:
    gv = f.get('goose_verdict', {})
    verdict_str = gv.get('verdict', 'none') if gv else 'none'
    print(f'  {f[\"id\"]:8s} | {f[\"type\"]:4s} | {f[\"severity\"]:7s} | score={f[\"rank_score\"]:6.1f} | {f[\"file\"][:60]} | verdict={verdict_str}')

print()
print(f'=== SKIPPED (Art.1-6) ===')
for s in skipped:
    print(f'  {s[\"id\"]}: {s[\"reason\"]}')

# Check if medium findings made it to top
medium_in_top5 = [f for f in top_5 if f['severity'] == 'medium']
print(f'\nMedium findings in top-5: {len(medium_in_top5)}')
for f in top_5:
    if f['severity'] == 'medium':
        print(f'  {f[\"id\"]} | {f[\"type\"]} | {f[\"file\"]}')
"



