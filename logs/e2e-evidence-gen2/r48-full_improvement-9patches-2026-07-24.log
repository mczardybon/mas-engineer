import json, re, os
from collections import Counter

with open('/tmp/scan_output.txt', 'r') as f:
    content = f.read()
start = content.find('---JSON_START---')
if start >= 0:
    json_str = content[start+14:].strip()
    brace_depth = 0
    start_idx = None
    for i, c in enumerate(json_str):
        if c == '{':
            if brace_depth == 0:
                start_idx = i
            brace_depth += 1
        elif c == '}':
            brace_depth -= 1
            if brace_depth == 0 and start_idx is not None:
                json_str = json_str[start_idx:i+1]
                break
    data = json.loads(json_str)
    findings = data['findings']

# Which types need goose-expert?
GOOSE_PREFIXES = {'MM': 'YAML Structure', 'A': 'Timeout/Steps', 'B': 'Prompt',
                   'D': 'Orchestrator', 'JJ': 'Extensions', 'LL': 'User UX',
                   'S': 'Sub-Agent Coupling', 'HH': 'Hooks', 'BB': 'Boundaries'}

needs_goose = []
no_goose = []

for f in findings:
    ftype = f['type']
    prefix = ''
    for p in sorted(GOOSE_PREFIXES.keys(), key=len, reverse=True):
        if ftype.startswith(p):
            prefix = p
            break
    if prefix:
        needs_goose.append(f)
    else:
        no_goose.append(f)

print(f'=== FINDINGS REQUIRING GOOSE-EXPERT VERDICT ===')
print(f'Total: {len(needs_goose)}')
print()
by_type = Counter(f['type'] for f in needs_goose)
for t, c in sorted(by_type.items()):
    print(f'  {t}: {c}')

print()
print(f'=== FINDINGS NOT REQUIRING GOOSE-EXPERT ===')
print(f'Total: {len(no_goose)}')
by_other = Counter(f['type'] for f in no_goose)
for t, c in sorted(by_other.items()):
    print(f'  {t}: {c}')
" 2>&1

