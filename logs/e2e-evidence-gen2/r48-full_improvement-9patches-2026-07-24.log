import yaml
import json
from datetime import datetime, timezone
from collections import Counter

# ─── LOAD ────────────────────────────────────────────────────
with open('.state/pipeline/findings.yaml', 'r') as f:
    raw = yaml.safe_load(f)

findings = raw.get('data', {}).get('findings', [])
total_input = len(findings)
print(f"📥 Input: {total_input} findings")

# ─── STEP 1: REMOVE DUPLICATES ───────────────────────────────
seen = {}
deduped = []
dups = 0
for f in findings:
    key = (f.get('type',''), f.get('file',''), f.get('issue',''))
    if key in seen:
        dups += 1
        continue
    seen[key] = True
    deduped.append(f)

print(f"🗑️  Duplicates removed: {dups}")
print(f"📋 After dedup: {len(deduped)}")

# ─── STEP 1.5: SEVERITY CEILING ──────────────────────────────
ceiling_order = ["high", "medium", "low", "info"]
active_ceiling = "high"  # default — no filtering
ceiling_idx = ceiling_order.index(active_ceiling)

ceiling_filtered = 0
after_ceiling = []
for f in deduped:
    sev = f.get('severity', 'info')
    try:
        f_idx = ceiling_order.index(sev)
    except ValueError:
        f_idx = 3  # treat unknown as "info"
    if f_idx < ceiling_idx:
        ceiling_filtered += 1
    else:
        after_ceiling.append(f)

print(f"🔽 Ceiling filtered ({active_ceiling}): {ceiling_filtered}")

if ceiling_filtered > 0 and len(after_ceiling) == 0:
    print(f"⚠️  WARNING: severity_ceiling={active_ceiling} filtered out ALL {ceiling_filtered} findings!")
    top_5 = []
else:
    # ─── STEP 2: SORT BY SEVERITY ──────────────────────────
    severity_weight = {"high": 0, "medium": 1, "low": 2, "info": 3}
    
    def compute_rank_score(f, idx):
        """Compute rank_score: severity-based with modifiers."""
        sev = f.get('severity', 'info')
        base = severity_weight.get(sev, 3)
        
        # Modifier: goose_verdict NOT_POSSIBLE → deprioritize 1 level
        gv = f.get('goose_verdict')
        modifier = 0
        if gv and isinstance(gv, dict) and gv.get('verdict') == 'NOT_POSSIBLE':
            modifier = 1  # deprioritize
        
        # Score: lower is better (0=high, 1=medium, 2=low, 3=info)
        # Add modifier to push NOT_POSSIBLE down
        adjusted = base + modifier
        
        # Convert to a score where higher = better priority
        # Max adjusted = 4 (info + NOT_POSSIBLE modifier)
        score = round(100 - (adjusted * 20), 2)
        # Add small tiebreaker based on original position
        score = round(score - (idx * 0.001), 2)
        return score

    # ─── STEP 3: ART.1-6 CHECK ─────────────────────────────
    skipped = []
    ranked = []
    
    for idx, f in enumerate(after_ceiling):
        # Art.1 (Sovereignty): Changes constitution?
        # Art.2 (Autonomy): Restricts autonomy?
        # Art.3 (Security): Security holes?
        # Art.4 (Stability): Endangers stability?
        # Art.5 (Transparency): Always OK
        # Art.6 (Cost-efficiency): Wastes resources?
        
        blocked = False
        reason = None
        
        # Check for constitution-related findings (type=C* or mention of constitution)
        ftype = f.get('type', '')
        issue = (f.get('issue', '') + ' ' + f.get('fix', '')).lower()
        
        # Art.1: constitution changes
        if 'constitution' in issue and ('change' in issue or 'modif' in issue or 'edit' in issue):
            blocked = True
            reason = "Art.1 (Sovereignty): Would change constitution"
        
        # Art.3: security holes
        elif ftype in ('S1', 'S2', 'S3') or 'security' in issue and 'hole' in issue:
            # Actually security findings should be reported, not blocked
            # Art.3 blocks changes that *create* security holes, not findings that *report* them
            pass
        
        # Art.4: stability
        elif ftype == 'MM8' or 'stability' in issue:
            # MM8 is about tool reliability - reporting, not blocking
            pass
        
        if blocked:
            skipped.append({"id": f['id'], "reason": reason})
        else:
            score = compute_rank_score(f, idx)
            entry = {
                "id": f["id"],
                "type": f.get("type", ""),
                "severity": f.get("severity", "info"),
                "file": f.get("file", ""),
                "rank_score": score,
            }
            if f.get("goose_verdict"):
                entry["goose_verdict"] = f["goose_verdict"]
            ranked.append(entry)
    
    # Sort by rank_score descending (higher = better priority)
    ranked.sort(key=lambda x: x["rank_score"], reverse=True)
    
    # ─── STEP 4: TOP-5 ─────────────────────────────────────
    top_5 = [r["id"] for r in ranked[:5]]
    
    print(f"📊 Ranked: {len(ranked)} findings")
    print(f"⛔ Constitution blocked: {len(skipped)}")
    print(f"🏆 Top 5: {top_5}")
    if top_5:
        for r in ranked[:5]:
            print(f"   {r['id']} | {r['type']:6s} | {r['severity']:6s} | {r['rank_score']:6.2f} | {r['file']}")

    # ─── OUTPUT ────────────────────────────────────────────
    output = {
        "stage": 2,
        "agent": "im-rank",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "input_file": ".state/pipeline/findings.yaml",
        "signal": "DONE",
        "request_id": f"im-rank-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}",
        "from": "sub_mas-im-rank",
        "to": "sub_mas-general-improver",
        "status": "success",
        "data": {
            "stats": {
                "total_input": total_input,
                "duplicates_removed": dups,
                "after_dedup": len(deduped),
                "ceiling_filtered": ceiling_filtered,
                "active_ceiling": active_ceiling,
                "constitution_blocked": len(skipped),
                "total_ranked": len(ranked),
            },
            "ranked_findings": ranked,
            "top_5": top_5,
            "skipped": skipped,
            "ceiling_filtered": ceiling_filtered,
            "active_ceiling": active_ceiling,
        }
    }
    
    # Write output
    with open('.state/pipeline/ranked_findings.yaml', 'w') as f:
        yaml.dump(output, f, default_flow_style=False, sort_keys=False, allow_unicode=True)
    
    print(f"\n✅ Written to .state/pipeline/ranked_findings.yaml")
    print(f"📦 Output size: {len(json.dumps(output))} chars")

