### Pattern F — schema versioning (defect #7)
```python
_SCHEMA_VERSION = 1

def _make_msg(topic, payload, *, ...):
    return {
        "schema_version": _SCHEMA_VERSION,   # NEW
        "msg_id": ...,
        "topic": topic,
        ...
    }

def _migrate(msg: dict) -> dict:
    """Migrate older schema versions to current.  No-op for v1."""
    v = msg.get("schema_version", 1)
    if v == _SCHEMA_VERSION:
        return msg
    if v < _SCHEMA_VERSION:
        # Future: v1→v2 migration
        return msg  # no-op for now
    return msg  # unknown future, return as-is
```

### Pattern G — idempotency key LRU (defect #8)
```python
class _IdempotencyIndex:
    """Bounded LRU of (key → msg_id) for fast dedup check.
    Max size: MAS_MQ_IDEMPOTENCY_MAX (default 100k)."""
    def __init__(self, max_size: int = 100_000):
        self.max = max_size
        self._d = {}  # OrderedDict
    def add(self, key: str, msg_id: str) -> None:
        if key in self._d:
            self._d.move_to_end(key)
        self._d[key] = msg_id
        if len(self._d) > self.max:
            self._d.popitem(last=False)
    def get(self, key: str) -> Optional[str]:
        if key in self._d:
            self._d.move_to_end(key)
            return self._d[key]
        return None
```

### Pattern H — prometheus metrics (defect #9)
```python
def metrics_prometheus() -> str:
    """Return Prometheus textfile-format metrics for the MQ."""
    s = stats()
    out = []
    for topic, t in s["topics"].items():
        out.append(f'mq_depth{{topic="{topic}"}} {t.get("depth", 0)}')
        out.append(f'mq_lag_p95_ms{{topic="{topic}"}} {t.get("current_p95_lag_ms", 0)}')
        out.append(f'mq_dlq_count{{topic="{topic}"}} {t.get("dlq_count_for_topic", 0)}')
    out.append(f'mq_dlq_total {s.get("dlq_count_total", 0)}')
    return "\n".join(out) + "\n"
```

### Pattern I — backoff jitter (defect #10)
```python
import random
def _next_retry_delay(base_sec: float, attempt: int) -> float:
    """Full-jitter exponential backoff (AWS architecture blog).
    Returns delay in seconds.  Capped at 300s."""
    expo = base_sec * (2 ** min(attempt, 10))  # cap exponent
    return min(random.uniform(0, expo), 300.0)
```

### Pattern J — list_topics (defect #11)
```python
def list_topics() -> list[str]:
    """Discover all live topics by globbing <root>/*.ndjson."""
    root = _mq_root()
    if not root.exists():
        return []
    out = []
    for p in root.glob("*.ndjson"):
        name = p.name
        if name.endswith(".completed.ndjson"):
            continue
        if name == "_corrupt.ndjson":
            continue
        out.append(name[:-len(".ndjson")])
    return sorted(out)
```

### Pattern K — completed.ndjson compaction (defect #12)
```python
def compact_completed(topic: str, *, max_lines: int = 10000, keep_recent: int = 1000) -> bool:
    """If <topic>.completed.ndjson has > max_lines, archive full
    file to <topic>.<YYYYMMDD>.completed.ndjson, then rewrite the
    live file with only the most recent `keep_recent` lines."""
    p = _topic_path(topic, completed=True)
    if not p.exists():
        return False
    lines = p.read_text().splitlines()
    if len(lines) <= max_lines:
        return False
    # Archive
    today = datetime.now().strftime("%Y%m%d")
    archive = _mq_root() / f"{topic}.{today}.completed.ndjson"
    with open(archive, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write("\n".join(lines) + "\n")
    # Keep only most recent
    recent = lines[-keep_recent:]
    with open(p, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write("\n".join(recent) + "\n")
    return True
```

### Pattern L — error classification (defect #13)
```python
def _classify_error(exc: Exception) -> str:
    """Map exception to short class name for DLQ metadata."""
    cls = exc.__class__.__name__
    # Trim common stdlib suffixes
    for s in ("Error", "Exception"):
        if cls.endswith(s):
            cls = cls[:-len(s)]
    return cls or "Unknown"

# In nack(), set both:
m["last_error"] = str(reason)
m["last_error_class"] = _classify_error(reason) if isinstance(reason, Exception) else "String"
```

### Pattern M — retry_count cap (defect #14)
```python
# In _make_msg:
assert 0 <= retry_count < 1_000_000, f"retry_count out of range: {retry_count}"

# In gc_stale_in_flight / nack, after retry_count += 1:
m["retry_count"] = min(int(m.get("retry_count", 0)) + 1, 2**31 - 1)
```

### Pattern N — disk-full handling (defect #15)
```python
# In enqueue(), wrap write:
try:
    _write_topic_atomic(topic, msgs)
except OSError as e:
    # Disk full / read-only / IO error
    m["status"] = "failed"
    m["last_error"] = f"storage: {e}"
    m["last_error_class"] = "StorageError"
    with open(_dlq_path(), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(m, ensure_ascii=False) + "\n")
    raise
```

