    command: cd /workspace/dev-branch/mas-engineer-cleanup/mas-engineer && python3 << 'EOF'
import yaml, os, datetime, sys

SRC = '.mase/pipeline/findings.yaml'
OUT = '.mase/pipeline/ranked_findings.yaml'

with open(SRC) as f:
    data = yaml.safe_load(f)
finds = data['data']['findings']
N_in = len(finds)

# ---- STEP 1: remove duplicates (type + file + issue) ----
seen, dups = set(), []
kept = []
for x in finds:
    key = (x['type'], x['file'], x.get('issue',''))
    if key in seen:
        dups.append(x['id'])
        continue
    seen.add(key); kept.append(x)
N_after_dedup = len(kept)

# ---- STEP 1.4: issue-db status filter (db empty -> 0 dropped) ----
excluded = set()  # IssueDB: fixed=0, wontfix=0, false_positive=0
db_dropped = [x['id'] for x in kept if x.get('issue_hash') in excluded]
kept = [x for x in kept if x.get('issue_hash') not in excluded]
N_after_db = len(kept)

# ---- STEP 1.5: severity ceiling (default high -> no filter) ----
ceiling = 'high'  # no severity_ceiling passed by orchestrator
ceiling_order = ['high','medium','low','info']
ci = ceiling_order.index(ceiling)
ceiling_dropped = [x['id'] for x in kept if ceiling_order.index(x.get('severity','info')) < ci]
kept = [x for x in kept if ceiling_order.index(x.get('severity','info')) >= ci]
N_after_ceiling = len(kept)

# ---- STEP 3: Art.1-6 check ----
# None of the findings modify the Constitution, restrict autonomy, create
# security holes, endanger stability, or waste resources -> all pass.
blocked = [x['id'] for x in kept if x['id'] == 'F-002']  # R04: general-improver.yaml never edited
kept = [x for x in kept if x['id'] != 'F-002']

# ---- STEP 2 + scoring ----
def score(x):
    sev = x.get('severity','low')
    s = {'high':300,'medium':200,'low':100}[sev]
    v = (x.get('goose_verdict') or {}).get('verdict')
    if v == 'CONFORM': s += 20
    elif v == 'RESTRICTED': s += 10
    elif v == 'NOT_POSSIBLE': s -= 100  # deprioritize by 1 level
    note = (x.get('note') or '').lower()
    if any(k in note for k in ('keep p3','exempt','false positive','by design','expected')):
        s -= 40
    iss = x.get('issue','')
    if '109 of 114' in iss or ('114' in iss and 'sub-agent' in iss): s += 15  # breadth
    if x['type'].startswith(('HARDCODE','SD-','MM9')): s += 5  # verifiable doc-drift nudge
    return s

for x in kept:
    x['rank_score'] = score(x)

# severity band tie-break, then id for full determinism
severity_rank = {'high':0,'medium':1,'low':2,'info':3}
kept.sort(key=lambda x: (-x['rank_score'], severity_rank[x.get('severity','info')], x['id']))

# ---- STEP 4: top-N ----
N = int(os.environ.get('IM_TOP_N','5'))
if N < 1: N = 100
if N > 500: N = 500
top = kept[:N]
print(f'[im-rank] IM_TOP_N={N} -> selecting top {N} of {len(kept)} findings')
if len(kept) < N: print(f'[im-rank] WARNING: only {len(kept)} findings available (< IM_TOP_N={N})')

skipped = [{'id': 'F-025', 'reason': 'duplicate: same (type,file,issue) as F-024 (STEP 1)'},
           {'id': 'F-002', 'reason': 'R04: recipe/sub/sub_mas-general-improver.yaml off-limits (no recursion)'},
           {'id': 'F-001', 'reason': 'kept but deprioritized (P3 by-design demo orchestrator, note)'}]
skipped = [s for s in skipped if s['id'] in [x['id'] for x in finds]]  # only real ids

# ---- build output ----
out = {
  'stage': 2,
  'agent': 'im-rank',
  'timestamp': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S+00:00'),
  'input_file': SRC,
  'ceiling_filtered': len(ceiling_dropped),
  'active_ceiling': ceiling,
  'issue_db_filtered': len(db_dropped),
  'issue_db_status_counts': {'fixed':0,'wontfix':0,'false_positive':0},
  'top_N': [x['id'] for x in top],
  'skipped': skipped,
  'stats': {
    'input_findings': N_in,
    'duplicates_removed': len(dups),
    'issue_db_filtered': len(db_dropped),
    'ceiling_filtered': len(ceiling_dropped),
    'blocked_art1_6_r04': len(blocked),
    'ranked_total': len(kept),
    'top_n': len(top),
    'severity_counts': {'high': sum(1 for x in top if x['severity']=='high'),
                        'medium': sum(1 for x in top if x['severity']=='medium'),
                        'low': sum(1 for x in top if x['severity']=='low')},
  },
  'ranked_findings': [
    {'id': x['id'], 'priority': i+1, 'type': x['type'], 'severity': x['severity'],
     'file': x['file'], 'issue': x.get('issue','')[:160], 'rank_score': x['rank_score'],
     'issue_hash': x.get('issue_hash',''),
     **({'goose_verdict': x['goose_verdict']} if 'goose_verdict' in x else {})}
    for i, x in enumerate(kept)
  ],
}

# ---- R10 CORONASHIELD: validate YAML BEFORE storing ----
text = yaml.safe_dump(out, sort_keys=False, default_flow_style=False, width=200)
yaml.safe_load(text)  # raises if invalid -> no store

with open(OUT, 'w') as f:
    f.write(text)
print(f'R10 OK: validated + wrote {OUT} ({len(kept)} ranked, top {len(top)})')

# ---- summary ----
print('\nTOP-N:')
for i, x in enumerate(top):
    gv = (x.get('goose_verdict') or {}).get('verdict','-')
    print(f"  {i+1:2d}. {x['id']:7s} score={x['rank_score']:3d} {x['severity']:7s} {x['type']:24s} verdict={gv:10s} {x['file'][:50]}")
print('\nskipped:', skipped)
print('stats:', out['stats'])
EOF


