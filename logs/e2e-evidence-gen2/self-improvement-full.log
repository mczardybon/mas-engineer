    input_data = yaml.safe_load(f)

findings = input_data.get('data', {}).get('findings', [])
request_id = input_data.get('input', {}).get('request_id', 'unknown')

print(f"Loaded {len(findings)} findings")
print(f"Request ID: {request_id}")

# STEP 1 — REMOVE DUPLICATES
# Group by (type + file + detail) — detail = issue text
seen = {}
deduped = []
dup_count = 0
for f in findings:
    key = (f.get('type',''), f.get('file',''), f.get('issue',''))
    if key not in seen:
        seen[key] = True
        deduped.append(f)
    else:
        dup_count += 1

print(f"STEP 1: Removed {dup_count} duplicates, {len(deduped)} remaining")

# STEP 1.5 — APPLY SEVERITY CEILING
# Default: "high" means no filter
ceiling_order = ["high", "medium", "low", "info"]
active_ceiling = "high"  # default
ceiling_idx = ceiling_order.index(active_ceiling)

filtered = []
ceiling_filtered = 0
for f in deduped:
    sev = f.get('severity', 'info')
    try:
        finding_idx = ceiling_order.index(sev)
    except ValueError:
        finding_idx = 3  # treat unknown as "info"
    if finding_idx < ceiling_idx:
        ceiling_filtered += 1
    else:
        filtered.append(f)

print(f"STEP 1.5: ceiling={active_ceiling}, filtered out {ceiling_filtered}, {len(filtered)} remaining")

# STEP 2 — SORT BY SEVERITY (with NOT_POSSIBLE deprioritization)
severity_order = {"high": 0, "medium": 1, "low": 2, "info": 3}

def rank_score(finding):
    sev = finding.get('severity', 'info')
    base = severity_order.get(sev, 3)
    # Modifier: NOT_POSSIBLE → deprioritize by 1 level
    gv = finding.get('goose_verdict', {})
    if isinstance(gv, dict) and gv.get('verdict') == 'NOT_POSSIBLE':
        base = min(base + 1, 3)  # cap at info
    # Secondary sort: by id for stability
    fid = finding.get('id', '')
    return (base, fid)

sorted_findings = sorted(filtered, key=rank_score)

# STEP 3 — ART.1-6 CHECK
# Check each finding against constitution
blocked = []
passed = []
for f in sorted_findings:
    issue = f.get('issue', '').lower()
    file_path = f.get('file', '')
    fid = f.get('id', '')
    
    reason = None
    
    # Art.1 (Sovereignty): Changes the Constitution?
    if 'constitution' in issue or 'constitution' in file_path.lower():
        reason = "Art.1 BLOCKED: Changes the Constitution"
    
    # Art.2 (Autonomy): Restricts System-Autonomy?
    if not reason and ('restrict' in issue or 'autonomy' in issue):
        reason = "Art.2 BLOCKED: Restricts System-Autonomy"
    
    # Art.3 (Security): Security holes?
    if not reason and ('security' in issue or 'security hole' in issue):
        reason = "Art.3 BLOCKED: Security hole"
    
    # Art.4 (Stability): Endangers System-Stability?
    if not reason and ('stability' in issue or 'crash' in issue or 'instability' in issue):
        reason = "Art.4 BLOCKED: Endangers System-Stability"
    
    # Art.5 (Transparency): Always OK
    # Art.6 (Cost-efficiency): Wastes resources?
    if not reason and ('waste' in issue or 'resource' in issue and 'inefficient' in issue):
        reason = "Art.6 BLOCKED: Wastes resources"
    
    if reason:
        blocked.append({'id': fid, 'reason': reason})
    else:
        passed.append(f)

print(f"STEP 3: Blocked {len(blocked)} by constitution, {len(passed)} passed")

# STEP 4 — TOP-5 SELECTION
top_5 = passed[:5]
top_5_ids = [f.get('id') for f in top_5]

print(f"STEP 4: Top 5: {top_5_ids}")

# Build ranked_findings output
ranked = []
for f in passed:
    gv = f.get('goose_verdict')
    entry = {
        'id': f.get('id'),
        'type': f.get('type'),
        'severity': f.get('severity'),
        'file': f.get('file'),
        'rank_score': severity_order.get(f.get('severity','info'), 3) * 10,
    }
    if gv:
        entry['goose_verdict'] = gv
    ranked.append(entry)

# Build output
output = {
    'signal': 'DONE',
    'request_id': request_id,
    'from': 'sub_mas-im-rank',
    'to': 'sub_mas-general-improver',
    'status': 'success',
    'data': {
        'ranked_findings': ranked,
        'top_5': top_5_ids,
        'skipped': blocked,
        'ceiling_filtered': ceiling_filtered,
        'active_ceiling': active_ceiling,
        'stats': {
            'total_input': len(findings),
            'duplicates_removed': dup_count,
            'after_dedup': len(deduped),
            'after_ceiling': len(filtered),
            'constitution_blocked': len(blocked),
            'final_ranked': len(ranked)
        }
    }
}

# Write output
output_path = '/workspace/mas-engineer-src/mas-engineer/.state/pipeline/ranked_findings.yaml'
with open(output_path, 'w') as f:
    yaml.dump(output, f, default_flow_style=False, sort_keys=False, allow_unicode=True)

print(f"\nWritten to {output_path}")
print(f"Total ranked: {len(ranked)}")
print(f"Top 5 IDs: {top_5_ids}")
print(f"Blocked: {len(blocked)}")

# Also print the top 5 details
print("\n=== TOP 5 FINDINGS ===")
for f in top_5:
    print(f"  {f.get('id')}: [{f.get('severity')}] {f.get('type')} - {f.get('file')}")
    print(f"    Issue: {f.get('issue')[:80]}")

