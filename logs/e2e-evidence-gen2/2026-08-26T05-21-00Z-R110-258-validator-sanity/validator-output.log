        if re.search(rf"mq\.(enqueue|consume)\(['\"]?{re.escape(topic)}|['\"]?{re.escape(san)}", s): hits += 1
    # (d) dev_mq_consumer call sites
    for f in glob.glob('tools/dev_mq_consumer*.py'):
        s = open(f, encoding='utf-8', errors='replace').read()
        if topic in s or san in s: hits += 1
    if hits == 0:
        print(f"  ❌ BLOCK: Check 21 — topic '{topic}' has a producer but NO consumer-side caller chain")
        fail = 1
        uncovered.append(topic)
    else:
        print(f"  ✅ Check 21: topic '{topic}' has {hits} caller-chain reference(s)")
if fail:
    print(f"     Uncovered topics: {uncovered}")
