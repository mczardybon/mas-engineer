import yaml, os

with open('.state/pipeline/patches.yaml') as f:
    patches_data = yaml.safe_load(f)
patches = patches_data['data']['patches']

# Comprehensive cross-reference check: do all referenced sub-agents exist?
print("=== CROSS-REFERENCE DEPENDENCY CHECK ===")
for i, p in enumerate(patches):
    content = p.get('content', '')
    if not content:
        print(f"Patch {i} ({p['type']} → {p['file']}): No content to check")
        continue
    
    try:
        parsed = yaml.safe_load(content)
        subs = parsed.get('sub_recipes', []) if isinstance(parsed, dict) else []
        if subs:
            print(f"\nPatch {i} ({p['type']} → {p['file']}):")
            for s in subs:
                path = s.get('path', '')
                full_path = f'recipe/sub/{path}'
                exists = os.path.exists(full_path)
                created_by = []
                # Check if any other patch creates this file
                for j, op in enumerate(patches):
                    if op.get('file') == full_path or op.get('file') == path:
                        created_by.append(f"Patch {j} ({op['type']})")
                status = "EXISTS" if exists else "MISSING"
                creator = f" — Created by: {', '.join(created_by)}" if created_by else ""
                print(f"  {s['name']} @ {path}: {status}{creator}")
    except yaml.YAMLError as e:
        print(f"Patch {i}: YAML parse error: {e}")
