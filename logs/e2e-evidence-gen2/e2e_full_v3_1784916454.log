import yaml, json, copy, sys
from datetime import datetime, timezone

with open('/workspace/mas-engineer-src/mas-engineer/.state/pipeline/findings.yaml') as f:
    data = yaml.safe_load(f)

findings = data.get('data', {}).get('findings', [])
print(f'INPUT: {len(findings)} findings loaded')

# ====== STEP 1: REMOVE DUPLICATES ======
# Group by (type + file + issue)
seen = {}
deduped = []
duplicates = []
for f in findings:
    key = (f['type'], f['file'], f.get('issue', ''))
    if key not in seen:
        seen[key] = f
        deduped.append(f)
    else:
        duplicates.append(f['id'])

print(f'STEP 1: {len(duplicates)} duplicates removed, {len(deduped)} remaining')

# ====== STEP 1.5: SEVERITY CEILING ======
active_ceiling = 'high'  # default — no filtering
ceiling_order = ['high', 'medium', 'low', 'info']
ceiling_idx = ceiling_order.index(active_ceiling)

filtered = []
ceiling_filtered = 0
for f in deduped:
    sev = f.get('severity', 'info')
    try:
        f_idx = ceiling_order.index(sev)
    except ValueError:
        f_idx = 3  # treat unknown as 'info'
    if f_idx < ceiling_idx:
        ceiling_filtered += 1
    else:
        filtered.append(f)

print(f'STEP 1.5: ceiling={active_ceiling}, {ceiling_filtered} filtered, {len(filtered)} remaining')

# ====== STEP 2: SORT BY SEVERITY (with NOT_POSSIBLE deprioritization) ======
severity_rank = {'high': 0, 'medium': 1, 'low': 2, 'info': 3}

def rank_key(f):
    sev = f.get('severity', 'info')
    base = severity_rank.get(sev, 3)
    # NOT_POSSIBLE deprioritizes by 1 level (adds 1 to rank)
    gv = f.get('goose_verdict', {})
    if isinstance(gv, dict) and gv.get('verdict') == 'NOT_POSSIBLE':
        base = min(base + 1, 4)  # max penalty
    return base

filtered.sort(key=rank_key)

# ====== STEP 3: ART.1-6 CHECK ======
skipped = []
remaining = []
for f in filtered:
    skip_reason = None
    issue_lower = f.get('issue', '').lower()
    file_lower = f.get('file', '').lower()
    fix_lower = f.get('fix', '').lower()
    
    # Art.1 (Sovereignty): Changes the Constitution?
    if any(w in issue_lower or w in fix_lower for w in ['constitution', 'art.1', 'art1']):
        skip_reason = 'BLOCKED: Art.1 (Sovereignty)'
    # Art.2 (Autonomy): Restricts system autonomy?
    elif any(w in issue_lower or w in fix_lower for w in ['restrict autonomy', 'remove autonomy']):
        skip_reason = 'BLOCKED: Art.2 (Autonomy)'
    # Art.3 (Security): Security holes?
    elif any(w in issue_lower or w in fix_lower for w in ['security hole', 'vulnerability', 'backdoor']):
        skip_reason = 'BLOCKED: Art.3 (Security)'
    # Art.4 (Stability): Endangers stability?
    elif any(w in issue_lower or w in fix_lower for w in ['crash', 'instability', 'infinite loop']):
        skip_reason = 'BLOCKED: Art.4 (Stability)'
    # Art.5 (Transparency): Always OK
    # Art.6 (Cost-efficiency): Wastes resources?
    elif any(w in issue_lower or w in fix_lower for w in ['waste resource', 'unnecessary cost']):
        skip_reason = 'BLOCKED: Art.6 (Cost-efficiency)'
    
    if skip_reason:
        skipped.append({'id': f['id'], 'reason': skip_reason, 'type': f['type'], 'severity': f['severity']})
    else:
        remaining.append(f)

print(f'STEP 3: {len(skipped)} blocked by Constitution, {len(remaining)} pass')

# ====== STEP 4: TOP-5 SELECTION ======
# Assign rank_score based on position
for i, f in enumerate(remaining):
    # rank_score = inverse of position, weighted by severity
    sev = f.get('severity', 'info')
    sev_score = {'high': 100, 'medium': 75, 'low': 50, 'info': 25}.get(sev, 0)
    
    # Penalty for NOT_POSSIBLE
    gv = f.get('goose_verdict', {})
    np_penalty = 30 if isinstance(gv, dict) and gv.get('verdict') == 'NOT_POSSIBLE' else 0
    
    f['rank_score'] = round(sev_score - np_penalty + max(0, (len(remaining) - i) * 0.01), 4)

# Sort by rank_score descending
remaining.sort(key=lambda f: f['rank_score'], reverse=True)

top_5 = remaining[:5]
top_5_ids = [f['id'] for f in top_5]

print(f'STEP 4: Top 5: {top_5_ids}')
for f in top_5:
    print(f'  {f[\"id\"]}: type={f[\"type\"]}, severity={f[\"severity\"]}, score={f[\"rank_score\"]}, file={f[\"file\"]}')

# ====== OUTPUT ======
output = {
    'stage': 2,
    'agent': 'im-rank',
    'timestamp': datetime.now(timezone.utc).isoformat(),
    'input_file': '.state/pipeline/findings.yaml',
    'signal': 'DONE',
    'request_id': 'im-rank-' + datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S'),
    'from': 'sub_mas-im-rank',
    'to': 'sub_mas-general-improver',
    'status': 'success',
    'data': {
        'stats': {
            'total_input': len(findings),
            'duplicates_removed': len(duplicates),
            'after_dedup': len(deduped),
            'ceiling_filtered': ceiling_filtered,
            'active_ceiling': active_ceiling,
            'constitution_blocked': len(skipped),
            'total_ranked': len(remaining)
        },
        'ranked_findings': [{
            'id': f['id'],
            'type': f['type'],
            'severity': f['severity'],
            'file': f['file'],
            'rank_score': f['rank_score'],
            'issue': f.get('issue', ''),
            'impact': f.get('impact', ''),
            'goose_verdict': f.get('goose_verdict') if isinstance(f.get('goose_verdict'), dict) and f['goose_verdict'].get('verdict') == 'NOT_POSSIBLE' else None
        } for f in remaining],
        'top_5': [{
            'id': f['id'],
            'type': f['type'],
            'severity': f['severity'],
            'file': f['file'],
            'rank_score': f['rank_score'],
            'issue': f.get('issue', ''),
            'impact': f.get('impact', ''),
            'fix': f.get('fix', ''),
            'goose_verdict': f.get('goose_verdict') if isinstance(f.get('goose_verdict'), dict) and f['goose_verdict'].get('verdict') == 'NOT_POSSIBLE' else None
        } for f in top_5],
        'skipped': skipped,
        'ceiling_filtered': ceiling_filtered,
        'active_ceiling': active_ceiling
    }
}

# Write output
with open('/workspace/mas-engineer-src/mas-engineer/.state/pipeline/ranked_findings.yaml', 'w') as f:
    yaml.dump(output, f, default_flow_style=False, sort_keys=False, allow_unicode=True)

print(f'\nOUTPUT written to .state/pipeline/ranked_findings.yaml')
print(f'Total ranked: {len(remaining)}, Top 5: {len(top_5)}, Skipped: {len(skipped)}')

# Summary of top 5 details
print(f'\n===== TOP 5 DETAILS =====')
for f in top_5:
    print(f'--- {f[\"id\"]} ---')
    print(f'  Type: {f[\"type\"]}')
    print(f'  Severity: {f[\"severity\"]}')
    print(f'  File: {f[\"file\"]}')
    print(f'  Score: {f[\"rank_score\"]}')
    print(f'  Issue: {f.get(\"issue\", \"\")}')
    print(f'  Impact: {f.get(\"impact\", \"\")}')
