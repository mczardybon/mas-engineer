    command: # Check recent pre-push-validator sessions for blocks
sqlite3 /tmp/sessions_copy.db "
SELECT s.id, s.name, m.role, substr(m.content_json, 1, 300) as snippet
FROM messages m
JOIN sessions s ON s.id = m.session_id
WHERE s.name LIKE '%pre-push%'
  AND m.content_json LIKE '%BLOCK%'
  AND s.updated_at > datetime('now', '-2 days')
ORDER BY m.created_timestamp DESC
LIMIT 5;
"

