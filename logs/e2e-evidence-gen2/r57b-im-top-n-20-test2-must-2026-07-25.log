    command: # Look for error/timeout patterns from user messages (corrections, complaints)
sqlite3 /tmp/sessions_copy.db "
SELECT s.id, s.name, m.role, substr(m.content_json, 1, 200) as snippet
FROM messages m
JOIN sessions s ON s.id = m.session_id
WHERE m.role='user'
  AND (m.content_json LIKE '%block%' 
    OR m.content_json LIKE '%reject%'
    OR m.content_json LIKE '%fail%'
    OR m.content_json LIKE '%timeout%'
    OR m.content_json LIKE '%error%')
  AND s.updated_at > datetime('now', '-3 days')
ORDER BY m.created_timestamp DESC
LIMIT 15;
"


