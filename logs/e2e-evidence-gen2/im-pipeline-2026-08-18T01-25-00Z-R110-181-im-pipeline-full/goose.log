"""im-finder v1.0.0 — build .mase/pipeline/findings.yaml (FIND round ANALYZE-20260818-015300)."""
import json, yaml, datetime

scan = json.load(open('/tmp/scan_findings.json'))['findings']

# ---- Part 1: scanner findings (authoritative source, hash-stable) ----
VERDICT_NOTE = ("Verdict applied per embedded GOOSE-EXPERT rule-areas "
                "(sub_mas-goose-expert.md + orchestrator PRE-FIND RULE-AREAS); "
                "delegate summon unavailable in subagent runtime.")

def verdict(v, c, e):
    return {"verdict": v, "confidence": c,
            "explanation": e + " | " + VERDICT_NOTE}

findings = []
for f in scan:
    entry = {k: f[k] for k in ("id", "type", "severity", "file", "issue", "impact", "fix",
                               "issue_hash", "structural_pattern")}
    entry["source"] = "dev_im_finder_scan.py"
    if f["id"] == "F-001":
        entry["note"] = "Demo/test 30-agent orchestrator — NN1 expected by design; keep P3."
    elif f["id"] == "F-005":
        entry["note"] = ("GUARD: recovery recipe — NN1 skip per feature-matrix guard "
                         "(templates/recovery/one-off recipes exempt). Likely false positive.")
    findings.append(entry)

# ---- Part 2: rule-area findings (task PRE-FIND GOOSE-EXPERT RULE-AREAS 1.1-1.7, 3.1, 3.2) ----
ra = [
 dict(id="R-201", type="MM4/D1", severity="high",
      file="recipe/dev-mas-engineer.yaml:45",
      issue="settings.max_steps: 50 still present, settings.max_turns MISSING on top-level orchestrator (R-102 previous round converted sub/*.yaml but skipped top-level). Goose recipe-settings schema documents settings.max_turns; max_steps is legacy.",
      impact="Top-level orchestrator has no turn budget; max_steps is not a documented Goose settings key and may be silently ignored → orchestrator runs unbounded or truncated without native control.",
      fix="Add settings.max_turns (>= 25 Goose default; e.g. 50 matching previous max_steps intent) to recipe/dev-mas-engineer.yaml; keep timeout: 300.",
      goose_verdict=verdict("CONFORM", "HIGH",
          "settings.max_turns is Goose-native (recipe-advanced): overwrites GOOSE_SUBAGENT_MAX_TURNS; precedence tool_call > recipe.settings > env > default 25. max_steps is not in documented recipe-settings schema.")),
 dict(id="R-202", type="KK1", severity="high",
      file="tools/dev_im_finder_scan.py:343-351",
      issue="A2 check still reads settings.max_steps (< 10) → never fires now (all recipes max_steps>=50 or migrated to max_turns; only R04-protected general-improver.yaml still carries max_steps:50 which is not <10). A4 (max_steps vs avg steps) check absent entirely. A2/A4 detection functionally dead.",
      impact="Scanner no longer detects insufficient turn budgets; sub-agents at max_turns 15/20 (below Goose default 25) go undetected.",
      fix="Migrate A2/A4 to settings.max_turns vs Goose default 25 (fire when max_turns < 25); add A2-EXT for over-spec (e.g. max_turns 200). Keep legacy max_steps check only as Q3 warning.",
      goose_verdict=verdict("CONFORM", "HIGH",
          "settings.max_turns native (default 25, GOOSE_SUBAGENT_MAX_TURNS env, per-recipe override); A2 re-target on max_turns is correct Goose-aware detection.")),
 dict(id="R-203", type="A2-EXT", severity="medium",
      file="recipe/sub/*.yaml (14 at max_turns:15, 3 at 20, 1 at 200)",
      issue="Sub-agent recipes declare settings.max_turns BELOW Goose default 25: 14 recipes at 15, 3 at 20 (sub-agents cut off mid-task before 25-turn default); 1 recipe at 200 (over-spec → turn/token cost).",
      impact="Sub-agents truncate before completion (quality/verification gaps) or over-spend (cost); inconsistency vs GOOSE_SUBAGENT_MAX_TURNS default.",
      fix="Raise max_turns < 25 to >= 30 (suggest 30-50 by role); cap the 200 to 100; document per-recipe rationale.",
      goose_verdict=verdict("CONFORM", "HIGH",
