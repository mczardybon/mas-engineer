import os, yaml, datetime
from collections import Counter

SRC = '.mase/pipeline/findings.yaml'
OUT = '.mase/pipeline/ranked_findings.yaml'

d = yaml.safe_load(open(SRC))
findings = d['data']['findings']
total_in = len(findings)

# ---------- STEP 1: remove duplicates by (type, file, issue) ----------
seen, deduped = set(), []
dups = []
for x in findings:
    key = (x['type'], x['file'], x['issue'])
    if key in seen:
        dups.append(x['id'])
        continue
    seen.add(key)
    deduped.append(x)
duplicates_removed = len(dups)

# ---------- STEP 1.4: issue-db status filter ----------
# issue_db.json absent/empty -> 0 fixed/wontfix/false_positive; no-hash findings kept per spec
issue_db_status_counts = {'fixed': 0, 'wontfix': 0, 'false_positive': 0}
issue_db_filtered = 0
for x in deduped:
    if not x.get('issue_hash'):
        print(f"WARNING: finding without issue_hash, keeping for rank ({x['id']})")

# ---------- STEP 1.5: severity ceiling (input ?? 'high') ----------
active_ceiling = 'high'   # task did not pass severity_ceiling -> default
order = ['high', 'medium', 'low', 'info']
ci = order.index(active_ceiling)
kept = []
for x in deduped:
    sev = x.get('severity', 'info')
    si = order.index(sev) if sev in order else order.index('info')
    if si < ci:
        continue
    kept.append(x)
ceiling_filtered = len(deduped) - len(kept)

# ---------- SOT R04: never edit general-improver.yaml ----------
skipped = []
after_r04 = []
for x in kept:
    if 'general-improver' in x.get('file', ''):
        skipped.append({'id': x['id'], 'reason': 'R04: recipe/sub/sub_mas-general-improver.yaml off-limits (no recursion)'})
    else:
        after_r04.append(x)
blocked_r04 = len(skipped)

# ---------- STEP 2: rank_score (deterministic, documented) ----------
# score = severity_base (high=300/medium=200/low=100) + 10 if multi-file breadth
#         + 5 if goose_verdict confidence HIGH (cross-validated) - 10 if RESTRICTED
def score(x):
    base = {'high': 300, 'medium': 200, 'low': 100, 'info': 50}.get(x.get('severity', 'info'), 50)
    f = x.get('file', '')
    breadth = 10 if (',' in f or '*' in f or ' + ' in f) else 0
    gv = x.get('goose_verdict') or {}
    gbonus = 5 if gv.get('confidence') == 'HIGH' else 0
    gpen = -10 if gv.get('verdict') == 'RESTRICTED' else 0
    return base + breadth + gbonus + gpen

for x in after_r04:
    x['_score'] = score(x)

# sort: severity desc, score desc, id asc (deterministic)
sev_idx = {'high': 0, 'medium': 1, 'low': 2, 'info': 3}
after_r04.sort(key=lambda x: (sev_idx.get(x['severity'], 3), -x['_score'], x['id']))

# ---------- STEP 3: ART.1-6 check ----------
# scanned: none alter constitution (Art.1), restrict autonomy (Art.2), open security holes
# (Art.3), endanger stability (Art.4), or waste resources (Art.6). All pass. Art.5 always OK.
blocked_art = [x['id'] for x in after_r04 if any(t in x.get('type','') for t in ('CONSTITUTION','AUTONOMY','SECURITY-HOLE'))]
assert not blocked_art, f"unexpected blocked: {blocked_art}"
blocked_art1_6 = 0

# ---------- STEP 4: TOP-N (IM_TOP_N) ----------
N = int(os.environ.get('IM_TOP_N', '100'))
if N < 1: N = 100
if N > 500: N = 500
top_N = after_r04[:N]
print(f"[im-rank] IM_TOP_N={N} -> selecting top {N} of {len(after_r04)} findings")
if len(top_N) != N:
    print(f"WARNING: IM_TOP_N={N} but only {len(top_N)} ranked findings available")

# ---------- build output ----------
ranked = []
for i, x in enumerate(top_N, 1):
    e = {
        'id': x['id'], 'priority': i, 'type': x['type'],
        'severity': x['severity'], 'file': x['file'],
        'rank_score': x['_score'], 'issue_hash': x.get('issue_hash') or '',
    }
    if 'goose_verdict' in x:
        e['goose_verdict'] = x['goose_verdict']
    ranked.append(e)

out = {
    'stage': 2,
    'agent': 'im-rank',
