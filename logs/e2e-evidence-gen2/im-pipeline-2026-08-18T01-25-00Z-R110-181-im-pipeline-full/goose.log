import yaml
d = yaml.safe_load(open('.mase/workflows.yaml'))
print("top-level keys:", list(d.keys()))
# find where wf_recovery_defib lives
def locate(node, name, path=""):
    if isinstance(node, dict):
        for k, v in node.items():
            if k == name: return path + "/" + k
            r = locate(v, name, path + "/" + str(k))
            if r: return r
    elif isinstance(node, list):
        for i, v in enumerate(node):
            r = locate(v, name, path + f"[{i}]")
            if r: return r
    return None
for n in ('wf_recovery_defib', 'wf_im_design_patches', 'wf_phoenix_recovery_publish'):
    print(n, "->", locate(d, n))
EOF


